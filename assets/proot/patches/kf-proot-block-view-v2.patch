+static int read_fd_soft_limit(pid_t pid, unsigned int *limit)
+{
+	char path[64];
+	char line[256];
+	unsigned long long value = 0;
+	FILE *stream;
+	if (snprintf(path, sizeof(path), "/proc/%d/limits", pid) >=
+		(int) sizeof(path))
+		return -ENAMETOOLONG;
+	stream = fopen(path, "re");
+	if (stream == NULL)
+		return -errno;
+	while (fgets(line, sizeof(line), stream) != NULL) {
+		if (sscanf(line, "Max open files %llu", &value) == 1)
+			break;
+	}
+	fclose(stream);
+	if (value < 1 || value > UINT_MAX)
+		return -EMFILE;
+	*limit = (unsigned int) value;
+	return 0;
+}
