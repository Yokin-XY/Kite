+	char meta_path[PATH_MAX];
+} KfViewBlockLayer;
+
+typedef struct {
+	char relative[PATH_MAX];
+	char base_path[PATH_MAX];
+	KfViewBlockLayer layers[KF_VIEW_MAX_BLOCK_LAYERS];
