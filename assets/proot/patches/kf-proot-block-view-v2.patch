+	poke_reg(tracee, SYSARG_1, sysarg_1);
+	poke_reg(tracee, SYSARG_2, sysarg_2);
+	poke_reg(tracee, SYSARG_3, sysarg_3);
+	poke_reg(tracee, SYSARG_4, sysarg_4);
+	poke_reg(tracee, SYSARG_5, sysarg_5);
+	poke_reg(tracee, SYSARG_6, sysarg_6);
+	set_sysnum(tracee, sysnum);
+	tracee->_regs_were_changed = true;
+	status = push_specific_regs(tracee, true);
