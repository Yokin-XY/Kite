+	(void) ptrace(PTRACE_SETSIGMASK, tracee->pid, sizeof(sigset_t), &original_sigset);
+	tracee->_regs[CURRENT] = original_regs;
+	tracee->_regs_were_changed = true;
+	(void) push_specific_regs(tracee, true);
+	tracee->restore_original_regs = original_restore_regs;
+	tracee->restore_original_regs_after_seccomp_event =
+		original_restore_regs_after_seccomp;
+	return status;
+#else
