+		 * returning to the 64-bit tracer so ordinary `(long) result < 0`
+		 * checks cannot mistake -errno for a large successful descriptor. */
+		if (sizeof_word(tracee) == sizeof(uint32_t) &&
+			(uint32_t) raw_result >= UINT32_MAX - 4094U)
+			*result = (word_t) (long) (int32_t) raw_result;
+		else
+			*result = raw_result;
+	}
+	status = 0;
