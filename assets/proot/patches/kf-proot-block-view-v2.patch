+int execute_remote_syscall(Tracee *tracee, Sysnum sysnum,
+			word_t sysarg_1, word_t sysarg_2, word_t sysarg_3,
+			word_t sysarg_4, word_t sysarg_5, word_t sysarg_6,
+			word_t *result)
+{
+#if defined(ARCH_ARM64)
+	struct user_regs_struct original_regs;
+	sigset_t original_sigset;
+	sigset_t blocked_sigset;
+	bool original_restore_regs;
+	bool original_restore_regs_after_seccomp;
+	int status;
+	int wait_status;
+	int attempts;
