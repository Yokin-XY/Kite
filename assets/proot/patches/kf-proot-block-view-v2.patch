+				block_lifecycle_sysnums[index] != PR_void; index++) {
+				word_t sysnum = detranslate_sysnum(
+					architectures[arch_index].abis[abi_index],
+					block_lifecycle_sysnums[index]);
+				if (sysnum == SYSCALL_AVOIDER)
+					continue;
+				program[count++] = (struct sock_filter)
+					BPF_JUMP(BPF_JMP | BPF_JEQ | BPF_K,
+						sysnum, 0, 1);
+				program[count++] = (struct sock_filter)
+					BPF_STMT(BPF_RET | BPF_K, SECCOMP_RET_TRACE);
+			}
+		}
+		program[count++] = (struct sock_filter)
+			BPF_STMT(BPF_RET | BPF_K, SECCOMP_RET_ALLOW);
+	}
+	program[count++] = (struct sock_filter)
+		BPF_STMT(BPF_RET | BPF_K, SECCOMP_RET_ALLOW);
+
+	filter_bytes = count * sizeof(program[0]);
+	program_offset = (filter_bytes + 15U) & ~15U;
+	if (program_offset + sizeof(remote_program) > 4096U || count > UINT16_MAX)
+		return -E2BIG;
+	status = execute_remote_mmap(tracee, 0, 4096,
+		PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS,
+		(word_t) -1, 0, &memory);
+	if (status < 0)
+		return status;
+	if ((long) memory < 0)
+		return (int) (long) memory;
+	status = write_data(tracee, memory, program, filter_bytes);
+	if (status < 0)
+		goto unmap;
+	encoded_length = (uint16_t) count;
+	memcpy(remote_program, &encoded_length, sizeof(encoded_length));
+	if (sizeof_word(tracee) == sizeof(uint32_t)) {
+		uint32_t pointer = (uint32_t) memory;
+		memcpy(remote_program + 4, &pointer, sizeof(pointer));
+	}
+	else {
+		uint64_t pointer = (uint64_t) memory;
+		memcpy(remote_program + 8, &pointer, sizeof(pointer));
+	}
+	status = write_data(tracee, memory + program_offset, remote_program,
+		sizeof(remote_program));
+	if (status < 0)
+		goto unmap;
+	status = execute_remote_syscall(tracee, PR_prctl, PR_SET_SECCOMP,
+		SECCOMP_MODE_FILTER, memory + program_offset, 0, 0, 0, &result);
+	if (status == 0 && (long) result < 0)
+		status = (int) (long) result;
+	if (status == 0)
+		config->lifecycle_filter_installed = true;
+unmap:
+	(void) execute_remote_syscall(tracee, PR_munmap, memory, 4096,
+		0, 0, 0, 0, NULL);
+	return status;
+#else
+	(void) tracee;
+	(void) config;
+	return -EOPNOTSUPP;
+#endif
+}
+
+static int open_path_in_tracee(Tracee *tracee, const char *path, int flags,
+	int *guest_fd)
+{
+	word_t memory = 0;
+	word_t result = 0;
+	int status;
+
+	status = execute_remote_mmap(tracee, 0, 4096,
+		PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS,
+		(word_t) -1, 0, &memory);
+	if (getenv("KF_PROOT_VIEW_DEBUG") != NULL)
+		fprintf(stderr, "kf_block remote path mmap status=%d result=0x%lx abi=%d\n",
+			status, (unsigned long) memory, (int) get_abi(tracee));
+	if (status < 0)
+		return status;
+	if ((long) memory < 0)
+		return (int) (long) memory;
+	status = write_data(tracee, memory, path, strlen(path) + 1);
+	if (getenv("KF_PROOT_VIEW_DEBUG") != NULL)
+		fprintf(stderr, "kf_block remote path write status=%d address=0x%lx path=%s\n",
+			status, (unsigned long) memory, path);
+	if (status < 0)
+		goto unmap;
+	status = execute_remote_syscall(tracee, PR_openat, AT_FDCWD, memory,
+		(word_t) flags, 0, 0, 0, &result);
+	if (getenv("KF_PROOT_VIEW_DEBUG") != NULL)
+		fprintf(stderr, "kf_block remote path open status=%d result=%ld flags=0x%x\n",
+			status, (long) result, flags);
+	if (status < 0)
+		goto unmap;
+	if ((long) result < 0) {
+		status = (int) (long) result;
+		goto unmap;
+	}
+	*guest_fd = (int) result;
+	unmap:
+	(void) execute_remote_syscall(tracee, PR_munmap, memory, 4096,
+		0, 0, 0, 0, NULL);
+	return status;
+}
+
+static int open_delta_in_tracee(Tracee *tracee, KfBlockFile *file,
+	int *guest_fd)
+{
+	char descriptor_path[64];
+	int descriptor = kf_block_store_delta_fd(file->store);
+	if (descriptor < 0 ||
+		snprintf(descriptor_path, sizeof(descriptor_path), "/proc/%d/fd/%d",
+			getpid(), descriptor) >= (int) sizeof(descriptor_path))
+		return -EBADF;
+	return open_path_in_tracee(tracee, descriptor_path,
+		O_RDWR | O_CLOEXEC | O_LARGEFILE, guest_fd);
+}
+
+static int open_shadow_in_tracee(Tracee *tracee, KfBlockFile *file,
+	bool close_on_exec, int *shadow_fd)
+{
+	word_t result = 0;
+	unsigned int soft_limit;
+	int low_fd = -1;
+	int minimum;
+	int status;
+
+	status = open_delta_in_tracee(tracee, file, &low_fd);
+	if (getenv("KF_PROOT_VIEW_DEBUG") != NULL)
+		fprintf(stderr, "kf_block shadow open status=%d low=%d file=%s\n",
+			status, low_fd, file->identity);
+	if (status < 0)
+		return status;
+	status = read_fd_soft_limit(tracee->pid, &soft_limit);
+	if (status < 0)
+		goto close_low;
+	if (soft_limit < 32 || soft_limit > INT_MAX) {
+		status = -EMFILE;
+		goto close_low;
+	}
+	/* Keep implementation-owned descriptors out of the low range routinely
+	 * shuffled by shells and language runtimes.  Derive the reservation from
+	 * the real per-process limit instead of assuming that fd 1024 exists. */
+	minimum = (int) (soft_limit / 2);
+	status = execute_remote_syscall(tracee, PR_fcntl, (word_t) low_fd,
+		F_DUPFD_CLOEXEC, (word_t) minimum, 0, 0, 0, &result);
+	if (getenv("KF_PROOT_VIEW_DEBUG") != NULL)
+		fprintf(stderr, "kf_block shadow reserve status=%d result=%ld minimum=%d\n",
+			status, (long) result, minimum);
+	if (status < 0)
+		goto close_low;
+	if ((long) result < 0) {
+		status = (int) (long) result;
+		goto close_low;
+	}
+	*shadow_fd = (int) result;
+	status = 0;
+
+close_low:
+	(void) execute_remote_syscall(tracee, PR_close, (word_t) low_fd,
+		0, 0, 0, 0, 0, NULL);
+	if (status < 0)
+		return status;
+	if (close_on_exec)
+		return 0;
+	status = execute_remote_syscall(tracee, PR_fcntl, (word_t) *shadow_fd,
+		F_SETFD, 0, 0, 0, 0, &result);
+	if (status < 0 || (long) result < 0) {
+		(void) execute_remote_syscall(tracee, PR_close,
+			(word_t) *shadow_fd, 0, 0, 0, 0, 0, NULL);
+		return status < 0 ? status : (int) (long) result;
+	}
+	return 0;
+}
+
+int kf_block_stage_fd_promotion(Tracee *tracee, int fd, const char *path)
+{
+	KfBlockConfig *config = block_config_for_tracee(tracee);
+	KfBlockFile *file = NULL;
+	word_t flags;
+	int status;
+
+	if (config == NULL || path == NULL)
+		return 0;
+	if (tracked_fd(config, fd) != NULL)
+		return 1;
+	status = resolve_host_file(tracee, config, path, &file);
+	if (status <= 0)
+		return status;
+	status = read_fd_flags(tracee->pid, fd, &flags);
+	if (status < 0)
+		return status;
+	if (getenv("KF_PROOT_VIEW_DEBUG") != NULL)
+		fprintf(stderr,
+			"kf_block stage promotion pid=%d fd=%d flags=0x%lx file=%s\n",
+			tracee->pid, fd, (unsigned long) flags,
+			file->identity);
+	config->promotion_staged = true;
+	config->staged_promotion_fd = fd;
+	config->staged_promotion_flags = flags;
+	config->staged_promotion_cloexec = (flags & O_CLOEXEC) != 0;
+	config->staged_promotion_file = file;
+	return 1;
+}
+
+static bool is_fcntl_lock_command(const Tracee *tracee, int command)
+{
+	if (command == F_GETLK || command == F_SETLK || command == F_SETLKW)
+		return true;
+	if (is_32on64_mode(tracee) &&
+		(command == KF_COMPAT_F_GETLK64 || command == KF_COMPAT_F_SETLK64 ||
+		 command == KF_COMPAT_F_SETLKW64))
+		return true;
+#ifdef F_OFD_GETLK
+	if (command == F_OFD_GETLK || command == F_OFD_SETLK ||
+		command == F_OFD_SETLKW)
+		return true;
+#endif
+	return false;
+}
+
+static bool is_fcntl_set_lock_command(const Tracee *tracee, int command)
+{
+	if (command == F_SETLK || command == F_SETLKW)
+		return true;
+	if (is_32on64_mode(tracee) &&
+		(command == KF_COMPAT_F_SETLK64 || command == KF_COMPAT_F_SETLKW64))
+		return true;
+#ifdef F_OFD_SETLK
+	if (command == F_OFD_SETLK || command == F_OFD_SETLKW)
+		return true;
+#endif
+	return false;
+}
+
+static int validate_fcntl_lock_access(Tracee *tracee,
+	const KfBlockFd *tracked, int command)
+{
+	int16_t lock_type;
+	int access;
+	int status;
+	if (!is_fcntl_set_lock_command(tracee, command))
+		return 0;
+	/* l_type is the first signed short in both native and compat flock
+	 * layouts.  Reading only that field avoids treating a 32-bit tracee's
+	 * structure as the tracer's native struct flock. */
+	status = read_data(tracee, &lock_type,
+		peek_reg(tracee, CURRENT, SYSARG_3), sizeof(lock_type));
+	if (status < 0)
+		return status;
+	access = (int) (tracked->flags & O_ACCMODE);
+	if (lock_type == F_WRLCK && access == O_RDONLY)
+		return -EBADF;
+	if (lock_type == F_RDLCK && access == O_WRONLY)
+		return -EBADF;
+	return 0;
+}
+
+static int map_delta_block(Tracee *tracee, const KfBlockMapping *mapping,
+	KfBlockFile *layer, size_t block)
+{
+	off_t block_offset;
+	size_t block_length;
+	off_t mapping_end;
+	off_t block_end;
+	off_t map_start;
+	off_t map_end;
+	word_t target;
+	off_t delta_offset;
+	word_t map_flags;
+	word_t mapping_protection;
+	word_t result = 0;
+	int guest_fd = -1;
+	int status;
+
+	status = kf_block_store_block_range(layer->store, block,
+		&block_offset, &block_length);
+	if (status < 0)
+		return status;
+	mapping_end = mapping->offset + (off_t) mapping->length;
+	block_end = block_offset + (off_t) block_length;
+	map_start = mapping->offset > block_offset ? mapping->offset : block_offset;
+	map_end = mapping_end < block_end ? mapping_end : block_end;
+	if (map_start >= map_end)
+		return 0;
+	target = mapping->address + (word_t) (map_start - mapping->offset);
+	delta_offset = map_start;
+	map_flags = (mapping->flags & MAP_SHARED) != 0 ? MAP_SHARED : MAP_PRIVATE;
+	if (layer != mapping->file &&
+		(mapping->protection & PROT_WRITE) != 0 &&
+		(mapping->flags & MAP_SHARED) != 0) {
+		map_flags = MAP_PRIVATE;
+		mapping_protection =
+			(mapping->protection | PROT_READ) & ~PROT_WRITE;
+	}
+	else
+		mapping_protection = mapping->protection;
+	status = open_delta_in_tracee(tracee, layer, &guest_fd);
+	if (status < 0)
+		return status;
+	status = execute_remote_mmap(tracee, target,
+		(word_t) (map_end - map_start), mapping_protection,
+		map_flags | MAP_FIXED, (word_t) guest_fd,
+		delta_offset, &result);
+	(void) execute_remote_syscall(tracee, PR_close, (word_t) guest_fd,
+		0, 0, 0, 0, 0, NULL);
+	if (status < 0)
+		return status;
+	if (result != target)
+		return (long) result < 0 ? (int) (long) result : -EFAULT;
+	return 0;
+}
+
+static int map_delta_block_everywhere(Tracee *tracee, KfBlockConfig *config,
+	KfBlockFile *file, size_t block)
+{
+	for (size_t index = 0; index < config->mapping_count; index++) {
+		if (config->mappings[index].file != file)
+			continue;
+		int status = map_delta_block(tracee,
+			&config->mappings[index], file, block);
+		if (status < 0)
+			return status;
+	}
+	return 0;
+}
+
+static int map_layer_zero_range(Tracee *tracee,
+	const KfBlockMapping *mapping, KfBlockFile *layer);
+
+static int map_existing_layers(Tracee *tracee,
+	const KfBlockMapping *mapping, KfBlockFile *layer)
+{
+	KfBlockStoreStats stats;
+	int status;
+	if (layer->parent != NULL) {
+		status = map_existing_layers(tracee, mapping, layer->parent);
+		if (status < 0)
+			return status;
+	}
+	status = map_layer_zero_range(tracee, mapping, layer);
+	if (status < 0)
+		return status;
+	kf_block_store_stats(layer->store, &stats);
+	for (size_t block = 0;
+		block < (size_t) ((stats.visible_size + (off_t) stats.block_size - 1) /
+		(off_t) stats.block_size); block++) {
+		if (!kf_block_store_block_changed(layer->store, block))
+			continue;
+		status = map_delta_block(tracee, mapping, layer, block);
+		if (status < 0)
+			return status;
+	}
+	return 0;
+}
+
+static int map_existing_top_layer(Tracee *tracee,
+	const KfBlockMapping *mapping)
+{
+	KfBlockStoreStats stats;
+	KfBlockFile *file = mapping->file;
+	int status;
+
+	kf_block_store_stats(file->store, &stats);
+	for (size_t block = 0;
+		block < (size_t) ((stats.visible_size + (off_t) stats.block_size - 1) /
+		(off_t) stats.block_size); block++) {
+		if (!kf_block_store_block_changed(file->store, block))
+			continue;
+		status = map_delta_block(tracee, mapping, file, block);
+		if (status < 0)
+			return status;
+	}
+	return 0;
+}
+
+static int map_layer_zero_range(Tracee *tracee,
+	const KfBlockMapping *mapping, KfBlockFile *layer)
+{
+	KfBlockStoreStats stats;
+	off_t mapping_start = mapping->offset;
+	off_t mapping_end = mapping->offset + (off_t) mapping->length;
+	off_t zero_start;
+	off_t zero_end;
+	word_t target;
+	word_t result = 0;
+	word_t protection = mapping->protection;
+	long page_size = sysconf(_SC_PAGESIZE);
+	int status;
+
+	if (mapping_end < mapping_start || page_size <= 0)
+		return -EOVERFLOW;
+	kf_block_store_stats(layer->store, &stats);
+	zero_start = (stats.base_cutoff + page_size - 1) & ~(page_size - 1);
+	zero_end = (stats.visible_size + page_size - 1) & ~(page_size - 1);
+	if (zero_start < mapping_start)
+		zero_start = mapping_start;
+	if (zero_end > mapping_end)
+		zero_end = mapping_end;
+	if (zero_start >= zero_end)
+		return 0;
+	if ((mapping->protection & PROT_WRITE) != 0 &&
+		(mapping->flags & MAP_SHARED) != 0)
+		protection = (protection | PROT_READ) & ~PROT_WRITE;
+	target = mapping->address + (word_t) (zero_start - mapping_start);
+	status = execute_remote_mmap(tracee, target,
+		(word_t) (zero_end - zero_start), protection,
+		MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED, (word_t) -1, 0, &result);
+	if (status < 0)
+		return status;
+	if (result != target)
+		return (long) result < 0 ? (int) (long) result : -EFAULT;
+	return 0;
+}
+
+static int map_base_mapping(Tracee *tracee,
+	const KfBlockMapping *mapping)
+{
+	word_t protection = mapping->protection;
+	word_t map_flags = (mapping->flags & MAP_SHARED) != 0
+		? MAP_SHARED : MAP_PRIVATE;
+	word_t result = 0;
+	int guest_fd = -1;
+	int status;
+
+	if ((mapping->protection & PROT_WRITE) != 0 &&
+		(mapping->flags & MAP_SHARED) != 0) {
+		protection = (protection | PROT_READ) & ~PROT_WRITE;
+		map_flags = MAP_PRIVATE;
+	}
+	status = open_path_in_tracee(tracee, mapping->file->base_path,
+		O_RDONLY | O_CLOEXEC, &guest_fd);
+	if (status < 0)
+		return status;
+	status = execute_remote_mmap(tracee, mapping->address,
+		mapping->length, protection, map_flags | MAP_FIXED,
+		(word_t) guest_fd, mapping->offset, &result);
+	(void) execute_remote_syscall(tracee, PR_close, (word_t) guest_fd,
+		0, 0, 0, 0, 0, NULL);
+	if (status < 0)
+		return status;
+	if (result != mapping->address)
+		return (long) result < 0 ? (int) (long) result : -EFAULT;
+	return 0;
+}
+
+static int map_eof_guard_range(Tracee *tracee,
+	const KfBlockMapping *mapping, KfBlockFile *file)
+{
+	KfBlockStoreStats stats;
+	struct stat delta_stat;
+	off_t mapping_start = mapping->offset;
+	off_t mapping_end = mapping->offset + (off_t) mapping->length;
+	off_t guard_start;
+	off_t guard_offset;
+	word_t target;
+	word_t result = 0;
+	long page_size = sysconf(_SC_PAGESIZE);
+	int guest_fd = -1;
+	int status;
+
+	if (mapping_end < mapping_start || page_size <= 0)
+		return -EOVERFLOW;
+	kf_block_store_stats(file->store, &stats);
+	if (stats.visible_size > INT64_MAX - (page_size - 1))
+		return -EOVERFLOW;
+	guard_start = (stats.visible_size + page_size - 1) & ~(page_size - 1);
+	if (guard_start < mapping_start)
+		guard_start = mapping_start;
+	if (guard_start >= mapping_end)
+		return 0;
+	status = kf_block_store_delta_stat(file->store, &delta_stat);
+	if (status < 0)
+		return status;
+	if (delta_stat.st_size > INT64_MAX - (page_size - 1))
+		return -EOVERFLOW;
+	guard_offset = (delta_stat.st_size + page_size - 1) & ~(page_size - 1);
+	status = open_delta_in_tracee(tracee, file, &guest_fd);
+	if (status < 0)
+		return status;
+	target = mapping->address + (word_t) (guard_start - mapping_start);
+	status = execute_remote_mmap(tracee, target,
+		(word_t) (mapping_end - guard_start), mapping->protection,
+		MAP_PRIVATE | MAP_FIXED, (word_t) guest_fd,
+		guard_offset, &result);
+	(void) execute_remote_syscall(tracee, PR_close, (word_t) guest_fd,
+		0, 0, 0, 0, 0, NULL);
+	if (status < 0)
+		return status;
+	if (result != target)
+		return (long) result < 0 ? (int) (long) result : -EFAULT;
+	return 0;
+}
+
+static int recompose_file_mappings(Tracee *tracee, KfBlockConfig *config,
+	KfBlockFile *file)
+{
+	for (size_t index = 0; index < config->mapping_count; index++) {
+		KfBlockMapping *mapping = &config->mappings[index];
+		int status;
+		if (mapping->file != file)
+			continue;
+		status = map_base_mapping(tracee, mapping);
+		if (status < 0)
+			return status;
+		status = map_existing_layers(tracee, mapping, file);
+		if (status < 0)
+			return status;
+		status = map_eof_guard_range(tracee, mapping, file);
+		if (status < 0)
+			return status;
+	}
+	return 0;
+}
+
+static bool file_has_writable_private_mapping(KfBlockFile *file)
+{
+	Tracee *tracee;
+	LIST_FOREACH(tracee, get_tracees_list_head(), link) {
+		KfBlockConfig *config = block_config_for_tracee(tracee);
+		if (tracee->terminated || config == NULL)
+			continue;
+		for (size_t index = 0; index < config->mapping_count; index++) {
+			KfBlockMapping *mapping = &config->mappings[index];
+			if (mapping->file == file &&
+				(mapping->flags & MAP_PRIVATE) != 0 &&
+				(mapping->protection & PROT_WRITE) != 0)
+				return true;
+		}
+	}
+	return false;
+}
+
+static int map_delta_blocks_everywhere(Tracee *tracee, KfBlockConfig *config,
+	KfBlockFile *file, size_t first_block, size_t block_count)
+{
+	for (size_t index = 0; index < block_count; index++) {
+		int status = map_delta_block_everywhere(tracee, config, file,
+			first_block + index);
+		if (status < 0)
+			return status;
+	}
+	return 0;
+}
+
+static int apply_mapping_barrier(Tracee *tracee, KfBlockConfig *config,
+	KfBlockFile *file)
+{
+	if (file->barrier_action == KF_BARRIER_REFRESH_SIZE)
+		return recompose_file_mappings(tracee, config, file);
+	return map_delta_blocks_everywhere(tracee, config, file,
+		file->barrier_first_block, file->barrier_block_count);
+}
+
+static KfBlockConfig *block_config_for_tracee(Tracee *tracee)
+{
+	Extension *extension = get_extension(tracee, kf_block_probe_callback);
+	if (extension == NULL || extension->config == NULL)
+		return NULL;
+	return talloc_get_type_abort(extension->config, KfBlockConfig);
+}
+
+static void clear_barrier_member(KfBlockConfig *config)
+{
+	config->barrier_member = false;
+	config->barrier_mapped = false;
+	config->barrier_held = false;
+	config->internal_sigstop_pending = false;
+	config->barrier_suppress_signal = false;
+	config->barrier_restart_how = 0;
+	config->barrier_restart_signal = 0;
+	config->barrier_file = NULL;
+}
+
+static int finish_mapping_barrier(KfBlockFile *file)
+{
+	Tracee *tracee;
+	uint64_t generation = file->barrier_generation;
+
+	file->barrier_active = false;
+	LIST_FOREACH(tracee, get_tracees_list_head(), link) {
+		KfBlockConfig *config = block_config_for_tracee(tracee);
+		int restart_how;
+		int restart_signal;
+		if (config == NULL || config->barrier_file != file ||
+			!config->barrier_member ||
+			config->barrier_generation != generation)
+			continue;
+		restart_how = config->barrier_restart_how;
+		restart_signal = config->barrier_restart_signal;
+		if (!config->barrier_held) {
+			clear_barrier_member(config);
+			continue;
+		}
+		clear_barrier_member(config);
+		tracee->restart_how = restart_how != 0
+			? restart_how
+			: (tracee->last_restart_how != 0
+				? tracee->last_restart_how : PTRACE_SYSCALL);
+		if (!restart_tracee(tracee, restart_signal))
+			return -ESRCH;
+	}
+	file->barrier_expected = 0;
+	file->barrier_held = 0;
+	return 0;
+}
+
+static int preflight_mapping_barrier(Tracee *current, KfBlockFile *file)
+{
+	Tracee *tracee;
+	if (file->barrier_active)
+		return -EBUSY;
+	LIST_FOREACH(tracee, get_tracees_list_head(), link) {
+		KfBlockConfig *config = block_config_for_tracee(tracee);
+		if (tracee == current || tracee->terminated || config == NULL ||
+			!config_has_mappings_for_file(config, file))
+			continue;
+		if (!tracee->running)
+			return -EBUSY;
+	}
+	return 0;
+}
+
+static int begin_mapping_barrier(Tracee *current,
+	KfBlockConfig *current_config, KfBlockFile *file,
+	size_t first_block, size_t block_count,
+	bool hold_current_now, KfBarrierAction action)
+{
+	Tracee *tracee;
+	int status;
+
+	status = preflight_mapping_barrier(current, file);
+	if (status < 0)
+		return status;
+
+	file->barrier_active = true;
+	file->barrier_action = action;
+	file->barrier_generation++;
+	file->barrier_first_block = first_block;
+	file->barrier_block_count = block_count;
+	file->barrier_expected = 0;
+	file->barrier_held = 0;
+
+	LIST_FOREACH(tracee, get_tracees_list_head(), link) {
+		KfBlockConfig *config = block_config_for_tracee(tracee);
+		if (tracee->terminated || config == NULL ||
+			(tracee != current && !config_has_mappings_for_file(config, file)))
+			continue;
+		config->barrier_generation = file->barrier_generation;
+		config->barrier_file = file;
+		config->barrier_member = true;
+		config->barrier_mapped = false;
+		config->barrier_held = false;
+		config->barrier_suppress_signal = false;
+		config->barrier_restart_how = 0;
+		config->barrier_restart_signal = 0;
+		file->barrier_expected++;
+	}
+
+	if (hold_current_now) {
+		status = apply_mapping_barrier(current, current_config, file);
+		if (status < 0)
+			return status;
+		current_config->barrier_mapped = true;
+		current_config->barrier_held = true;
+		current_config->barrier_restart_how = current->restart_how != 0
+			? current->restart_how
+			: (current->last_restart_how != 0
+				? current->last_restart_how : PTRACE_SYSCALL);
+		current_config->barrier_restart_signal = 0;
+		file->barrier_held++;
+	}
+
+	LIST_FOREACH(tracee, get_tracees_list_head(), link) {
+		KfBlockConfig *config = block_config_for_tracee(tracee);
+		if ((tracee == current && hold_current_now) || config == NULL ||
+			config->barrier_file != file ||
+			!config->barrier_member)
+			continue;
+		config->internal_sigstop_pending = true;
+		if (kill(tracee->pid, SIGSTOP) != 0)
+			return -errno;
+	}
+
+	if (hold_current_now && file->barrier_held == file->barrier_expected)
+		return finish_mapping_barrier(file);
+	return 1;
+}
+
+static void fail_mapping_barrier(KfBlockFile *file, int error)
+{
+	Tracee *tracee;
+	uint64_t generation = file->barrier_generation;
+	bool had_active_barrier = file->barrier_active;
+
+	note(NULL, ERROR, INTERNAL,
+		file->barrier_action == KF_BARRIER_REFRESH_SIZE
+			? "KF block View size barrier failed: %s"
+			: "KF block View mapping barrier failed: %s",
+		strerror(-error));
+	file->barrier_active = false;
+	LIST_FOREACH(tracee, get_tracees_list_head(), link) {
+		KfBlockConfig *config = block_config_for_tracee(tracee);
+		if (config == NULL || config->barrier_file != file ||
+			(had_active_barrier && (!config->barrier_member ||
+			 config->barrier_generation != generation)))
+			continue;
+		clear_barrier_member(config);
+		(void) kill(tracee->pid, SIGKILL);
+	}
+	file->barrier_expected = 0;
+	file->barrier_held = 0;
+}
+
+static int handle_barrier_status(Extension *extension, int tracee_status)
+{
+	KfBlockConfig *config = talloc_get_type_abort(extension->config,
+		KfBlockConfig);
+	KfBlockFile *file = config->barrier_file;
+	Tracee *tracee = TRACEE(extension);
+	int status;
+
+	if (file == NULL || !file->barrier_active || !config->barrier_member ||
+		config->barrier_generation != file->barrier_generation) {
+		if (config->internal_sigstop_pending && WIFSTOPPED(tracee_status) &&
+			WSTOPSIG(tracee_status) == SIGSTOP) {
+			config->internal_sigstop_pending = false;
+			tracee->restart_how = tracee->last_restart_how != 0
+				? tracee->last_restart_how : PTRACE_SYSCALL;
+			(void) restart_tracee(tracee, 0);
+			return 1;
+		}
+		return 0;
+	}
+
+	if (WIFEXITED(tracee_status) || WIFSIGNALED(tracee_status)) {
+		if (config->barrier_held && file->barrier_held > 0)
+			file->barrier_held--;
+		if (file->barrier_expected > 0)
+			file->barrier_expected--;
+		clear_barrier_member(config);
+		if (file->barrier_expected == file->barrier_held) {
+			status = finish_mapping_barrier(file);
+			if (status < 0)
+				fail_mapping_barrier(file, status);
+		}
+		return 0;
+	}
+
+	/* A syscall or ptrace event can win the race against our SIGSTOP.  Let
+	 * PRoot finish and restart that event; the unmaskable SIGSTOP will then
+	 * provide the dedicated stop at which it is safe to remap this tracee. */
+	if (!WIFSTOPPED(tracee_status) || WSTOPSIG(tracee_status) != SIGSTOP ||
+		!config->internal_sigstop_pending)
+		return 0;
+
+	config->internal_sigstop_pending = false;
+	status = apply_mapping_barrier(tracee, config, file);
+	if (status < 0) {
+		fail_mapping_barrier(file, status);
+		return 1;
+	}
+	config->barrier_mapped = true;
+	config->barrier_suppress_signal = true;
+	return 0;
+}
+
+static int hold_before_restart(Extension *extension, int signal)
+{
+	KfBlockConfig *config = talloc_get_type_abort(extension->config,
+		KfBlockConfig);
+	KfBlockFile *file = config->barrier_file;
+	Tracee *tracee = TRACEE(extension);
+	int status;
+
+	if (file == NULL || !file->barrier_active || !config->barrier_member ||
+		config->barrier_generation != file->barrier_generation ||
+		!config->barrier_mapped)
+		return 0;
+	if (!config->barrier_held) {
+		config->barrier_held = true;
+		config->barrier_restart_how = tracee->restart_how != 0
+			? tracee->restart_how
+			: (tracee->last_restart_how != 0
+				? tracee->last_restart_how : PTRACE_SYSCALL);
+		config->barrier_restart_signal = config->barrier_suppress_signal
+			? 0 : signal;
+		file->barrier_held++;
+	}
+	if (file->barrier_held == file->barrier_expected) {
+		status = finish_mapping_barrier(file);
+		if (status < 0)
+			fail_mapping_barrier(file, status);
+	}
+	return 1;
+}
+
+static int emulate_read(Tracee *tracee, KfBlockConfig *config,
+	KfBlockFile *file, int fd, word_t output, size_t length, off_t offset,
+	bool advance, size_t *completed_output)
+{
+	uint8_t *buffer;
+	size_t total = 0;
+	int status = 0;
+	buffer = malloc(length > KF_IO_CHUNK ? KF_IO_CHUNK : (length == 0 ? 1 : length));
+	if (buffer == NULL)
+		return -ENOMEM;
+	while (total < length) {
+		size_t requested = length - total;
+		size_t completed = 0;
+		if (requested > KF_IO_CHUNK)
+			requested = KF_IO_CHUNK;
+		status = kf_block_store_read(file->store, buffer,
+			requested, offset + (off_t) total, &completed);
+		if (status < 0 || completed == 0)
+			break;
+		status = write_data(tracee, output + total, buffer, completed);
+		if (status < 0)
+			break;
+		total += completed;
+		if (completed < requested)
+			break;
+	}
+	free(buffer);
+	if (status < 0)
+		return status;
+	if (completed_output != NULL)
+		*completed_output = total;
+	return advance
+		? replace_with_lseek(tracee, config, fd, offset + (off_t) total,
+			(long) total)
+		: suppress_with_result(tracee, config, (long) total);
+}
+
+static int write_payload_from_tracee(Tracee *tracee, KfBlockFile *file,
+	word_t input, size_t length, off_t offset, size_t *completed_output)
+{
+	uint8_t *buffer;
+	size_t total = 0;
+	int status = 0;
+
+	*completed_output = 0;
+	buffer = malloc(length > KF_IO_CHUNK
+		? KF_IO_CHUNK : (length == 0 ? 1 : length));
+	if (buffer == NULL)
+		return -ENOMEM;
+	while (total < length) {
+		size_t requested = length - total;
+		size_t completed = 0;
+		if (requested > KF_IO_CHUNK)
+			requested = KF_IO_CHUNK;
+		status = read_data(tracee, buffer, input + total, requested);
+		if (status < 0)
+			break;
+		status = kf_block_store_write(file->store, buffer,
+			requested, offset + (off_t) total, &completed);
+		if (status < 0)
+			break;
+		total += completed;
+		if (completed < requested)
+			break;
+	}
+	free(buffer);
+	*completed_output = total;
+	return status;
+}
+
+static int emulate_write(Tracee *tracee, KfBlockConfig *config,
+	KfBlockFile *file, int fd, word_t input, size_t length, off_t offset,
+	bool advance, size_t *completed_output)
+{
+	size_t total = 0;
+	size_t first_block = 0;
+	size_t last_block = 0;
+	bool needs_mapping_barrier = false;
+	KfBlockStoreStats before_stats;
+	KfBlockStoreStats after_stats;
+	int status = 0;
+	if (offset < 0)
+		return -EINVAL;
+	if ((uint64_t) length > (uint64_t) INT64_MAX - (uint64_t) offset)
+		return -EFBIG;
+	kf_block_store_stats(file->store, &before_stats);
+	if (length > 0) {
+		first_block = (size_t) (offset / (off_t) KF_BLOCK_SIZE);
+		last_block = (size_t) ((offset + (off_t) length - 1) /
+			(off_t) KF_BLOCK_SIZE);
+		if (file_has_mappings(file)) {
+			if (offset <= INT64_MAX - (off_t) length &&
+				offset + (off_t) length > before_stats.visible_size)
+				needs_mapping_barrier = true;
+			for (size_t block = first_block; block <= last_block; block++) {
+				if (!kf_block_store_block_changed(file->store, block)) {
+					needs_mapping_barrier = true;
+					break;
+				}
+			}
+			if (needs_mapping_barrier) {
+				status = preflight_mapping_barrier(tracee, file);
+				if (status < 0)
+					return status;
+			}
+		}
+	}
+	status = write_payload_from_tracee(tracee, file, input, length, offset,
+		&total);
+	if (status < 0 && total == 0)
+		return status;
+	kf_block_store_stats(file->store, &after_stats);
+	if (completed_output != NULL)
+		*completed_output = total;
+	status = advance
+		? replace_with_lseek(tracee, config, fd, offset + (off_t) total,
+			(long) total)
+		: suppress_with_result(tracee, config, (long) total);
+	if (status < 0)
+		return status;
+	if (needs_mapping_barrier && total > 0) {
+		status = begin_mapping_barrier(tracee, config, file, first_block,
+			last_block - first_block + 1, false,
+			after_stats.visible_size != before_stats.visible_size
+				? KF_BARRIER_REFRESH_SIZE : KF_BARRIER_BLOCKS);
+		if (status < 0) {
+			fail_mapping_barrier(file, status);
+			return status;
+		}
+	}
+	return 0;
+}
+
+static off_t signed_offset(uint32_t low, uint32_t high)
+{
+	uint64_t combined = (uint64_t) low | ((uint64_t) high << 32);
+	return (off_t) (int64_t) combined;
+}
+
+static int truncate_position(Tracee *tracee, Sysnum sysnum, off_t *offset)
+{
+	if (sysnum != PR_truncate64 && sysnum != PR_ftruncate64) {
+		*offset = (off_t) (long) peek_reg(tracee, CURRENT, SYSARG_2);
+		return 0;
+	}
+	if (sizeof_word(tracee) == sizeof(word_t)) {
+		*offset = (off_t) peek_reg(tracee, CURRENT, SYSARG_2);
+		return 0;
+	}
+#if defined(ARCH_ARM) || defined(ARCH_ARM64)
+	*offset = signed_offset(
+		(uint32_t) peek_reg(tracee, CURRENT, SYSARG_3),
+		(uint32_t) peek_reg(tracee, CURRENT, SYSARG_4));
+#else
+	*offset = signed_offset(
+		(uint32_t) peek_reg(tracee, CURRENT, SYSARG_2),
+		(uint32_t) peek_reg(tracee, CURRENT, SYSARG_3));
+#endif
+	return 0;
+}
+
+static int mmap_position(Tracee *tracee, Sysnum sysnum, off_t *offset)
+{
+	uint64_t encoded = (uint64_t) peek_reg(tracee, CURRENT, SYSARG_6);
+	if (sysnum == PR_mmap2) {
+		if (encoded > (uint64_t) INT64_MAX / KF_MMAP2_UNIT)
+			return -EOVERFLOW;
+		encoded *= KF_MMAP2_UNIT;
+	}
+	if (encoded > INT64_MAX)
+		return -EOVERFLOW;
+	*offset = (off_t) encoded;
+	return 0;
+}
+
+static int scalar_position(Tracee *tracee, off_t *offset)
+{
+	if (sizeof_word(tracee) == sizeof(word_t)) {
+		*offset = (off_t) peek_reg(tracee, CURRENT, SYSARG_4);
+		return 0;
+	}
+#if defined(ARCH_ARM) || defined(ARCH_ARM64)
+	*offset = signed_offset(
+		(uint32_t) peek_reg(tracee, CURRENT, SYSARG_5),
+		(uint32_t) peek_reg(tracee, CURRENT, SYSARG_6));
+#else
+	*offset = signed_offset(
+		(uint32_t) peek_reg(tracee, CURRENT, SYSARG_4),
+		(uint32_t) peek_reg(tracee, CURRENT, SYSARG_5));
+#endif
+	return 0;
+}
+
+static off_t vector_position(Tracee *tracee)
+{
+	return signed_offset(
+		(uint32_t) peek_reg(tracee, CURRENT, SYSARG_4),
+		(uint32_t) peek_reg(tracee, CURRENT, SYSARG_5));
+}
+
+static int emulate_fd_io(Tracee *tracee, KfBlockConfig *config, Sysnum sysnum)
+{
+	int fd = (int) peek_reg(tracee, CURRENT, SYSARG_1);
+	KfBlockFd *tracked = tracked_fd(config, fd);
+	off_t offset;
+	size_t length;
+	int status;
+	if (tracked == NULL)
+		return 0;
+	length = (size_t) peek_reg(tracee, CURRENT, SYSARG_3);
+	switch (sysnum) {
+	case PR_read:
+		if ((tracked->flags & O_ACCMODE) == O_WRONLY)
+			return suppress_with_result(tracee, config, -EBADF);
+		status = read_fd_offset(tracee->pid, fd, &offset);
+		return status < 0 ? status : emulate_read(tracee, config,
+			tracked->file, fd,
+			peek_reg(tracee, CURRENT, SYSARG_2), length, offset, true, NULL);
+	case PR_pread64:
+		if ((tracked->flags & O_ACCMODE) == O_WRONLY)
+			return suppress_with_result(tracee, config, -EBADF);
+		status = scalar_position(tracee, &offset);
+		if (status < 0)
+			return status;
+		return emulate_read(tracee, config, tracked->file, fd,
+			peek_reg(tracee, CURRENT, SYSARG_2), length, offset, false, NULL);
+	case PR_write: {
+		KfBlockStoreStats stats;
+		if ((tracked->flags & O_ACCMODE) == O_RDONLY)
+			return suppress_with_result(tracee, config, -EBADF);
+		if ((tracked->flags & O_APPEND) != 0) {
+			kf_block_store_stats(tracked->file->store, &stats);
+			offset = stats.visible_size;
+		}
+		else {
+			status = read_fd_offset(tracee->pid, fd, &offset);
+			if (status < 0)
+				return status;
+		}
+		return emulate_write(tracee, config, tracked->file, fd,
+			peek_reg(tracee, CURRENT, SYSARG_2), length, offset, true, NULL);
+	}
+	case PR_pwrite64:
+		if ((tracked->flags & O_ACCMODE) == O_RDONLY)
+			return suppress_with_result(tracee, config, -EBADF);
+		if ((tracked->flags & O_APPEND) != 0) {
+			KfBlockStoreStats stats;
+			kf_block_store_stats(tracked->file->store, &stats);
+			offset = stats.visible_size;
+		}
+		else {
+			status = scalar_position(tracee, &offset);
+			if (status < 0)
+				return status;
+		}
+		return emulate_write(tracee, config, tracked->file, fd,
+			peek_reg(tracee, CURRENT, SYSARG_2), length, offset, false, NULL);
+	default:
+		return 0;
+	}
+}
+
+typedef struct {
+	word_t base;
+	size_t length;
+} KfTraceeIovec;
+
+static int load_tracee_iovecs(Tracee *tracee, word_t vector, size_t count,
+	KfTraceeIovec *entries, size_t *total)
+{
+	size_t word_size = sizeof_word(tracee);
+	*total = 0;
+	for (size_t index = 0; index < count; index++) {
+		word_t item;
+		word_t base;
+		word_t length;
+		if (index > (UINTPTR_MAX - vector) / (word_size * 2))
+			return -EFAULT;
+		item = vector + index * word_size * 2;
+		errno = 0;
+		base = peek_word(tracee, item);
+		if (errno != 0)
+			return -errno;
+		errno = 0;
+		length = peek_word(tracee, item + word_size);
+		if (errno != 0)
+			return -errno;
+		if ((uint64_t) length > (uint64_t) SSIZE_MAX - *total)
+			return -EINVAL;
+		entries[index].base = base;
+		entries[index].length = (size_t) length;
+		*total += (size_t) length;
+	}
+	return 0;
+}
+
+static int emulate_vector_io(Tracee *tracee, KfBlockConfig *config,
+	Sysnum sysnum)
+{
+	int fd = (int) peek_reg(tracee, CURRENT, SYSARG_1);
+	KfBlockFd *tracked = tracked_fd(config, fd);
+	word_t vector = peek_reg(tracee, CURRENT, SYSARG_2);
+	size_t count = (size_t) peek_reg(tracee, CURRENT, SYSARG_3);
+	word_t rwf_flags = 0;
+	off_t offset;
+	size_t total = 0;
+	size_t requested_total = 0;
+	bool needs_mapping_barrier = false;
+	KfBlockStoreStats before_stats;
+	KfBlockStoreStats after_stats;
+	KfTraceeIovec *entries;
+	bool writing = sysnum == PR_writev || sysnum == PR_pwritev ||
+		sysnum == PR_pwritev2;
+	bool positional = sysnum == PR_preadv || sysnum == PR_preadv2 ||
+		sysnum == PR_pwritev || sysnum == PR_pwritev2;
+	bool version_two = sysnum == PR_preadv2 || sysnum == PR_pwritev2;
+	bool advance = !positional;
+	int status;
+	if (tracked == NULL)
+		return 0;
+	if (writing && (tracked->flags & O_ACCMODE) == O_RDONLY)
+		return suppress_with_result(tracee, config, -EBADF);
+	if (!writing && (tracked->flags & O_ACCMODE) == O_WRONLY)
+		return suppress_with_result(tracee, config, -EBADF);
+	if (count > 1024)
+		return suppress_with_result(tracee, config, -EINVAL);
+	if (version_two)
+		rwf_flags = peek_reg(tracee, CURRENT, SYSARG_6);
+	if ((!writing && rwf_flags != 0) ||
+		(rwf_flags & ~(word_t) (RWF_DSYNC | RWF_SYNC | RWF_APPEND)) != 0)
+		return suppress_with_result(tracee, config, -EOPNOTSUPP);
+	if (positional) {
+		offset = vector_position(tracee);
+		if (version_two && offset == (off_t) -1) {
+			status = read_fd_offset(tracee->pid, fd, &offset);
+			if (status < 0)
+				return status;
+			advance = true;
+		}
+	}
+	else {
+		status = read_fd_offset(tracee->pid, fd, &offset);
+		if (status < 0)
+			return status;
+	}
+	if (writing && ((tracked->flags & O_APPEND) != 0 ||
+		(rwf_flags & RWF_APPEND) != 0)) {
+		KfBlockStoreStats stats;
+		kf_block_store_stats(tracked->file->store, &stats);
+		offset = stats.visible_size;
+	}
+	if (offset < 0)
+		return suppress_with_result(tracee, config, -EINVAL);
+	entries = calloc(count == 0 ? 1 : count, sizeof(*entries));
+	if (entries == NULL)
+		return -ENOMEM;
+	status = load_tracee_iovecs(tracee, vector, count, entries,
+		&requested_total);
+	if (status < 0)
+		goto done;
+	if ((uint64_t) requested_total >
+		(uint64_t) INT64_MAX - (uint64_t) offset) {
+		status = -EINVAL;
+		goto done;
+	}
+	kf_block_store_stats(tracked->file->store, &before_stats);
+	if (writing && requested_total > 0 && file_has_mappings(tracked->file)) {
+		size_t first_block = (size_t) (offset / (off_t) KF_BLOCK_SIZE);
+		size_t last_block = (size_t) ((offset +
+			(off_t) requested_total - 1) / (off_t) KF_BLOCK_SIZE);
+		if (offset + (off_t) requested_total > before_stats.visible_size)
+			needs_mapping_barrier = true;
+		for (size_t block = first_block; block <= last_block; block++)
+			if (!kf_block_store_block_changed(tracked->file->store, block)) {
+				needs_mapping_barrier = true;
+				break;
+			}
+		if (needs_mapping_barrier) {
+			status = preflight_mapping_barrier(tracee, tracked->file);
+			if (status < 0)
+				goto done;
+		}
+	}
+	for (size_t index = 0; index < count; index++) {
+		size_t completed = 0;
+		status = writing
+			? write_payload_from_tracee(tracee, tracked->file,
+				entries[index].base, entries[index].length,
+				offset + (off_t) total, &completed)
+			: emulate_read(tracee, config, tracked->file, fd,
+				entries[index].base, entries[index].length,
+				offset + (off_t) total, false, &completed);
+		total += completed;
+		if (status < 0) {
+			if (total == 0)
+				goto done;
+			break;
+		}
+		if (completed < entries[index].length)
+			break;
+	}
+	status = advance
+		? replace_with_lseek(tracee, config, fd, offset + (off_t) total,
+			(long) total)
+		: suppress_with_result(tracee, config, (long) total);
+	if (status < 0)
+		goto done;
+	if (writing && needs_mapping_barrier && total > 0) {
+		size_t first_block = (size_t) (offset / (off_t) KF_BLOCK_SIZE);
+		size_t last_block = (size_t) ((offset + (off_t) total - 1) /
+			(off_t) KF_BLOCK_SIZE);
+		kf_block_store_stats(tracked->file->store, &after_stats);
+		status = begin_mapping_barrier(tracee, config, tracked->file,
+			first_block, last_block - first_block + 1, false,
+			after_stats.visible_size != before_stats.visible_size
+				? KF_BARRIER_REFRESH_SIZE : KF_BARRIER_BLOCKS);
+		if (status < 0)
+			fail_mapping_barrier(tracked->file, status);
+	}
+
+done:
+	free(entries);
+	return status;
+}
+
+static Reg path_register(Sysnum sysnum)
+{
+	if (sysnum == PR_open || sysnum == PR_creat ||
+		sysnum == PR_stat || sysnum == PR_stat64 ||
+		sysnum == PR_truncate || sysnum == PR_truncate64)
+		return SYSARG_1;
+	return SYSARG_2;
+}
+
+static int read_open_flags(Tracee *tracee, Sysnum sysnum, word_t *flags)
+{
+	if (sysnum == PR_open) {
+		*flags = peek_reg(tracee, CURRENT, SYSARG_2);
+		return 0;
+	}
+	if (sysnum == PR_openat) {
+		*flags = peek_reg(tracee, CURRENT, SYSARG_3);
+		return 0;
+	}
+	if (sysnum == PR_creat) {
+		*flags = O_WRONLY | O_CREAT | O_TRUNC;
+		return 0;
+	}
+	if (sysnum == PR_openat2) {
+		/* Core PRoot has already converted openat2 into the CURRENT openat
+		 * register layout before extension callbacks run.  ORIGINAL still
+		 * identifies openat2, while CURRENT SYSARG_3 is the decoded flags. */
+		*flags = peek_reg(tracee, CURRENT, SYSARG_3);
+		return 0;
+	}
+	return -EINVAL;
+}
+
+static int install_kernel_open_flags(Tracee *tracee, Sysnum sysnum,
+	word_t flags)
+{
+	if (sysnum == PR_open) {
+		poke_reg(tracee, SYSARG_2, flags);
+		return 0;
+	}
+	if (sysnum == PR_openat) {
+		poke_reg(tracee, SYSARG_3, flags);
+		return 0;
+	}
+	if (sysnum == PR_creat) {
+		word_t path = peek_reg(tracee, CURRENT, SYSARG_1);
+		word_t mode = peek_reg(tracee, CURRENT, SYSARG_2);
+		set_sysnum(tracee, PR_openat);
+		poke_reg(tracee, SYSARG_1, AT_FDCWD);
+		poke_reg(tracee, SYSARG_2, path);
+		poke_reg(tracee, SYSARG_3, flags);
+		poke_reg(tracee, SYSARG_4, mode);
+		return 0;
+	}
+	if (sysnum == PR_openat2) {
+		poke_reg(tracee, SYSARG_3, flags);
+		return 0;
+	}
+	return -EINVAL;
+}
+
+static int resolve_host_file(Tracee *tracee, KfBlockConfig *config,
+	const char *path, KfBlockFile **output)
+{
+	KfViewBlockSpec spec;
+	int status;
+	*output = NULL;
+	if (config->probe_file != NULL &&
+		strcmp(path, config->probe_file->base_path) == 0) {
+		*output = config->probe_file;
+		return 1;
+	}
+	status = kf_view_resolve_block_file(tracee, path, &spec);
+	if (status <= 0)
+		return status;
+	KfBlockFile *parent = NULL;
+	for (size_t index = 0; index < spec.layer_count; index++) {
+		status = get_block_file(config->runtime,
+			spec.layers[index].delta_path, spec.base_path, parent,
+			spec.layers[index].delta_path, spec.layers[index].meta_path,
+			&parent);
+		if (status < 0)
+			return status;
+	}
+	*output = parent;
+	return status < 0 ? status : 1;
+}
+
+static int resolve_path_file(Tracee *tracee, KfBlockConfig *config,
+	Sysnum sysnum, KfBlockFile **output)
+{
+	char path[PATH_MAX];
+	int status;
+	status = read_path(tracee, path,
+		peek_reg(tracee, CURRENT, path_register(sysnum)));
+	if (status < 0)
+		return status;
+	return resolve_host_file(tracee, config, path, output);
+}
+
+static ssize_t host_fd_index(const KfBlockRuntime *runtime, int fd)
+{
+	for (size_t index = 0; index < runtime->host_fd_count; index++)
+		if (runtime->host_fds[index].fd == fd)
+			return (ssize_t) index;
+	return -1;
+}
+
+int kf_block_host_open(const Tracee *tracee_, const char *path)
+{
+	Tracee *tracee = (Tracee *) tracee_;
+	KfBlockConfig *config = block_config_for_tracee(tracee);
+	KfBlockFile *file = NULL;
+	int fd;
+	int status;
+	if (config == NULL)
+		return open(path, O_RDONLY | O_CLOEXEC);
+	status = resolve_host_file(tracee, config, path, &file);
+	if (getenv("KF_PROOT_VIEW_DEBUG") != NULL)
+		fprintf(stderr, "kf_block host open path=%s managed=%d base=%s\n",
+			path, file != NULL, file == NULL ? "<none>" : file->base_path);
+	if (status < 0) {
+		errno = -status;
+		return -1;
+	}
+	fd = open(file == NULL ? path : file->base_path, O_RDONLY | O_CLOEXEC);
+	if (fd < 0 || file == NULL)
+		return fd;
+	if (config->runtime->host_fd_count >= KF_MAX_HOST_FDS) {
+		close(fd);
+		errno = EMFILE;
+		return -1;
+	}
+	config->runtime->host_fds[config->runtime->host_fd_count].fd = fd;
+	config->runtime->host_fds[config->runtime->host_fd_count].offset = 0;
+	config->runtime->host_fds[config->runtime->host_fd_count].file = file;
+	config->runtime->host_fd_count++;
+	return fd;
+}
+
+ssize_t kf_block_host_pread(const Tracee *tracee, int fd, void *buffer,
+	size_t length, off_t offset)
+{
+	KfBlockConfig *config = block_config_for_tracee((Tracee *) tracee);
+	ssize_t index;
+	size_t completed = 0;
+	int status;
+	if (config == NULL ||
+		(index = host_fd_index(config->runtime, fd)) < 0)
+		return pread(fd, buffer, length, offset);
+	status = kf_block_store_read(config->runtime->host_fds[index].file->store,
+		buffer, length, offset, &completed);
+	if (status < 0) {
+		errno = -status;
+		return -1;
+	}
+	return (ssize_t) completed;
+}
+
+ssize_t kf_block_host_read(const Tracee *tracee, int fd, void *buffer,
+	size_t length)
+{
+	KfBlockConfig *config = block_config_for_tracee((Tracee *) tracee);
+	ssize_t index;
+	ssize_t completed;
+	if (config == NULL ||
+		(index = host_fd_index(config->runtime, fd)) < 0)
+		return read(fd, buffer, length);
+	completed = kf_block_host_pread(tracee, fd, buffer, length,
+		config->runtime->host_fds[index].offset);
+	if (completed > 0)
+		config->runtime->host_fds[index].offset += completed;
+	return completed;
+}
+
+off_t kf_block_host_lseek(const Tracee *tracee, int fd, off_t offset,
+	int whence)
+{
+	KfBlockConfig *config = block_config_for_tracee((Tracee *) tracee);
+	KfBlockStoreStats stats;
+	ssize_t index;
+	off_t target;
+	if (config == NULL ||
+		(index = host_fd_index(config->runtime, fd)) < 0)
+		return lseek(fd, offset, whence);
+	switch (whence) {
+	case SEEK_SET: target = offset; break;
+	case SEEK_CUR: target = config->runtime->host_fds[index].offset + offset; break;
+	case SEEK_END:
+		kf_block_store_stats(config->runtime->host_fds[index].file->store,
+			&stats);
+		target = stats.visible_size + offset;
+		break;
+	default: errno = EINVAL; return -1;
+	}
+	if (target < 0) {
+		errno = EINVAL;
+		return -1;
+	}
+	config->runtime->host_fds[index].offset = target;
+	return target;
+}
+
+int kf_block_host_close(const Tracee *tracee, int fd)
+{
+	KfBlockConfig *config = block_config_for_tracee((Tracee *) tracee);
+	ssize_t index;
+	if (config != NULL &&
+		(index = host_fd_index(config->runtime, fd)) >= 0) {
+		config->runtime->host_fds[index] =
+			config->runtime->host_fds[config->runtime->host_fd_count - 1];
+		config->runtime->host_fd_count--;
+	}
+	return close(fd);
+}
+
+static int truncate_block_file(Tracee *tracee, KfBlockConfig *config,
+	KfBlockFile *file, off_t size)
+{
+	int status;
+	if (file_has_writable_private_mapping(file))
+		return -EOPNOTSUPP;
+	if (file_has_mappings(file)) {
+		status = preflight_mapping_barrier(tracee, file);
+		if (status < 0)
+			return status;
+	}
+	status = kf_block_store_truncate(file->store, size);
+	if (status < 0)
+		return status;
+	status = suppress_with_result(tracee, config, 0);
+	if (status < 0)
+		return status;
+	if (!file_has_mappings(file))
+		return 0;
+	status = begin_mapping_barrier(tracee, config, file, 0, 0, false,
+		KF_BARRIER_REFRESH_SIZE);
+	if (status < 0) {
+		fail_mapping_barrier(file, status);
+		return status;
+	}
+	return 0;
+}
+
+static int handle_syscall_enter(Tracee *tracee, KfBlockConfig *config)
+{
+	Sysnum sysnum = get_sysnum(tracee, ORIGINAL);
+	KfBlockFile *file = NULL;
+	KfBlockFd *tracked;
+	int status;
+
+	config->pending_kind = KF_PENDING_NONE;
+	config->pending_mmap = false;
+	config->pending_mprotect = false;
+	config->pending_open_file = NULL;
+	config->pending_stat_file = NULL;
+	config->pending_stat_sysnum = PR_void;
+	config->pending_mmap_file = NULL;
+	if (sysnum == PR_close_range) {
+		unsigned int first = (unsigned int) peek_reg(tracee, CURRENT,
+			SYSARG_1);
+		unsigned int last = (unsigned int) peek_reg(tracee, CURRENT,
+			SYSARG_2);
+		unsigned int flags = (unsigned int) peek_reg(tracee, CURRENT,
+			SYSARG_3);
+		if (first > last)
+			return suppress_with_result(tracee, config, -EINVAL) < 0
+				? -EINVAL : 1;
+		if ((flags & ~(CLOSE_RANGE_CLOEXEC | CLOSE_RANGE_UNSHARE)) != 0)
+			return suppress_with_result(tracee, config, -EINVAL) < 0
+				? -EINVAL : 1;
+		if ((flags & CLOSE_RANGE_UNSHARE) != 0)
+			return suppress_with_result(tracee, config, -EOPNOTSUPP) < 0
+				? -EOPNOTSUPP : 1;
+		config->pending_kind = KF_PENDING_CLOSE_RANGE;
+		config->pending_close_first = first;
+		config->pending_close_last = last;
+		config->pending_close_flags = flags;
+		set_sysnum(tracee, PR_getpid);
+		return 1;
+	}
+	if (config->promotion_staged) {
+		int fd = (int) peek_reg(tracee, CURRENT, SYSARG_1);
+		if (fd != config->staged_promotion_fd) {
+			config->promotion_staged = false;
+			config->staged_promotion_file = NULL;
+			return -EBADF;
+		}
+		switch (sysnum) {
+		case PR_fchmod:
+		case PR_fchown:
+		case PR_fchown32:
+		case PR_fsetxattr:
+		case PR_fremovexattr:
+		case PR_futimesat:
+		case PR_utimensat:
+			break;
+		default:
+			config->promotion_staged = false;
+			config->staged_promotion_file = NULL;
+			return -EOPNOTSUPP;
+		}
+		config->pending_kind = KF_PENDING_PROMOTE_METADATA;
+		config->pending_metadata_sysnum = sysnum;
+		for (size_t index = 0; index < 6; index++)
+			config->pending_metadata_args[index] =
+				peek_reg(tracee, CURRENT, SYSARG_1 + index);
+		set_sysnum(tracee, PR_getpid);
+		config->promotion_staged = false;
+		return 1;
+	}
+	if (sysnum == PR_open || sysnum == PR_openat ||
+		sysnum == PR_openat2 || sysnum == PR_creat) {
+		word_t flags;
+		status = read_open_flags(tracee, sysnum, &flags);
+		if (status < 0)
+			return status;
+		status = resolve_path_file(tracee, config, sysnum, &file);
+		if (status < 0)
+			return status;
+	}
+	if (file != NULL) {
+		word_t flags;
+		status = read_open_flags(tracee, sysnum, &flags);
+		if (status < 0)
+			return status;
+		word_t kernel_flags = (flags & ~(word_t) (O_ACCMODE | O_TRUNC)) |
+			O_RDONLY;
+		if (getenv("KF_PROOT_VIEW_DEBUG") != NULL)
+			fprintf(stderr, "kf_block tracee open file=%s flags=0x%lx\n",
+				file->identity, (unsigned long) flags);
+		if ((flags & O_CREAT) != 0 && (flags & O_EXCL) != 0) {
+			suppress_with_result(tracee, config, -EEXIST);
+			return 1;
+		}
+		status = set_sysarg_path(tracee, file->base_path,
+			path_register(sysnum));
+		if (status < 0)
+			return status;
+		status = install_kernel_open_flags(tracee, sysnum, kernel_flags);
+		if (status < 0)
+			return status;
+		config->pending_kind = KF_PENDING_OPEN;
+		config->pending_open_file = file;
+		config->pending_open_flags = flags;
+		return 1;
+	}
+	if ((sysnum == PR_read || sysnum == PR_pread64 ||
+		sysnum == PR_write || sysnum == PR_pwrite64) &&
+		tracked_fd(config, (int) peek_reg(tracee, CURRENT, SYSARG_1)) != NULL) {
+		status = emulate_fd_io(tracee, config, sysnum);
+		return status < 0 ? status : 1;
+	}
+	if ((sysnum == PR_readv || sysnum == PR_preadv || sysnum == PR_preadv2 ||
+		sysnum == PR_writev || sysnum == PR_pwritev ||
+		sysnum == PR_pwritev2) &&
+		tracked_fd(config, (int) peek_reg(tracee, CURRENT, SYSARG_1)) != NULL) {
+		status = emulate_vector_io(tracee, config, sysnum);
+		return status < 0 ? status : 1;
+	}
+	tracked = tracked_fd(config,
+		(int) peek_reg(tracee, CURRENT, SYSARG_1));
+	if (tracked != NULL && getenv("KF_PROOT_VIEW_DEBUG") != NULL)
+		fprintf(stderr, "kf_block tracked syscall=%s(%ld) fd=%ld file=%s\n",
+			stringify_sysnum(sysnum), (long) sysnum,
+			(long) peek_reg(tracee, CURRENT, SYSARG_1),
+			tracked->file->identity);
+	if (sysnum == PR_close && tracked != NULL) {
+		/* A per-fd seccomp filter can only be added, never removed.  Observe
+		 * the close result so the userspace fd table stops associating a later
+		 * reuse of this number with the old block file. */
+		config->pending_kind = KF_PENDING_CLOSE;
+	}
+	if ((sysnum == PR_ftruncate || sysnum == PR_ftruncate64) &&
+		tracked != NULL) {
+		off_t size;
+		status = truncate_position(tracee, sysnum, &size);
+		if (status < 0)
+			return status;
+		status = truncate_block_file(tracee, config, tracked->file, size);
+		if (status < 0)
+			return status;
+		return 1;
+	}
+	if (sysnum == PR_truncate || sysnum == PR_truncate64) {
+		status = resolve_path_file(tracee, config, sysnum, &file);
+		if (status < 0)
+			return status;
+	}
+	if (file != NULL) {
+		off_t size;
+		status = truncate_position(tracee, sysnum, &size);
+		if (status < 0)
+			return status;
+		status = truncate_block_file(tracee, config, file, size);
+		if (status < 0)
+			return status;
+		return 1;
+	}
+	if ((sysnum == PR_fsync || sysnum == PR_fdatasync) && tracked != NULL) {
+		status = kf_block_store_sync(tracked->file->store);
+		if (status < 0)
+			return status;
+		suppress_with_result(tracee, config, 0);
+		return 1;
+	}
+	if (sysnum == PR_lseek && tracked != NULL &&
+		(int) peek_reg(tracee, CURRENT, SYSARG_3) == SEEK_END) {
+		KfBlockStoreStats stats;
+		off_t requested = (off_t) peek_reg(tracee, CURRENT, SYSARG_2);
+		off_t target;
+		kf_block_store_stats(tracked->file->store, &stats);
+		if (requested > 0 && stats.visible_size > INT64_MAX - requested)
+			return -EOVERFLOW;
+		target = stats.visible_size + requested;
+		if (target < 0)
+			return -EINVAL;
+		replace_with_lseek(tracee, config,
+			(int) peek_reg(tracee, CURRENT, SYSARG_1), target,
+			(long) target);
+		return 1;
+	}
+	if (sysnum == PR__llseek && tracked != NULL &&
+		(int) peek_reg(tracee, CURRENT, SYSARG_5) == SEEK_END) {
+		KfBlockStoreStats stats;
+		off_t requested = signed_offset(
+			(uint32_t) peek_reg(tracee, CURRENT, SYSARG_3),
+			(uint32_t) peek_reg(tracee, CURRENT, SYSARG_2));
+		off_t target;
+		kf_block_store_stats(tracked->file->store, &stats);
+		if (requested > 0 && stats.visible_size > INT64_MAX - requested)
+			return -EOVERFLOW;
+		target = stats.visible_size + requested;
+		if (target < 0)
+			return -EINVAL;
+		replace_with_llseek(tracee, target);
+		return 1;
+	}
+	if (sysnum == PR_lseek && tracked != NULL &&
+		((int) peek_reg(tracee, CURRENT, SYSARG_3) == SEEK_DATA ||
+		 (int) peek_reg(tracee, CURRENT, SYSARG_3) == SEEK_HOLE)) {
+		KfBlockStoreStats stats;
+		off_t requested = (off_t) peek_reg(tracee, CURRENT, SYSARG_2);
+		off_t target;
+		if (requested < 0) {
+			suppress_with_result(tracee, config, -EINVAL);
+			return 1;
+		}
+		kf_block_store_stats(tracked->file->store, &stats);
+		if (requested >= stats.visible_size) {
+			suppress_with_result(tracee, config, -ENXIO);
+			return 1;
+		}
+		target = (int) peek_reg(tracee, CURRENT, SYSARG_3) == SEEK_DATA
+			? requested : stats.visible_size;
+		replace_with_lseek(tracee, config,
+			(int) peek_reg(tracee, CURRENT, SYSARG_1), target,
+			(long) target);
+		return 1;
+	}
+	if (sysnum == PR__llseek && tracked != NULL &&
+		((int) peek_reg(tracee, CURRENT, SYSARG_5) == SEEK_DATA ||
+		 (int) peek_reg(tracee, CURRENT, SYSARG_5) == SEEK_HOLE)) {
+		KfBlockStoreStats stats;
+		off_t requested = signed_offset(
+			(uint32_t) peek_reg(tracee, CURRENT, SYSARG_3),
+			(uint32_t) peek_reg(tracee, CURRENT, SYSARG_2));
+		off_t target;
+		if (requested < 0) {
+			suppress_with_result(tracee, config, -EINVAL);
+			return 1;
+		}
+		kf_block_store_stats(tracked->file->store, &stats);
+		if (requested >= stats.visible_size) {
+			suppress_with_result(tracee, config, -ENXIO);
+			return 1;
+		}
+		target = (int) peek_reg(tracee, CURRENT, SYSARG_5) == SEEK_DATA
+			? requested : stats.visible_size;
+		replace_with_llseek(tracee, target);
+		return 1;
+	}
+	if ((sysnum == PR_fstat || sysnum == PR_fstat64) && tracked != NULL) {
+		if (tracked->shadow_fd < 0)
+			return -EBADF;
+		poke_reg(tracee, SYSARG_1, (word_t) tracked->shadow_fd);
+		config->pending_kind = KF_PENDING_STAT;
+		config->pending_stat_buffer = peek_reg(tracee, CURRENT, SYSARG_2);
+		config->pending_stat_file = tracked->file;
+		config->pending_stat_sysnum = sysnum;
+	}
+	if ((sysnum == PR_fchmod || sysnum == PR_fchown ||
+		sysnum == PR_fchown32 || sysnum == PR_fsetxattr ||
+		sysnum == PR_fremovexattr) && tracked != NULL) {
+		if (tracked->shadow_fd < 0)
+			return -EBADF;
+		if (getenv("KF_PROOT_VIEW_DEBUG") != NULL)
+			fprintf(stderr,
+				"kf_block fd metadata pid=%d original=%ld current=%ld shadow=%d syscall=%ld\n",
+				tracee->pid,
+				(long) peek_reg(tracee, ORIGINAL, SYSARG_1),
+				(long) peek_reg(tracee, CURRENT, SYSARG_1),
+				tracked->shadow_fd, (long) sysnum);
+		poke_reg(tracee, SYSARG_1, (word_t) tracked->shadow_fd);
+	}
+	if ((sysnum == PR_futimesat || sysnum == PR_utimensat) &&
+		peek_reg(tracee, CURRENT, SYSARG_2) == 0 &&
+		tracked != NULL) {
+		if (tracked->shadow_fd < 0)
+			return -EBADF;
+		poke_reg(tracee, SYSARG_1, (word_t) tracked->shadow_fd);
+	}
+	if (sysnum == PR_fallocate && tracked != NULL) {
+		suppress_with_result(tracee, config, -EOPNOTSUPP);
+		return 1;
+	}
+	if ((sysnum == PR_sendfile || sysnum == PR_sendfile64) &&
+		(tracked_fd(config, (int) peek_reg(tracee, CURRENT, SYSARG_1)) != NULL ||
+		 tracked_fd(config, (int) peek_reg(tracee, CURRENT, SYSARG_2)) != NULL)) {
+		suppress_with_result(tracee, config, -EOPNOTSUPP);
+		return 1;
+	}
+	if ((sysnum == PR_splice || sysnum == PR_copy_file_range) &&
+		(tracked_fd(config, (int) peek_reg(tracee, CURRENT, SYSARG_1)) != NULL ||
+		 tracked_fd(config, (int) peek_reg(tracee, CURRENT, SYSARG_3)) != NULL)) {
+		suppress_with_result(tracee, config, -EOPNOTSUPP);
+		return 1;
+	}
+	if (sysnum == PR_ioctl && tracked != NULL) {
+		suppress_with_result(tracee, config, -EOPNOTSUPP);
+		return 1;
+	}
+	if (sysnum == PR_remap_file_pages && mapping_range_overlaps(config,
+		peek_reg(tracee, CURRENT, SYSARG_1),
+		peek_reg(tracee, CURRENT, SYSARG_2))) {
+		suppress_with_result(tracee, config, -EOPNOTSUPP);
+		return 1;
+	}
+	else if (sysnum == PR_newfstatat || sysnum == PR_fstatat64 ||
+		sysnum == PR_stat || sysnum == PR_stat64) {
+		status = resolve_path_file(tracee, config, sysnum, &file);
+		if (status < 0)
+			return status;
+		if (file != NULL) {
+			config->pending_kind = KF_PENDING_STAT;
+			config->pending_stat_buffer = (sysnum == PR_stat ||
+				sysnum == PR_stat64)
+				? peek_reg(tracee, CURRENT, SYSARG_2)
+				: peek_reg(tracee, CURRENT, SYSARG_3);
+			config->pending_stat_file = file;
+			config->pending_stat_sysnum = sysnum;
+		}
+	}
+	if ((sysnum == PR_dup || sysnum == PR_dup2 || sysnum == PR_dup3) &&
+		(tracked_fd(config, (int) peek_reg(tracee, CURRENT, SYSARG_1)) != NULL ||
+		 ((sysnum == PR_dup2 || sysnum == PR_dup3) &&
+		  tracked_fd(config, (int) peek_reg(tracee, CURRENT, SYSARG_2)) != NULL))) {
+		config->pending_kind = KF_PENDING_DUP;
+		config->pending_dup_source = (int) peek_reg(tracee, CURRENT, SYSARG_1);
+		config->pending_dup_cloexec = sysnum == PR_dup3 &&
+			(peek_reg(tracee, CURRENT, SYSARG_3) & O_CLOEXEC) != 0;
+	}
+	if ((sysnum == PR_fcntl || sysnum == PR_fcntl64) && tracked != NULL) {
+		int command = (int) peek_reg(tracee, CURRENT, SYSARG_2);
+		if (is_fcntl_lock_command(tracee, command)) {
+			status = validate_fcntl_lock_access(tracee, tracked, command);
+			if (status < 0) {
+				suppress_with_result(tracee, config, status);
+				return 1;
+			}
+			if (tracked->shadow_fd < 0)
+				return -EBADF;
+			poke_reg(tracee, SYSARG_1, (word_t) tracked->shadow_fd);
+		}
+		else if (command == F_GETFL) {
+			suppress_with_result(tracee, config, (long) tracked->flags);
+			return 1;
+		}
+		else if (command == F_DUPFD || command == F_DUPFD_CLOEXEC) {
+			config->pending_kind = KF_PENDING_DUP;
+			config->pending_dup_source =
+				(int) peek_reg(tracee, CURRENT, SYSARG_1);
+			config->pending_dup_cloexec = command == F_DUPFD_CLOEXEC;
+		}
+		else if (command == F_SETFL) {
+			config->pending_kind = KF_PENDING_SETFL;
+			config->pending_setfl_fd =
+				(int) peek_reg(tracee, CURRENT, SYSARG_1);
+			config->pending_setfl_flags =
+				peek_reg(tracee, CURRENT, SYSARG_3);
+		}
+		else if (command == F_SETFD) {
+			config->pending_kind = KF_PENDING_SETFD;
+			config->pending_setfd_fd =
+				(int) peek_reg(tracee, CURRENT, SYSARG_1);
+			config->pending_setfd_cloexec =
+				(peek_reg(tracee, CURRENT, SYSARG_3) & FD_CLOEXEC) != 0;
+		}
+	}
+	if (sysnum == PR_flock && tracked != NULL) {
+		if (tracked->shadow_fd < 0)
+			return -EBADF;
+		poke_reg(tracee, SYSARG_1, (word_t) tracked->shadow_fd);
+	}
+	if ((sysnum == PR_mmap || sysnum == PR_mmap2) &&
+		(tracked = tracked_fd(config,
+			(int) peek_reg(tracee, CURRENT, SYSARG_5))) != NULL) {
+		word_t prot = peek_reg(tracee, CURRENT, SYSARG_3);
+		word_t flags = peek_reg(tracee, CURRENT, SYSARG_4);
+		off_t offset;
+		status = mmap_position(tracee, sysnum, &offset);
+		if (status < 0) {
+			suppress_with_result(tracee, config, status);
+			return 1;
+		}
+		config->pending_mmap = true;
+		config->pending_mmap_file = tracked->file;
+		config->pending_mmap_length = peek_reg(tracee, CURRENT, SYSARG_2);
+		config->pending_mmap_offset = offset;
+		config->pending_mmap_protection = prot;
+		config->pending_mmap_flags = flags;
+		if ((prot & PROT_WRITE) != 0 && (flags & MAP_SHARED) != 0) {
+			poke_reg(tracee, SYSARG_3, (prot | PROT_READ) & ~PROT_WRITE);
+			poke_reg(tracee, SYSARG_4, (flags & ~MAP_SHARED) | MAP_PRIVATE);
+		}
+	}
+	if (sysnum == PR_mremap && mapping_range_overlaps(config,
+		peek_reg(tracee, CURRENT, SYSARG_1),
+		peek_reg(tracee, CURRENT, SYSARG_2))) {
+		/* Moving a managed mapping without atomically moving every block-view
+		 * interval would leave stale fault targets.  Reject it until the full
+		 * interval move contract is implemented. */
+		suppress_with_result(tracee, config, -EOPNOTSUPP);
+		return 1;
+	}
+	if (sysnum == PR_munmap && mapping_range_overlaps(config,
+		peek_reg(tracee, CURRENT, SYSARG_1),
+		peek_reg(tracee, CURRENT, SYSARG_2)))
+		config->pending_munmap = true;
+	if (sysnum == PR_mprotect && mapping_range_overlaps(config,
+		peek_reg(tracee, CURRENT, SYSARG_1),
+		peek_reg(tracee, CURRENT, SYSARG_2))) {
+		word_t address = peek_reg(tracee, CURRENT, SYSARG_1);
+		word_t length = peek_reg(tracee, CURRENT, SYSARG_2);
+		word_t protection = peek_reg(tracee, CURRENT, SYSARG_3);
+		if (getenv("KF_PROOT_VIEW_DEBUG") != NULL)
+			fprintf(stderr, "kf_block mprotect address=0x%lx length=%lu prot=0x%lx mappings=%zu\n",
+				(unsigned long) address, (unsigned long) length,
+				(unsigned long) protection, config->mapping_count);
+		if ((protection & PROT_WRITE) != 0) {
+			if (!mapping_range_fully_covered(config, address, length)) {
+				suppress_with_result(tracee, config, -EOPNOTSUPP);
+				return 1;
+			}
+			poke_reg(tracee, SYSARG_3,
+				(protection | PROT_READ) & ~PROT_WRITE);
+		}
+		config->pending_mprotect = true;
+		config->pending_mprotect_address = address;
+		config->pending_mprotect_length = length;
+		config->pending_mprotect_protection = protection;
+	}
+	return 0;
+}
+
+static int patch_stat_size(Tracee *tracee, Sysnum sysnum, word_t buffer,
+	off_t visible_size)
+{
+	if (!is_32on64_mode(tracee))
+		return write_data(tracee, buffer + offsetof(struct stat, st_size),
+			&visible_size, sizeof(visible_size));
+
+	if (sysnum == PR_stat64 || sysnum == PR_fstat64 ||
+		sysnum == PR_fstatat64) {
+		int64_t encoded = visible_size;
+#if defined(ARCH_ARM64)
+		const word_t offset = 48;
+#elif defined(ARCH_X86_64)
+		const word_t offset = 44;
+#else
+		return -EOPNOTSUPP;
+#endif
+		return write_data(tracee, buffer + offset, &encoded, sizeof(encoded));
+	}
+
+	if ((uint64_t) visible_size > UINT32_MAX)
+		return -EOVERFLOW;
+	{
+		uint32_t encoded = (uint32_t) visible_size;
+		/* ARM and i386 legacy struct stat place the 32-bit st_size after
+		 * dev/ino and the compact mode/identity fields. */
+		return write_data(tracee, buffer + 20, &encoded, sizeof(encoded));
+	}
+}
+
+static int handle_syscall_exit(Tracee *tracee, KfBlockConfig *config)
+{
+	Sysnum sysnum = get_sysnum(tracee, ORIGINAL);
+	word_t result = peek_reg(tracee, CURRENT, SYSARG_RESULT);
+
+	if (config->pending_kind == KF_PENDING_CLOSE_RANGE) {
+		int status;
+		config->pending_kind = KF_PENDING_NONE;
+		status = reconcile_close_range(tracee, config,
+			config->pending_close_first, config->pending_close_last,
+			config->pending_close_flags);
+		poke_reg(tracee, SYSARG_RESULT,
+			(word_t) (status < 0 ? status : 0));
+		result = (word_t) (status < 0 ? status : 0);
+	}
+	else if (config->pending_kind == KF_PENDING_CLOSE) {
+		/* The generic close reconciliation below owns the actual removal. */
+		config->pending_kind = KF_PENDING_NONE;
+	}
+	else if (config->pending_kind == KF_PENDING_PROMOTE_METADATA) {
+		KfBlockFile *file = config->staged_promotion_file;
+		int fd = config->staged_promotion_fd;
+		int shadow_fd = -1;
+		word_t metadata_result = (word_t) -EIO;
+		int status;
+
+		config->pending_kind = KF_PENDING_NONE;
+		config->staged_promotion_file = NULL;
+		status = open_shadow_in_tracee(tracee, file,
+			config->staged_promotion_cloexec, &shadow_fd);
+		if (status == 0)
+			status = track_fd(config, fd, config->staged_promotion_flags,
+				config->staged_promotion_cloexec, shadow_fd, file);
+		if (status == 0)
+			status = install_block_io_filter(tracee, config, fd);
+		if (status == 0)
+			status = install_block_lifecycle_filter(tracee, config);
+		if (status == 0) {
+			config->pending_metadata_args[0] = (word_t) shadow_fd;
+			status = execute_remote_syscall(tracee,
+				config->pending_metadata_sysnum,
+				config->pending_metadata_args[0],
+				config->pending_metadata_args[1],
+				config->pending_metadata_args[2],
+				config->pending_metadata_args[3],
+				config->pending_metadata_args[4],
+				config->pending_metadata_args[5], &metadata_result);
+		}
+		if (status < 0) {
+			if (shadow_fd >= 0) {
+				(void) untrack_fd(config, fd);
+				(void) execute_remote_syscall(tracee, PR_close,
+					(word_t) shadow_fd, 0, 0, 0, 0, 0, NULL);
+			}
+			metadata_result = (word_t) status;
+		}
+		poke_reg(tracee, SYSARG_RESULT, metadata_result);
+		result = metadata_result;
+	}
+	else if (config->pending_kind == KF_PENDING_RESULT) {
+		poke_reg(tracee, SYSARG_RESULT, (word_t) config->pending_result);
+		config->pending_kind = KF_PENDING_NONE;
+		result = (word_t) config->pending_result;
+	}
+	else if (config->pending_kind == KF_PENDING_OPEN) {
+		word_t flags = config->pending_open_flags;
+		KfBlockFile *file = config->pending_open_file;
+		int shadow_fd = -1;
+		config->pending_kind = KF_PENDING_NONE;
+		config->pending_open_file = NULL;
+		if ((long) result >= 0) {
+			int status = open_shadow_in_tracee(tracee, file,
+				(flags & O_CLOEXEC) != 0, &shadow_fd);
+			if (status < 0) {
+				(void) execute_remote_syscall(tracee, PR_close, result,
+					0, 0, 0, 0, 0, NULL);
+				poke_reg(tracee, SYSARG_RESULT, (word_t) status);
+				return 0;
+			}
+			status = track_fd(config, (int) result, flags,
+				(flags & O_CLOEXEC) != 0, shadow_fd, file);
+			if (status < 0)
+				goto open_failed;
+			status = install_block_io_filter(tracee, config, (int) result);
+			if (status == 0)
+				status = install_block_lifecycle_filter(tracee, config);
+			if (status < 0)
+				goto open_failed;
+			if ((flags & O_TRUNC) != 0) {
+				status = kf_block_store_truncate(file->store, 0);
+				if (status < 0)
+					goto open_failed;
+			}
+			return 0;
+		open_failed:
+			(void) untrack_fd(config, (int) result);
+			(void) execute_remote_syscall(tracee, PR_close, result,
+				0, 0, 0, 0, 0, NULL);
+			(void) execute_remote_syscall(tracee, PR_close,
+				(word_t) shadow_fd, 0, 0, 0, 0, 0, NULL);
+			poke_reg(tracee, SYSARG_RESULT, (word_t) status);
+			return 0;
+		}
+	}
+	else if (config->pending_kind == KF_PENDING_DUP) {
+		KfBlockFd *source = tracked_fd(config, config->pending_dup_source);
+		config->pending_kind = KF_PENDING_NONE;
+		if ((long) result >= 0) {
+			if (source != NULL) {
+				int source_fd = source->fd;
+				word_t flags = source->flags;
+				int shadow_fd = source->shadow_fd;
+				KfBlockFile *file = source->file;
+				int old_shadow = (int) result == source_fd ? -1 :
+					untrack_fd(config, (int) result);
+				int status = close_shadow_if_unused(tracee, config,
+					old_shadow);
+				if (status < 0)
+					return status;
+				if ((int) result == source_fd)
+					return 0;
+				status = track_fd(config, (int) result, flags,
+					config->pending_dup_cloexec, shadow_fd, file);
+				if (status < 0)
+					return status;
+				status = install_block_io_filter(tracee, config,
+					(int) result);
+				if (status == 0)
+					status = install_block_lifecycle_filter(tracee, config);
+				if (status < 0)
+					return status;
+				status = refresh_shadow_cloexec(tracee, config, shadow_fd);
+				if (status < 0)
+					return status;
+			}
+			else {
+				int shadow_fd = untrack_fd(config, (int) result);
+				int status = close_shadow_if_unused(tracee, config,
+					shadow_fd);
+				if (status < 0)
+					return status;
+			}
+		}
+	}
+	else if (config->pending_kind == KF_PENDING_SETFL) {
+		int fd = config->pending_setfl_fd;
+		word_t flags = config->pending_setfl_flags;
+		config->pending_kind = KF_PENDING_NONE;
+		if ((long) result == 0) {
+			KfBlockFd *tracked = tracked_fd(config, fd);
+			if (tracked != NULL)
+				tracked->flags = (tracked->flags & O_ACCMODE) |
+					(flags & ~O_ACCMODE);
+		}
+	}
+	else if (config->pending_kind == KF_PENDING_SETFD) {
+		int fd = config->pending_setfd_fd;
+		bool close_on_exec = config->pending_setfd_cloexec;
+		config->pending_kind = KF_PENDING_NONE;
+		if ((long) result == 0) {
+			KfBlockFd *tracked = tracked_fd(config, fd);
+			if (tracked != NULL) {
+				tracked->close_on_exec = close_on_exec;
+				return refresh_shadow_cloexec(tracee, config,
+					tracked->shadow_fd);
+			}
+		}
+	}
+	else if (config->pending_kind == KF_PENDING_STAT) {
+		word_t buffer = config->pending_stat_buffer;
+		KfBlockFile *file = config->pending_stat_file;
+		Sysnum stat_sysnum = config->pending_stat_sysnum;
+		config->pending_kind = KF_PENDING_NONE;
+		config->pending_stat_file = NULL;
+		if ((long) result == 0) {
+			KfBlockStoreStats stats;
+			int status;
+			kf_block_store_stats(file->store, &stats);
+			status = patch_stat_size(tracee, stat_sysnum, buffer,
+				stats.visible_size);
+			if (status == -EOVERFLOW) {
+				poke_reg(tracee, SYSARG_RESULT, (word_t) status);
+				result = (word_t) status;
+			}
+			else if (status < 0)
+				return status;
+		}
+	}
+	if (config->pending_mmap) {
+		KfBlockMapping *mapping;
+		KfBlockFile *file = config->pending_mmap_file;
+		word_t length = config->pending_mmap_length;
+		config->pending_mmap = false;
+		config->pending_mmap_file = NULL;
+		if ((long) result < 0)
+			return 0;
+		{
+			int status = remove_mapping_range(config, result, length);
+			if (status < 0)
+				return status;
+			if (config->mapping_count >= KF_MAX_MAPPINGS)
+				return -ENOSPC;
+			mapping = &config->mappings[config->mapping_count++];
+			mapping->address = result;
+			mapping->length = length;
+			mapping->offset = config->pending_mmap_offset;
+			mapping->protection = config->pending_mmap_protection;
+			mapping->flags = config->pending_mmap_flags;
+			mapping->file = file;
+			if (getenv("KF_PROOT_VIEW_DEBUG") != NULL)
+				fprintf(stderr, "kf_block mmap address=0x%lx length=%lu offset=%lld prot=0x%lx flags=0x%lx file=%s\n",
+					(unsigned long) mapping->address,
+					(unsigned long) mapping->length,
+					(long long) mapping->offset,
+					(unsigned long) mapping->protection,
+					(unsigned long) mapping->flags,
+					mapping->file->identity);
+			return map_existing_layers(tracee, mapping, mapping->file);
+		}
+	}
+	if ((sysnum == PR_mmap || sysnum == PR_mmap2) && (long) result >= 0 &&
+		!config->pending_mmap &&
+		(peek_reg(tracee, ORIGINAL, SYSARG_4) & MAP_FIXED) != 0) {
+		int status = remove_mapping_range(config, result,
+			peek_reg(tracee, ORIGINAL, SYSARG_2));
+		if (status < 0)
+			return status;
+	}
+	if (config->pending_munmap) {
+		config->pending_munmap = false;
+		if ((long) result != 0)
+			return 0;
+		int status = remove_mapping_range(config,
+			peek_reg(tracee, ORIGINAL, SYSARG_1),
+			peek_reg(tracee, ORIGINAL, SYSARG_2));
+		if (status < 0)
+			return status;
+	}
+	if (config->pending_mprotect) {
+		word_t address = config->pending_mprotect_address;
+		word_t length = config->pending_mprotect_length;
+		word_t protection = config->pending_mprotect_protection;
+		config->pending_mprotect = false;
+		config->pending_munmap = false;
+		if ((long) result == 0) {
+			int status = update_mapping_protection(config, address, length,
+				protection);
+			if (status < 0)
+				return status;
+			/* The kernel has already applied protections to the composed pages.
+			 * Replaying every layer here corrupts ELF/BSS mappings and is also
+			 * unnecessary when permissions are only being reduced.  When write
+			 * access was deliberately withheld on syscall entry, restore it only
+			 * for blocks already owned by this View.  Base, parent and grown-zero
+			 * pages stay read-only so their first write still enters block COW. */
+			if ((protection & PROT_WRITE) != 0) {
+				for (size_t index = 0;
+					index < config->mapping_count; index++) {
+					KfBlockMapping *mapping = &config->mappings[index];
+					if (!ranges_overlap(address, length, mapping->address,
+						mapping->length) ||
+						(mapping->flags & MAP_SHARED) == 0)
+						continue;
+					status = map_existing_top_layer(tracee, mapping);
+					if (status < 0)
+						return status;
+				}
+			}
+		}
+	}
+	if (sysnum == PR_close && (long) result == 0) {
+		int fd = (int) peek_reg(tracee, ORIGINAL, SYSARG_1);
+		int shadow_fd = untrack_fd(config, fd);
+		int status = close_shadow_if_unused(tracee, config, shadow_fd);
+		if (status < 0)
+			return status;
+	}
+	if ((sysnum == PR_execve || sysnum == PR_execveat) &&
+		(long) result == 0) {
+		untrack_close_on_exec_fds(config);
+	}
+	return 0;
+}
+
+static int handle_write_fault(Extension *extension, int tracee_status)
+{
+	KfBlockConfig *config = talloc_get_type_abort(extension->config,
+		KfBlockConfig);
+	Tracee *tracee = TRACEE(extension);
+	siginfo_t info;
+	word_t fault;
+	size_t block;
+	int status;
+
+	if (WIFSTOPPED(tracee_status) && WSTOPSIG(tracee_status) == SIGBUS) {
+		(void) fetch_regs(tracee);
+		if (ptrace(PTRACE_GETSIGINFO, tracee->pid, NULL, &info) == 0)
+			note(tracee, ERROR, INTERNAL,
+				"KF block View observed SIGBUS addr=%p code=%d pc=0x%lx",
+				info.si_addr, info.si_code,
+				(unsigned long) peek_reg(tracee, CURRENT, INSTR_POINTER));
+		return 0;
+	}
+	if (!WIFSTOPPED(tracee_status) || WSTOPSIG(tracee_status) != SIGSEGV)
+		return 0;
+	if (ptrace(PTRACE_GETSIGINFO, tracee->pid, NULL, &info) < 0)
+		return 0;
+	fault = (word_t) info.si_addr;
+	for (size_t index = 0; index < config->mapping_count; index++) {
+		KfBlockMapping *mapping = &config->mappings[index];
+		if (fault < mapping->address || fault >= mapping->address + mapping->length)
+			continue;
+		if ((mapping->protection & PROT_WRITE) == 0 ||
+			(mapping->flags & MAP_SHARED) == 0)
+			continue;
+		block = (size_t) ((mapping->offset +
+			(off_t) (fault - mapping->address)) / KF_BLOCK_SIZE);
+		status = kf_block_store_ensure_block(mapping->file->store, block);
+		if (status < 0) {
+			note(tracee, ERROR, INTERNAL,
+				"KF block View failed to persist block %zu: %s",
+				block, strerror(-status));
+			return 0;
+		}
+		status = begin_mapping_barrier(tracee, config, mapping->file,
+			block, 1, true, KF_BARRIER_BLOCKS);
+		if (status < 0) {
+			fail_mapping_barrier(mapping->file, status);
+			return 1;
+		}
+		/* begin_mapping_barrier() either resumed the only participant or
+		 * deliberately keeps this faulting tracee stopped until every process
+		 * sharing the mapping has installed the same delta block. */
+		return 1;
+	}
+	if (getenv("KF_PROOT_VIEW_DEBUG") != NULL)
+		note(tracee, ERROR, INTERNAL,
+			"KF block View unhandled SIGSEGV addr=%p code=%d pc=0x%lx mappings=%zu",
+			info.si_addr, info.si_code,
+			(unsigned long) peek_reg(tracee, CURRENT, INSTR_POINTER),
+			config->mapping_count);
+	return 0;
+}
+
+static int initialize_runtime(Extension *extension, KfBlockRuntime **output,
+	KfBlockFile **probe_file)
+{
+	const char *base = getenv("KF_PROOT_BLOCK_PROBE_BASE");
+	const char *delta = getenv("KF_PROOT_BLOCK_PROBE_DELTA");
+	const char *meta = getenv("KF_PROOT_BLOCK_PROBE_META");
+	KfBlockRuntime *runtime;
+	int status;
+
+	runtime = talloc_zero(extension, KfBlockRuntime);
+	if (runtime == NULL)
+		return -ENOMEM;
+	*probe_file = NULL;
+	if (base != NULL || delta != NULL || meta != NULL) {
+		if (base == NULL || delta == NULL || meta == NULL)
+			return -EINVAL;
+		status = get_block_file(runtime, "probe", base, NULL, delta, meta,
+			probe_file);
+		if (status < 0)
+			return status;
+		runtime->probe_mode = true;
+	}
+	*output = runtime;
+	return 0;
+}
+
+int kf_block_probe_callback(Extension *extension, ExtensionEvent event,
+	intptr_t data1, intptr_t data2)
+{
+	KfBlockConfig *config;
+	(void) data2;
+
+	switch (event) {
+	case INITIALIZATION: {
+		KfBlockRuntime *runtime;
+		KfBlockFile *probe_file;
+		int status = initialize_runtime(extension, &runtime, &probe_file);
+		if (status < 0)
+			return status;
+		config = talloc_zero(extension, KfBlockConfig);
+		if (config == NULL)
+			return -ENOMEM;
+		config->runtime = runtime;
+		config->probe_file = probe_file;
+		extension->config = config;
+		extension->filtered_sysnums = filtered_sysnums;
+		return 0;
+	}
+	case INHERIT_PARENT:
+		return 1;
+	case INHERIT_CHILD: {
+		Extension *parent = (Extension *) data1;
+		KfBlockConfig *parent_config = talloc_get_type_abort(parent->config,
+			KfBlockConfig);
+		config = talloc_zero(extension, KfBlockConfig);
+		if (config == NULL)
+			return -ENOMEM;
+		*config = *parent_config;
+		config->runtime = talloc_reference(config, parent_config->runtime);
+		if (config->runtime == NULL)
+			return -ENOMEM;
+		/* File descriptors, mappings and the already-installed seccomp fd
+		 * filters are inherited across fork.  A syscall that was pending in
+		 * the parent is not: the child starts after the cloning syscall and
+		 * must not complete the parent's open/dup/stat transaction. */
+		config->pending_kind = KF_PENDING_NONE;
+		config->pending_open_file = NULL;
+		config->pending_stat_file = NULL;
+		config->pending_stat_sysnum = PR_void;
+		config->promotion_staged = false;
+		config->staged_promotion_file = NULL;
+		config->pending_mmap = false;
+		config->pending_mmap_file = NULL;
+		config->pending_mprotect = false;
+		clear_barrier_member(config);
+		extension->config = config;
+		extension->filtered_sysnums = filtered_sysnums;
+		return 0;
+	}
+	case SYSCALL_ENTER_END: {
+		int status;
+		Tracee *tracee = TRACEE(extension);
+		config = talloc_get_type_abort(extension->config, KfBlockConfig);
+		status = handle_syscall_enter(tracee, config);
+		/* Keep ordinary files on seccomp's one-stop fast path.  Only a
+		 * syscall that actually touched a managed block file (or staged an
+		 * operation whose result must be observed) needs a syscall-exit
+		 * stop.  The old static FILTER_SYSEXIT flags doubled ptrace stops for
+		 * every read/write/stat while a View was active, even when no block
+		 * artifact existed for that path. */
+		if (config->pending_kind != KF_PENDING_NONE ||
+			config->pending_mmap || config->pending_mprotect ||
+			config->pending_munmap) {
+			tracee->sysexit_pending = true;
+			tracee->restart_how = PTRACE_SYSCALL;
+		}
+		return status;
+	}
+	case SYSCALL_EXIT_END:
+		config = talloc_get_type_abort(extension->config, KfBlockConfig);
+		return handle_syscall_exit(TRACEE(extension), config);
+	case STATX_SYSCALL: {
+		struct statx_syscall_state *state =
+			(struct statx_syscall_state *) data1;
+		KfBlockFile *file = NULL;
+		KfBlockStoreStats stats;
+		int status;
+		config = talloc_get_type_abort(extension->config, KfBlockConfig);
+		status = resolve_host_file(TRACEE(extension), config,
+			state->host_path, &file);
+		if (status < 0)
+			return status;
+		if (file == NULL)
+			return 0;
+		kf_block_store_stats(file->store, &stats);
+		state->statx_buf.stx_size = (uint64_t) stats.visible_size;
+		state->updated_stats = true;
+		return 0;
+	}
+	case NEW_STATUS:
+		config = talloc_get_type_abort(extension->config, KfBlockConfig);
+		/* A successful exec is reported as PTRACE_EVENT_EXEC, not reliably as
+		 * an ordinary syscall-exit stop.  The kernel has already closed every
+		 * FD_CLOEXEC descriptor at this point, so reconcile the userspace fd
+		 * table here before the dynamic linker reuses those numbers. */
+		if (WIFSTOPPED((int) data1) && WSTOPSIG((int) data1) == SIGTRAP &&
+			((unsigned int) data1 >> 16) == PTRACE_EVENT_EXEC)
+			untrack_close_on_exec_fds(config);
+		if (config->barrier_file != NULL || config->internal_sigstop_pending) {
+			int status = handle_barrier_status(extension, (int) data1);
+			if (status != 0)
+				return status;
+		}
+		return handle_write_fault(extension, (int) data1);
+	case BEFORE_RESTART:
+		return hold_before_restart(extension, (int) data1);
+	default:
+		return 0;
+	}
+}
