+	sigdelset(&blocked_sigset, SIGILL);
+	sigdelset(&blocked_sigset, SIGTRAP);
+	status = ptrace(PTRACE_SETSIGMASK, tracee->pid, sizeof(sigset_t), &blocked_sigset);
+	if (status < 0)
+		return -errno;
