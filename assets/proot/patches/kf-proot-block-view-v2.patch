+static KfBlockFd *tracked_fd(KfBlockConfig *config, int fd)
+{
+	for (size_t index = 0; index < config->fd_count; index++)
+		if (config->fds[index].fd == fd)
+			return &config->fds[index];
+	return NULL;
+}
+
+bool kf_block_fd_is_managed(Tracee *tracee, int fd)
+{
+	KfBlockConfig *config = block_config_for_tracee(tracee);
+	return config != NULL && tracked_fd(config, fd) != NULL;
+}
+
+static int track_fd(KfBlockConfig *config, int fd, word_t flags,
+	bool close_on_exec, int shadow_fd, KfBlockFile *file)
+{
+	KfBlockFd *existing = tracked_fd(config, fd);
+	if (existing != NULL) {
+		existing->flags = flags;
+		existing->close_on_exec = close_on_exec;
+		existing->shadow_fd = shadow_fd;
+		existing->file = file;
+		return 0;
+	}
+	if (config->fd_count >= KF_MAX_TRACKED_FDS)
+		return -EMFILE;
+	config->fds[config->fd_count].fd = fd;
+	config->fds[config->fd_count].flags = flags;
+	config->fds[config->fd_count].close_on_exec = close_on_exec;
+	config->fds[config->fd_count].shadow_fd = shadow_fd;
+	config->fds[config->fd_count].file = file;
+	config->fd_count++;
+	return 0;
+}
+
+static int untrack_fd(KfBlockConfig *config, int fd)
+{
+	for (size_t index = 0; index < config->fd_count; index++) {
+		if (config->fds[index].fd != fd)
+			continue;
+		int shadow_fd = config->fds[index].shadow_fd;
+		config->fds[index] = config->fds[config->fd_count - 1];
+		config->fd_count--;
+		return shadow_fd;
+	}
+	return -1;
+}
+
+static void untrack_close_on_exec_fds(KfBlockConfig *config)
+{
+	for (size_t index = 0; index < config->fd_count; ) {
+		if (!config->fds[index].close_on_exec) {
+			index++;
+			continue;
+		}
+		config->fds[index] = config->fds[config->fd_count - 1];
+		config->fd_count--;
+	}
+}
+
+static bool shadow_fd_is_used(const KfBlockConfig *config, int shadow_fd)
+{
+	if (shadow_fd < 0)
+		return false;
+	for (size_t index = 0; index < config->fd_count; index++)
+		if (config->fds[index].shadow_fd == shadow_fd)
+			return true;
+	return false;
+}
+
+static int close_shadow_if_unused(Tracee *tracee, KfBlockConfig *config,
+	int shadow_fd)
+{
+	word_t result = 0;
+	int status;
+	if (shadow_fd < 0 || shadow_fd_is_used(config, shadow_fd))
+		return 0;
+	status = execute_remote_syscall(tracee, PR_close, (word_t) shadow_fd,
+		0, 0, 0, 0, 0, &result);
+	if (status < 0)
+		return status;
+	return (long) result == -EBADF ? 0 :
+		((long) result < 0 ? (int) (long) result : 0);
+}
+
+static bool fd_in_unsigned_range(int fd, unsigned int first,
+	unsigned int last)
+{
+	return fd >= 0 && (unsigned int) fd >= first &&
+		(unsigned int) fd <= last;
+}
+
+static int compare_unsigned(const void *left, const void *right)
+{
+	unsigned int first = *(const unsigned int *) left;
+	unsigned int second = *(const unsigned int *) right;
+	return first < second ? -1 : first > second ? 1 : 0;
+}
+
+static int execute_close_range_preserving_shadows(Tracee *tracee,
+	KfBlockConfig *config, unsigned int first, unsigned int last,
+	unsigned int flags)
+{
+	char path[64];
+	DIR *directory;
+	struct dirent *entry;
+	unsigned int *descriptors = NULL;
+	size_t count = 0;
+	size_t capacity = 0;
+	unsigned int effective_last;
+	word_t result = 0;
+	int status = 0;
+	if (snprintf(path, sizeof(path), "/proc/%d/fd", tracee->pid) >=
+		(int) sizeof(path))
+		return -ENAMETOOLONG;
+	directory = opendir(path);
+	if (directory == NULL)
+		return -errno;
+	while ((entry = readdir(directory)) != NULL) {
+		char *end;
+		unsigned long value;
+		errno = 0;
+		value = strtoul(entry->d_name, &end, 10);
+		if (errno != 0 || end == entry->d_name || *end != '\0' ||
+			value > UINT_MAX || value < first || value > last ||
+			shadow_fd_is_used(config, (int) value))
+			continue;
+		if (count == capacity) {
+			size_t next_capacity = capacity == 0 ? 32 : capacity * 2;
+			unsigned int *next;
+			if (next_capacity < capacity ||
+				next_capacity > SIZE_MAX / sizeof(*descriptors)) {
+				status = -ENOMEM;
+				break;
+			}
+			next = realloc(descriptors,
+				next_capacity * sizeof(*descriptors));
+			if (next == NULL) {
+				status = -ENOMEM;
+				break;
+			}
+			descriptors = next;
+			capacity = next_capacity;
+		}
+		descriptors[count++] = (unsigned int) value;
+	}
+	closedir(directory);
+	if (status < 0)
+		goto done;
+	qsort(descriptors, count, sizeof(*descriptors), compare_unsigned);
+	for (size_t index = 0; index < count; index++) {
+		effective_last = descriptors[index];
+		status = execute_remote_syscall(tracee,
+			(flags & CLOSE_RANGE_CLOEXEC) != 0 ? PR_fcntl : PR_close,
+			(word_t) effective_last,
+			(flags & CLOSE_RANGE_CLOEXEC) != 0 ? F_SETFD : 0,
+			(flags & CLOSE_RANGE_CLOEXEC) != 0 ? FD_CLOEXEC : 0,
+			0, 0, 0, &result);
+		if (status < 0)
+			goto done;
+		if ((long) result < 0 && (long) result != -EBADF) {
+			status = (int) (long) result;
+			goto done;
+		}
+	}
+
+done:
+	free(descriptors);
+	return status;
+}
+
+static int reconcile_close_range(Tracee *tracee, KfBlockConfig *config,
+	unsigned int first, unsigned int last, unsigned int flags)
+{
+	int status = execute_close_range_preserving_shadows(tracee, config,
+		first, last, flags);
+	if (status < 0)
+		return status;
+	if ((flags & CLOSE_RANGE_CLOEXEC) != 0) {
+		for (size_t index = 0; index < config->fd_count; index++)
+			if (fd_in_unsigned_range(config->fds[index].fd, first, last))
+				config->fds[index].close_on_exec = true;
+		for (size_t index = 0; index < config->fd_count; index++) {
+			status = refresh_shadow_cloexec(tracee, config,
+				config->fds[index].shadow_fd);
+			if (status < 0)
+				return status;
+		}
+		return 0;
+	}
+	kf_view_forget_closed_range(tracee, first, last);
+	for (size_t index = config->fd_count; index > 0; index--) {
+		int fd = config->fds[index - 1].fd;
+		int shadow;
+		if (!fd_in_unsigned_range(fd, first, last))
+			continue;
+		shadow = untrack_fd(config, fd);
+		status = close_shadow_if_unused(tracee, config, shadow);
+		if (status < 0)
+			return status;
+	}
+	return 0;
+}
+
+static int refresh_shadow_cloexec(Tracee *tracee,
+	const KfBlockConfig *config, int shadow_fd)
+{
+	word_t result = 0;
+	bool any_alias = false;
+	bool all_cloexec = true;
+	int status;
+	if (shadow_fd < 0)
+		return -EBADF;
+	for (size_t index = 0; index < config->fd_count; index++) {
+		if (config->fds[index].shadow_fd != shadow_fd)
+			continue;
+		any_alias = true;
+		if (!config->fds[index].close_on_exec)
+			all_cloexec = false;
+	}
+	if (!any_alias)
+		return 0;
+	status = execute_remote_syscall(tracee, PR_fcntl, (word_t) shadow_fd,
+		F_SETFD, all_cloexec ? FD_CLOEXEC : 0, 0, 0, 0, &result);
+	if (status < 0)
+		return status;
+	return (long) result < 0 ? (int) (long) result : 0;
+}
+
+static int destroy_block_file(KfBlockFile *file)
+{
+	if (file->store != NULL)
+		(void) kf_block_store_sync(file->store);
+	return 0;
+}
+
+static KfBlockFile *find_block_file(KfBlockRuntime *runtime,
+	dev_t device, ino_t inode)
+{
+	KfBlockFile *file;
+	for (file = runtime->files; file != NULL; file = file->next)
+		if (file->delta_device == device && file->delta_inode == inode)
+			return file;
+	return NULL;
+}
+
+static int get_block_file(KfBlockRuntime *runtime, const char *identity,
+	const char *base_path, KfBlockFile *parent, const char *delta_path,
+	const char *meta_path, KfBlockFile **output)
+{
+	struct stat delta_stat;
+	struct stat meta_stat;
+	struct stat current_meta_stat;
+	KfBlockFile *file;
+	int status;
+	if (stat(delta_path, &delta_stat) != 0 || stat(meta_path, &meta_stat) != 0)
+		return -errno;
+	file = find_block_file(runtime, delta_stat.st_dev, delta_stat.st_ino);
+	if (file != NULL) {
+		status = kf_block_store_meta_stat(file->store, &current_meta_stat);
+		if (status < 0)
+			return status;
+		if (strcmp(file->base_path, base_path) != 0 || file->parent != parent ||
+			current_meta_stat.st_dev != meta_stat.st_dev ||
+			current_meta_stat.st_ino != meta_stat.st_ino)
+			return -EPROTO;
+		if (snprintf(file->identity, sizeof(file->identity), "%s", identity) >=
+			(int) sizeof(file->identity) ||
+			snprintf(file->delta_path, sizeof(file->delta_path), "%s",
+				delta_path) >= (int) sizeof(file->delta_path) ||
+			snprintf(file->meta_path, sizeof(file->meta_path), "%s",
+				meta_path) >= (int) sizeof(file->meta_path))
+			return -ENAMETOOLONG;
+		status = kf_block_store_rebind_paths(file->store, delta_path, meta_path);
+		if (status < 0)
+			return status;
+		*output = file;
+		return 0;
+	}
+	file = talloc_zero(runtime, KfBlockFile);
+	if (file == NULL)
+		return -ENOMEM;
+	if (snprintf(file->identity, sizeof(file->identity), "%s", identity) >=
+		(int) sizeof(file->identity) ||
+		snprintf(file->base_path, sizeof(file->base_path), "%s", base_path) >=
+		(int) sizeof(file->base_path) ||
+		snprintf(file->delta_path, sizeof(file->delta_path), "%s", delta_path) >=
+		(int) sizeof(file->delta_path) ||
+		snprintf(file->meta_path, sizeof(file->meta_path), "%s", meta_path) >=
+		(int) sizeof(file->meta_path)) {
+		TALLOC_FREE(file);
+		return -ENAMETOOLONG;
+	}
+	file->parent = parent;
+	status = parent == NULL
+		? kf_block_store_open(file, base_path, delta_path, meta_path,
+			KF_BLOCK_SIZE, &file->store)
+		: kf_block_store_open_layered(file, parent->store, delta_path,
+			meta_path, KF_BLOCK_SIZE, &file->store);
+	if (status < 0) {
+		TALLOC_FREE(file);
+		return status;
+	}
+	{
+		struct stat opened_stat;
+		status = kf_block_store_delta_stat(file->store, &opened_stat);
+		if (status < 0 || opened_stat.st_dev != delta_stat.st_dev ||
+			opened_stat.st_ino != delta_stat.st_ino) {
+			TALLOC_FREE(file);
+			return status < 0 ? status : -ESTALE;
+		}
+		file->delta_device = opened_stat.st_dev;
+		file->delta_inode = opened_stat.st_ino;
+	}
+	talloc_set_destructor(file, destroy_block_file);
+	file->next = runtime->files;
+	runtime->files = file;
+	*output = file;
+	return 0;
+}
+
+static bool config_has_mappings_for_file(const KfBlockConfig *config,
+	const KfBlockFile *file)
+{
+	for (size_t index = 0; index < config->mapping_count; index++)
+		if (config->mappings[index].file == file)
+			return true;
+	return false;
+}
+
+static bool ranges_overlap(word_t first_address, word_t first_length,
+	word_t second_address, word_t second_length)
+{
+	if (first_length == 0 || second_length == 0 ||
+		first_address > UINTPTR_MAX - first_length ||
+		second_address > UINTPTR_MAX - second_length)
+		return false;
+	return first_address < second_address + second_length &&
+		second_address < first_address + first_length;
+}
+
+static bool mapping_range_overlaps(const KfBlockConfig *config,
+	word_t address, word_t length)
+{
+	for (size_t index = 0; index < config->mapping_count; index++)
+		if (ranges_overlap(address, length, config->mappings[index].address,
+			config->mappings[index].length))
+			return true;
+	return false;
+}
+
+static bool mapping_range_fully_covered(const KfBlockConfig *config,
+	word_t address, word_t length)
+{
+	word_t cursor = address;
+	word_t end;
+	if (length == 0 || address > UINTPTR_MAX - length)
+		return false;
+	end = address + length;
+	while (cursor < end) {
+		word_t furthest = cursor;
+		for (size_t index = 0; index < config->mapping_count; index++) {
+			const KfBlockMapping *mapping = &config->mappings[index];
+			word_t mapping_end = mapping->address + mapping->length;
+			if (mapping->address <= cursor && mapping_end > furthest)
+				furthest = mapping_end;
+		}
+		if (furthest == cursor)
+			return false;
+		cursor = furthest < end ? furthest : end;
+	}
+	return true;
+}
+
+static int split_mapping_at(KfBlockConfig *config, size_t index,
+	word_t address)
+{
+	KfBlockMapping *left = &config->mappings[index];
+	KfBlockMapping *right;
+	word_t end = left->address + left->length;
+	if (address <= left->address || address >= end)
+		return 0;
+	if (config->mapping_count >= KF_MAX_MAPPINGS)
+		return -ENOSPC;
+	right = &config->mappings[config->mapping_count++];
+	*right = *left;
+	right->address = address;
+	right->length = end - address;
+	right->offset += (off_t) (address - left->address);
+	left->length = address - left->address;
+	return 0;
+}
+
+static int remove_mapping_range(KfBlockConfig *config, word_t address,
+	word_t length)
+{
+	word_t end;
+	if (length == 0)
+		return 0;
+	if (address > UINTPTR_MAX - length)
+		return -EOVERFLOW;
+	end = address + length;
+	for (size_t index = 0; index < config->mapping_count; ) {
+		KfBlockMapping *mapping = &config->mappings[index];
+		word_t mapping_end = mapping->address + mapping->length;
+		if (!ranges_overlap(address, length, mapping->address,
+			mapping->length)) {
+			index++;
+			continue;
+		}
+		if (address <= mapping->address && end >= mapping_end) {
+			*mapping = config->mappings[config->mapping_count - 1];
+			config->mapping_count--;
+			continue;
+		}
+		if (address <= mapping->address) {
+			mapping->offset += (off_t) (end - mapping->address);
+			mapping->length = mapping_end - end;
+			mapping->address = end;
+			index++;
+			continue;
+		}
+		if (end >= mapping_end) {
+			mapping->length = address - mapping->address;
+			index++;
+			continue;
+		}
+		{
+			int status = split_mapping_at(config, index, address);
+			if (status < 0)
+				return status;
+			/* The right half was appended; trim its overlapping prefix on the
+			 * next pass while retaining the left half. */
+			index++;
+		}
+	}
+	return 0;
+}
+
+static int update_mapping_protection(KfBlockConfig *config,
+	word_t address, word_t length, word_t protection)
+{
+	word_t end;
+	if (length == 0 || address > UINTPTR_MAX - length)
+		return length == 0 ? 0 : -EOVERFLOW;
+	end = address + length;
+	for (size_t index = 0; index < config->mapping_count; index++) {
+		KfBlockMapping *mapping = &config->mappings[index];
+		int status;
+		if (!ranges_overlap(address, length, mapping->address,
+			mapping->length))
+			continue;
+		status = split_mapping_at(config, index, address);
+		if (status < 0)
+			return status;
+		mapping = &config->mappings[index];
+		status = split_mapping_at(config, index, end);
+		if (status < 0)
+			return status;
+		mapping = &config->mappings[index];
+		if (mapping->address >= address && mapping->address < end)
+			mapping->protection = protection;
+	}
+	return 0;
+}
+
+static bool file_has_mappings(KfBlockFile *file)
+{
+	Tracee *tracee;
+	LIST_FOREACH(tracee, get_tracees_list_head(), link) {
+		KfBlockConfig *config = block_config_for_tracee(tracee);
+		if (!tracee->terminated && config != NULL &&
+			config_has_mappings_for_file(config, file))
+			return true;
+	}
+	return false;
+}
+
+static int read_fd_offset(pid_t pid, int fd, off_t *offset)
+{
+	char path[64];
+	char line[128];
+	FILE *stream;
+	if (snprintf(path, sizeof(path), "/proc/%d/fdinfo/%d", pid, fd) >=
+		(int) sizeof(path))
+		return -ENAMETOOLONG;
+	stream = fopen(path, "re");
+	if (stream == NULL)
+		return -errno;
+	while (fgets(line, sizeof(line), stream) != NULL) {
+		long long value;
+		if (sscanf(line, "pos:\t%lld", &value) == 1) {
+			fclose(stream);
+			*offset = (off_t) value;
+			return 0;
+		}
+	}
+	fclose(stream);
+	return -EIO;
+}
+
+static int read_fd_flags(pid_t pid, int fd, word_t *flags)
+{
+	char path[64];
+	char line[128];
+	FILE *stream;
+	if (snprintf(path, sizeof(path), "/proc/%d/fdinfo/%d", pid, fd) >=
+		(int) sizeof(path))
+		return -ENAMETOOLONG;
+	stream = fopen(path, "re");
+	if (stream == NULL)
+		return -errno;
+	while (fgets(line, sizeof(line), stream) != NULL) {
+		unsigned long long value;
+		if (sscanf(line, "flags:\t%llo", &value) == 1) {
+			fclose(stream);
+			*flags = (word_t) value;
+			return 0;
+		}
+	}
+	fclose(stream);
+	return -EIO;
+}
+
+static int suppress_with_result(Tracee *tracee, KfBlockConfig *config,
+	long result)
+{
+	set_sysnum(tracee, PR_getpid);
+	config->pending_kind = KF_PENDING_RESULT;
+	config->pending_result = result;
+	return 0;
+}
+
+static int replace_with_lseek(Tracee *tracee, KfBlockConfig *config,
+	int fd, off_t target, long reported_result)
+{
+	set_sysnum(tracee, PR_lseek);
+	poke_reg(tracee, SYSARG_1, (word_t) fd);
+	poke_reg(tracee, SYSARG_2, (word_t) target);
+	poke_reg(tracee, SYSARG_3, SEEK_SET);
+	config->pending_kind = KF_PENDING_RESULT;
+	config->pending_result = reported_result;
+	return 0;
+}
+
+static int replace_with_llseek(Tracee *tracee, off_t target)
+{
+	uint64_t encoded = (uint64_t) (int64_t) target;
+	poke_reg(tracee, SYSARG_2, (word_t) (encoded >> 32));
+	poke_reg(tracee, SYSARG_3, (word_t) (encoded & UINT32_MAX));
+	poke_reg(tracee, SYSARG_5, SEEK_SET);
+	return 0;
+}
+
+static int execute_remote_mmap(Tracee *tracee, word_t address, word_t length,
+	word_t protection, word_t flags, word_t fd, off_t offset, word_t *result)
+{
+	Sysnum sysnum = PR_mmap;
+	word_t encoded_offset;
+
+	if (detranslate_sysnum(get_abi(tracee), PR_mmap2) != SYSCALL_AVOIDER) {
+		if (offset < 0 || (offset % KF_MMAP2_UNIT) != 0)
+			return -EINVAL;
+		if ((uint64_t) offset / KF_MMAP2_UNIT > UINT32_MAX)
+			return -EOVERFLOW;
+		sysnum = PR_mmap2;
+		encoded_offset = (word_t) ((uint64_t) offset / KF_MMAP2_UNIT);
+	}
+	else
+		encoded_offset = (word_t) offset;
+	return execute_remote_syscall(tracee, sysnum, address, length,
+		protection, flags, fd, encoded_offset, result);
+}
+
+static int install_block_io_filter(Tracee *tracee, KfBlockConfig *config,
+	int managed_fd)
+{
+#if defined(HAVE_SECCOMP_FILTER)
+	SeccompArch architectures[] = SECCOMP_ARCHS;
+	struct sock_filter program[1024];
+	size_t count = 0;
+	word_t memory = 0;
+	word_t result = 0;
+	size_t filter_bytes;
+	size_t program_offset;
+	unsigned char remote_program[16] = { 0 };
+	uint16_t encoded_length;
+	int status;
+
+	for (size_t index = 0; index < config->io_filtered_fd_count; index++)
+		if (config->io_filtered_fds[index] == managed_fd)
+			return 0;
+	if (managed_fd < 0 ||
+		config->io_filtered_fd_count >= KF_MAX_TRACKED_FDS)
+		return -EMFILE;
+	for (size_t arch_index = 0;
+		arch_index < sizeof(architectures) / sizeof(architectures[0]);
+		arch_index++) {
+		size_t syscall_count = 0;
+		for (size_t abi_index = 0;
+			abi_index < architectures[arch_index].nb_abis; abi_index++)
+			for (size_t index = 0;
+				block_fd_sysnums[index].value != PR_void; index++)
+				if (detranslate_sysnum(
+					architectures[arch_index].abis[abi_index],
+					block_fd_sysnums[index].value) != SYSCALL_AVOIDER)
+					syscall_count++;
+		if (count + syscall_count * 5 + 5 >=
+			sizeof(program) / sizeof(program[0]))
+			return -E2BIG;
+		program[count++] = (struct sock_filter)
+			BPF_STMT(BPF_LD | BPF_W | BPF_ABS,
+				offsetof(struct seccomp_data, arch));
+		program[count++] = (struct sock_filter)
+			BPF_JUMP(BPF_JMP | BPF_JEQ | BPF_K,
+				architectures[arch_index].value, 1, 0);
+		program[count++] = (struct sock_filter)
+			BPF_JUMP(BPF_JMP | BPF_JA | BPF_K,
+				syscall_count * 5 + 2, 0, 0);
+		program[count++] = (struct sock_filter)
+			BPF_STMT(BPF_LD | BPF_W | BPF_ABS,
+				offsetof(struct seccomp_data, nr));
+		for (size_t abi_index = 0;
+			abi_index < architectures[arch_index].nb_abis; abi_index++) {
+			for (size_t index = 0;
+				block_fd_sysnums[index].value != PR_void; index++) {
+				word_t sysnum = detranslate_sysnum(
+					architectures[arch_index].abis[abi_index],
+					block_fd_sysnums[index].value);
+				if (sysnum == SYSCALL_AVOIDER)
+					continue;
+				program[count++] = (struct sock_filter)
+					BPF_JUMP(BPF_JMP | BPF_JEQ | BPF_K,
+						sysnum, 0, 3);
+				program[count++] = (struct sock_filter)
+					BPF_STMT(BPF_LD | BPF_W | BPF_ABS,
+						offsetof(struct seccomp_data, args) +
+						block_fd_sysnums[index].fd_argument *
+						sizeof(uint64_t));
+				program[count++] = (struct sock_filter)
+					BPF_JUMP(BPF_JMP | BPF_JEQ | BPF_K,
+						(uint32_t) managed_fd, 0, 1);
+				program[count++] = (struct sock_filter)
+					BPF_STMT(BPF_RET | BPF_K, SECCOMP_RET_TRACE);
+				program[count++] = (struct sock_filter)
+					BPF_STMT(BPF_LD | BPF_W | BPF_ABS,
+						offsetof(struct seccomp_data, nr));
+			}
+		}
+		program[count++] = (struct sock_filter)
+			BPF_STMT(BPF_RET | BPF_K, SECCOMP_RET_ALLOW);
+	}
+	program[count++] = (struct sock_filter)
+		BPF_STMT(BPF_RET | BPF_K, SECCOMP_RET_ALLOW);
+
+	filter_bytes = count * sizeof(program[0]);
+	program_offset = (filter_bytes + 15U) & ~15U;
+	if (program_offset + sizeof(remote_program) > 8192U || count > UINT16_MAX)
+		return -E2BIG;
+	status = execute_remote_mmap(tracee, 0, 8192,
+		PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS,
+		(word_t) -1, 0, &memory);
+	if (status < 0)
+		return status;
+	if ((long) memory < 0)
+		return (int) (long) memory;
+	status = write_data(tracee, memory, program, filter_bytes);
+	if (status < 0)
+		goto unmap;
+	encoded_length = (uint16_t) count;
+	memcpy(remote_program, &encoded_length, sizeof(encoded_length));
+	if (sizeof_word(tracee) == sizeof(uint32_t)) {
+		uint32_t pointer = (uint32_t) memory;
+		memcpy(remote_program + 4, &pointer, sizeof(pointer));
+	}
+	else {
+		uint64_t pointer = (uint64_t) memory;
+		memcpy(remote_program + 8, &pointer, sizeof(pointer));
+	}
+	status = write_data(tracee, memory + program_offset, remote_program,
+		sizeof(remote_program));
+	if (status < 0)
+		goto unmap;
+	status = execute_remote_syscall(tracee, PR_prctl, PR_SET_SECCOMP,
+		SECCOMP_MODE_FILTER, memory + program_offset, 0, 0, 0, &result);
+	if (status == 0 && (long) result < 0)
+		status = (int) (long) result;
+	if (status == 0)
+		config->io_filtered_fds[config->io_filtered_fd_count++] = managed_fd;
+unmap:
+	(void) execute_remote_syscall(tracee, PR_munmap, memory, 8192,
+		0, 0, 0, 0, NULL);
+	return status;
+#else
+	(void) tracee;
+	(void) config;
+	(void) managed_fd;
+	return -EOPNOTSUPP;
+#endif
+}
+
+static int install_block_lifecycle_filter(Tracee *tracee,
+	KfBlockConfig *config)
+{
+#if defined(HAVE_SECCOMP_FILTER)
+	SeccompArch architectures[] = SECCOMP_ARCHS;
