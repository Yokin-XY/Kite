diff --git a/src/extension/kf_block_store/kf_block_store.c b/src/extension/kf_block_store/kf_block_store.c
new file mode 100644
index 0000000..4f82450
--- /dev/null
+++ b/src/extension/kf_block_store/kf_block_store.c
@@ -0,0 +1,888 @@
+/* -*- c-set-style: "K&R"; c-basic-offset: 8 -*-
+ *
+ * Sparse, block-addressed change storage for a read-only Base file.  The
+ * delta has the same logical offsets as Base so changed blocks can be mapped
+ * directly, but holes consume no data blocks.  Two checksummed metadata slots
+ * make a committed bitmap survive process death without scanning Base.
+ */
+
+#include "extension/kf_block_store/kf_block_store.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <talloc.h>
+#include <unistd.h>
+
+#define KF_BLOCK_META_MAGIC UINT64_C(0x4b46424c4f434b32)
+#define KF_BLOCK_META_VERSION 1U
+#define KF_BLOCK_META_HEADER_SIZE 64U
+#define KF_BLOCK_META_ALIGNMENT 4096U
+
+typedef struct {
+	uint64_t magic;
+	uint32_t version;
+	uint32_t block_size;
+	uint64_t generation;
+	uint64_t base_size;
+	uint64_t visible_size;
+	uint64_t base_cutoff;
+	uint64_t bitmap_bytes;
+	uint64_t checksum;
+} KfBlockMetaHeader;
+
+struct kf_block_store {
+	char delta_path[PATH_MAX];
+	char meta_path[PATH_MAX];
+	KfBlockStore *source_store;
+	int base_fd;
+	int delta_fd;
+	int meta_fd;
+	size_t block_size;
+	off_t base_size;
+	off_t visible_size;
+	off_t base_cutoff;
+	size_t block_count;
+	size_t bitmap_bytes;
+	size_t changed_blocks;
+	size_t meta_slot_size;
+	uint8_t *bitmap;
+	uint8_t *block_buffer;
+	uint64_t generation;
+	unsigned int active_slot;
+	bool metadata_dirty;
+	bool meta_directory_dirty;
+};
+
+static uint64_t checksum_bytes(const void *data, size_t length)
+{
+	const uint8_t *bytes = data;
+	uint64_t hash = UINT64_C(1469598103934665603);
+	for (size_t index = 0; index < length; index++) {
+		hash ^= bytes[index];
+		hash *= UINT64_C(1099511628211);
+	}
+	return hash;
+}
+
+static size_t align_up(size_t value, size_t alignment)
+{
+	return (value + alignment - 1) & ~(alignment - 1);
+}
+
+static int full_pread(int fd, void *buffer, size_t length, off_t offset,
+	bool zero_at_eof)
+{
+	size_t done = 0;
+	while (done < length) {
+		ssize_t result = pread(fd, (uint8_t *) buffer + done,
+			length - done, offset + (off_t) done);
+		if (result < 0) {
+			if (errno == EINTR)
+				continue;
+			return -errno;
+		}
+		if (result == 0) {
+			if (!zero_at_eof)
+				return -EIO;
+			memset((uint8_t *) buffer + done, 0, length - done);
+			break;
+		}
+		done += (size_t) result;
+	}
+	return 0;
+}
+
+static int full_pwrite(int fd, const void *buffer, size_t length, off_t offset)
+{
+	size_t done = 0;
+	while (done < length) {
+		ssize_t result = pwrite(fd, (const uint8_t *) buffer + done,
+			length - done, offset + (off_t) done);
+		if (result < 0) {
+			if (errno == EINTR)
+				continue;
+			return -errno;
+		}
+		done += (size_t) result;
+	}
+	return 0;
+}
+
+static bool block_changed(const KfBlockStore *store, size_t block)
+{
+	return block < store->block_count &&
+		(store->bitmap[block / 8] & (uint8_t) (1U << (block % 8))) != 0;
+}
+
+static void set_block_changed(KfBlockStore *store, size_t block, bool changed)
+{
+	uint8_t mask = (uint8_t) (1U << (block % 8));
+	bool was_changed = (store->bitmap[block / 8] & mask) != 0;
+	if (was_changed == changed)
+		return;
+	if (changed)
+		store->bitmap[block / 8] |= mask;
+	else
+		store->bitmap[block / 8] &= (uint8_t) ~mask;
+	if (changed)
+		store->changed_blocks++;
+	else
+		store->changed_blocks--;
+	store->metadata_dirty = true;
+}
+
+static int read_visible_block(KfBlockStore *store, size_t block, void *buffer)
+{
+	off_t offset = (off_t) block * (off_t) store->block_size;
+	size_t length = store->block_size;
+	int status;
+	memset(buffer, 0, length);
+	if (block_changed(store, block))
+		return full_pread(store->delta_fd, buffer, length, offset, true);
+	if (offset >= store->base_cutoff)
+		return 0;
+	if (offset + (off_t) length > store->base_cutoff)
+		length = (size_t) (store->base_cutoff - offset);
+	if (store->source_store != NULL) {
+		size_t completed = 0;
+		status = kf_block_store_read(store->source_store, buffer, length,
+			offset, &completed);
+		if (status == 0 && completed < length)
+			memset((uint8_t *) buffer + completed, 0, length - completed);
+	}
+	else
+		status = full_pread(store->base_fd, buffer, length, offset, true);
+	return status;
+}
+
+static int write_meta_slot_to_fd(const KfBlockStore *store, int fd,
+	size_t slot_size, const uint8_t *bitmap, size_t bitmap_bytes,
+	unsigned int slot, uint64_t generation)
+{
+	uint8_t *record = calloc(1, slot_size);
+	KfBlockMetaHeader *header;
+	int status;
+	if (record == NULL)
+		return -ENOMEM;
+	header = (KfBlockMetaHeader *) record;
+	header->magic = KF_BLOCK_META_MAGIC;
+	header->version = KF_BLOCK_META_VERSION;
+	header->block_size = (uint32_t) store->block_size;
+	header->generation = generation;
+	header->base_size = (uint64_t) store->base_size;
+	header->visible_size = (uint64_t) store->visible_size;
+	header->base_cutoff = (uint64_t) store->base_cutoff;
+	header->bitmap_bytes = (uint64_t) bitmap_bytes;
+	memcpy(record + KF_BLOCK_META_HEADER_SIZE, bitmap, bitmap_bytes);
+	header->checksum = 0;
+	header->checksum = checksum_bytes(record,
+		KF_BLOCK_META_HEADER_SIZE + bitmap_bytes);
+	status = full_pwrite(fd, record, slot_size,
+		(off_t) slot * (off_t) slot_size);
+	free(record);
+	if (status < 0)
+		return status;
+	return fdatasync(fd) == 0 ? 0 : -errno;
+}
+
+static int write_meta_slot(KfBlockStore *store, unsigned int slot,
+	uint64_t generation)
+{
+	return write_meta_slot_to_fd(store, store->meta_fd,
+		store->meta_slot_size, store->bitmap, store->bitmap_bytes,
+		slot, generation);
+}
+
+static int sync_parent_directory(const char *path);
+
+static int commit_metadata(KfBlockStore *store)
+{
+	unsigned int slot;
+	int status;
+	if (!store->metadata_dirty) {
+		if (!store->meta_directory_dirty)
+			return 0;
+		status = sync_parent_directory(store->meta_path);
+		if (status == 0)
+			store->meta_directory_dirty = false;
+		return status;
+	}
+	slot = store->active_slot ^ 1U;
+	status = write_meta_slot(store, slot, store->generation + 1);
+	if (status < 0)
+		return status;
+	store->generation++;
+	store->active_slot = slot;
+	store->metadata_dirty = false;
+	return 0;
+}
+
+static int sync_parent_directory(const char *path)
+{
+	char directory[PATH_MAX];
+	char *separator;
+	int fd;
+	int status;
+	if (strlen(path) >= sizeof(directory))
+		return -ENAMETOOLONG;
+	strcpy(directory, path);
+	separator = strrchr(directory, '/');
+	if (separator == NULL)
+		strcpy(directory, ".");
+	else if (separator == directory)
+		directory[1] = '\0';
+	else
+		*separator = '\0';
+	fd = open(directory, O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+	if (fd < 0)
+		return -errno;
+	status = fsync(fd) == 0 ? 0 : -errno;
+	close(fd);
+	return status;
+}
+
+static int refresh_meta_path(KfBlockStore *store, bool *linked)
+{
+	char descriptor_path[64];
+	char resolved[PATH_MAX + 32];
+	static const char deleted_suffix[] = " (deleted)";
+	ssize_t length;
+	if (snprintf(descriptor_path, sizeof(descriptor_path), "/proc/self/fd/%d",
+		store->meta_fd) >= (int) sizeof(descriptor_path))
+		return -ENAMETOOLONG;
+	length = readlink(descriptor_path, resolved, sizeof(resolved) - 1);
+	if (length < 0)
+		return -errno;
+	resolved[length] = '\0';
+	if ((size_t) length >= sizeof(deleted_suffix) - 1 &&
+		strcmp(resolved + length - (sizeof(deleted_suffix) - 1),
+			deleted_suffix) == 0) {
+		*linked = false;
+		return 0;
+	}
+	if (resolved[0] != '/' || length >= PATH_MAX)
+		return -EPROTO;
+	strcpy(store->meta_path, resolved);
+	*linked = true;
+	return 0;
+}
+
+static int grow_metadata_capacity(KfBlockStore *store,
+	size_t required_blocks)
+{
+	size_t required_bitmap;
+	size_t new_slot_size;
+	size_t new_bitmap_bytes;
+	uint8_t *new_bitmap;
+	char temporary_path[PATH_MAX] = "";
+	int temporary_fd = -1;
+	int status;
+	int old_meta_fd;
+	uint64_t generation;
+	bool metadata_linked;
+	if (required_blocks <= store->block_count) {
+		if (!store->meta_directory_dirty)
+			return 0;
+		status = sync_parent_directory(store->meta_path);
+		if (status == 0)
+			store->meta_directory_dirty = false;
+		return status;
+	}
+	if (required_blocks > SIZE_MAX - 7)
+		return -EFBIG;
+	required_bitmap = (required_blocks + 7) / 8;
+	if (required_bitmap > SIZE_MAX - KF_BLOCK_META_HEADER_SIZE)
+		return -EFBIG;
+	new_slot_size = store->meta_slot_size;
+	while (new_slot_size - KF_BLOCK_META_HEADER_SIZE < required_bitmap) {
+		if (new_slot_size > SIZE_MAX / 2 ||
+			(uint64_t) new_slot_size * 4 > INT64_MAX)
+			return -EFBIG;
+		new_slot_size *= 2;
+	}
+	new_bitmap_bytes = new_slot_size - KF_BLOCK_META_HEADER_SIZE;
+	new_bitmap = talloc_zero_size(store, new_bitmap_bytes);
+	if (new_bitmap == NULL)
+		return -ENOMEM;
+	memcpy(new_bitmap, store->bitmap, store->bitmap_bytes);
+	status = refresh_meta_path(store, &metadata_linked);
+	if (status < 0)
+		goto failed;
+	if (snprintf(temporary_path, sizeof(temporary_path), "%s.grow.XXXXXX",
+		store->meta_path) >= (int) sizeof(temporary_path)) {
+		talloc_free(new_bitmap);
+		return -ENAMETOOLONG;
+	}
+	temporary_fd = mkstemp(temporary_path);
+	if (temporary_fd < 0) {
+		status = -errno;
+		goto failed;
+	}
+	if (!metadata_linked && unlink(temporary_path) != 0) {
+		status = -errno;
+		goto failed;
+	}
+	if (fcntl(temporary_fd, F_SETFD, FD_CLOEXEC) != 0 ||
+		fchmod(temporary_fd, 0600) != 0 ||
+		ftruncate(temporary_fd, (off_t) (new_slot_size * 2)) != 0) {
+		status = -errno;
+		goto failed;
+	}
+	generation = store->generation + 1;
+	status = write_meta_slot_to_fd(store, temporary_fd, new_slot_size,
+		new_bitmap, new_bitmap_bytes, 0, generation);
+	if (status < 0)
+		goto failed;
+	status = write_meta_slot_to_fd(store, temporary_fd, new_slot_size,
+		new_bitmap, new_bitmap_bytes, 1, generation);
+	if (status < 0)
+		goto failed;
+	if (metadata_linked) {
+		if (rename(temporary_path, store->meta_path) != 0) {
+			status = -errno;
+			goto failed;
+		}
+		status = sync_parent_directory(store->meta_path);
+	}
+	else
+		status = 0;
+	old_meta_fd = store->meta_fd;
+	store->meta_fd = temporary_fd;
+	temporary_fd = -1;
+	talloc_free(store->bitmap);
+	store->bitmap = new_bitmap;
+	store->meta_slot_size = new_slot_size;
+	store->bitmap_bytes = new_bitmap_bytes;
+	store->block_count = new_bitmap_bytes * 8;
+	store->generation = generation;
+	store->active_slot = 0;
+	store->metadata_dirty = false;
+	store->meta_directory_dirty = metadata_linked && status < 0;
+	close(old_meta_fd);
+	return status;
+
+failed:
+	if (temporary_fd >= 0)
+		close(temporary_fd);
+	if (temporary_path[0] != '\0')
+		unlink(temporary_path);
+	talloc_free(new_bitmap);
+	return status;
+}
+
+static int ensure_size_capacity(KfBlockStore *store, off_t size)
+{
+	uint64_t unsigned_size;
+	uint64_t blocks;
+	if (size < 0)
+		return -EINVAL;
+	unsigned_size = (uint64_t) size;
+	blocks = unsigned_size / store->block_size;
+	if (unsigned_size % store->block_size != 0)
+		blocks++;
+	if (blocks > SIZE_MAX)
+		return -EFBIG;
+	return grow_metadata_capacity(store, (size_t) blocks);
+}
+
+static bool valid_meta_slot(const KfBlockStore *store, const uint8_t *record,
+	KfBlockMetaHeader *header_out)
+{
+	KfBlockMetaHeader header;
+	uint64_t visible_blocks;
+	uint64_t base_blocks;
+	uint8_t *copy;
+	uint64_t expected;
+	memcpy(&header, record, sizeof(header));
+	if (header.magic != KF_BLOCK_META_MAGIC ||
+		header.version != KF_BLOCK_META_VERSION ||
+		header.block_size != store->block_size ||
+		header.base_size != (uint64_t) store->base_size ||
+		header.bitmap_bytes != store->bitmap_bytes ||
+		header.visible_size > INT64_MAX || header.base_cutoff > header.base_size)
+		return false;
+	visible_blocks = header.visible_size / store->block_size;
+	if (header.visible_size % store->block_size != 0)
+		visible_blocks++;
+	base_blocks = header.base_size / store->block_size;
+	if (header.base_size % store->block_size != 0)
+		base_blocks++;
+	if (visible_blocks > store->block_count ||
+		base_blocks > store->block_count)
+		return false;
+	copy = malloc(KF_BLOCK_META_HEADER_SIZE + store->bitmap_bytes);
+	if (copy == NULL)
+		return false;
+	memcpy(copy, record, KF_BLOCK_META_HEADER_SIZE + store->bitmap_bytes);
+	expected = ((KfBlockMetaHeader *) copy)->checksum;
+	((KfBlockMetaHeader *) copy)->checksum = 0;
+	expected = expected == checksum_bytes(copy,
+		KF_BLOCK_META_HEADER_SIZE + store->bitmap_bytes) ? expected : 0;
+	free(copy);
+	if (expected == 0)
+		return false;
+	*header_out = header;
+	return true;
+}
+
+static int load_or_initialize_metadata(KfBlockStore *store)
+{
+	uint8_t *slots[2] = { NULL, NULL };
+	KfBlockMetaHeader headers[2];
+	bool valid[2] = { false, false };
+	struct stat stat;
+	int selected = -1;
+	int status = 0;
+	if (fstat(store->meta_fd, &stat) != 0)
+		return -errno;
+	if (stat.st_size != 0) {
+		off_t existing_slot_size = stat.st_size / 2;
+		uint8_t *resized_bitmap;
+		if (existing_slot_size < KF_BLOCK_META_ALIGNMENT ||
+			existing_slot_size % KF_BLOCK_META_ALIGNMENT != 0 ||
+			existing_slot_size * 2 != stat.st_size ||
+			(uint64_t) existing_slot_size > SIZE_MAX) {
+			status = -EBADMSG;
+			goto done;
+		}
+		if ((size_t) existing_slot_size != store->meta_slot_size) {
+			size_t resized_bytes = (size_t) existing_slot_size -
+				KF_BLOCK_META_HEADER_SIZE;
+			resized_bitmap = talloc_zero_size(store, resized_bytes);
+			if (resized_bitmap == NULL) {
+				status = -ENOMEM;
+				goto done;
+			}
+			talloc_free(store->bitmap);
+			store->bitmap = resized_bitmap;
+			store->meta_slot_size = (size_t) existing_slot_size;
+			store->bitmap_bytes = resized_bytes;
+			store->block_count = resized_bytes * 8;
+		}
+	}
+	if (stat.st_size >= (off_t) (store->meta_slot_size * 2)) {
+		for (unsigned int slot = 0; slot < 2; slot++) {
+			slots[slot] = malloc(store->meta_slot_size);
+			if (slots[slot] == NULL) {
+				status = -ENOMEM;
+				goto done;
+			}
+			status = full_pread(store->meta_fd, slots[slot],
+				store->meta_slot_size,
+				(off_t) slot * (off_t) store->meta_slot_size, false);
+			if (status < 0)
+				goto done;
+			valid[slot] = valid_meta_slot(store, slots[slot], &headers[slot]);
+		}
+		if (valid[0] && valid[1])
+			selected = headers[1].generation > headers[0].generation ? 1 : 0;
+		else if (valid[0])
+			selected = 0;
+		else if (valid[1])
+			selected = 1;
+	}
+	if (selected >= 0) {
+		memcpy(store->bitmap, slots[selected] + KF_BLOCK_META_HEADER_SIZE,
+			store->bitmap_bytes);
+		store->changed_blocks = 0;
+		for (size_t block = 0; block < store->block_count; block++)
+			if (block_changed(store, block))
+				store->changed_blocks++;
+		store->visible_size = (off_t) headers[selected].visible_size;
+		store->base_cutoff = (off_t) headers[selected].base_cutoff;
+		store->generation = headers[selected].generation;
+		store->active_slot = (unsigned int) selected;
+		goto done;
+	}
+	if (stat.st_size != 0) {
+		status = -EBADMSG;
+		goto done;
+	}
+	if (ftruncate(store->meta_fd, (off_t) (store->meta_slot_size * 2)) != 0) {
+		status = -errno;
+		goto done;
+	}
+	store->visible_size = store->base_size;
+	store->base_cutoff = store->base_size;
+	store->generation = 0;
+	store->active_slot = 1;
+	store->metadata_dirty = true;
+	status = commit_metadata(store);
+
+done:
+	free(slots[0]);
+	free(slots[1]);
+	return status;
+}
+
+static int destroy_store(KfBlockStore *store)
+{
+	if (store->base_fd >= 0)
+		close(store->base_fd);
+	if (store->delta_fd >= 0)
+		close(store->delta_fd);
+	if (store->meta_fd >= 0)
+		close(store->meta_fd);
+	return 0;
+}
+
+static int open_store(void *context, const char *base_path,
+	KfBlockStore *source, const char *delta_path, const char *meta_path,
+	size_t block_size, KfBlockStore **output)
+{
+	KfBlockStore *store;
+	struct stat base_stat;
+	KfBlockStoreStats source_stats;
+	int status;
+	if ((base_path == NULL) == (source == NULL) || delta_path == NULL ||
+		meta_path == NULL ||
+		output == NULL || block_size == 0 ||
+		(block_size & (block_size - 1)) != 0 ||
+		strlen(delta_path) >= PATH_MAX || strlen(meta_path) >= PATH_MAX)
+		return -EINVAL;
+	store = talloc_zero(context, KfBlockStore);
+	if (store == NULL)
+		return -ENOMEM;
+	store->base_fd = -1;
+	store->delta_fd = -1;
+	store->meta_fd = -1;
+	store->block_size = block_size;
+	store->source_store = source;
+	strcpy(store->delta_path, delta_path);
+	strcpy(store->meta_path, meta_path);
+	if (source == NULL)
+		store->base_fd = open(base_path, O_RDONLY | O_CLOEXEC);
+	store->delta_fd = open(delta_path, O_RDWR | O_CREAT | O_CLOEXEC, 0600);
+	store->meta_fd = open(meta_path, O_RDWR | O_CREAT | O_CLOEXEC, 0600);
+	if ((source == NULL && store->base_fd < 0) || store->delta_fd < 0 ||
+		store->meta_fd < 0) {
+		status = -errno;
+		talloc_free(store);
+		return status;
+	}
+	if (source != NULL) {
+		kf_block_store_stats(source, &source_stats);
+		store->base_size = source_stats.visible_size;
+	}
+	else {
+		if (fstat(store->base_fd, &base_stat) != 0) {
+			status = -errno;
+			talloc_free(store);
+			return status;
+		}
+		store->base_size = base_stat.st_size;
+	}
+	uint64_t base_size = (uint64_t) store->base_size;
+	uint64_t source_blocks = base_size / block_size;
+	if (base_size % block_size != 0)
+		source_blocks++;
+	if (source_blocks > SIZE_MAX) {
+		talloc_free(store);
+		return -EFBIG;
+	}
+	size_t source_block_count = (size_t) source_blocks;
+	size_t source_bitmap_bytes = (source_block_count + 7) / 8;
+	store->meta_slot_size = align_up(KF_BLOCK_META_HEADER_SIZE +
+		source_bitmap_bytes, KF_BLOCK_META_ALIGNMENT);
+	store->bitmap_bytes = store->meta_slot_size - KF_BLOCK_META_HEADER_SIZE;
+	store->block_count = store->bitmap_bytes * 8;
+	store->bitmap = talloc_zero_size(store,
+		store->bitmap_bytes == 0 ? 1 : store->bitmap_bytes);
+	store->block_buffer = talloc_size(store, block_size);
+	if (store->bitmap == NULL || store->block_buffer == NULL) {
+		talloc_free(store);
+		return -ENOMEM;
+	}
+	talloc_set_destructor(store, destroy_store);
+	struct stat delta_stat;
+	if (fstat(store->delta_fd, &delta_stat) != 0) {
+		status = -errno;
+		talloc_free(store);
+		return status;
+	}
+	if (delta_stat.st_size < store->base_size &&
+		ftruncate(store->delta_fd, store->base_size) != 0) {
+		status = -errno;
+		talloc_free(store);
+		return status;
+	}
+	status = load_or_initialize_metadata(store);
+	if (status < 0) {
+		talloc_free(store);
+		return status;
+	}
+	*output = store;
+	return 0;
+}
+
+int kf_block_store_open(void *context, const char *base_path,
+	const char *delta_path, const char *meta_path, size_t block_size,
+	KfBlockStore **output)
+{
+	return open_store(context, base_path, NULL, delta_path, meta_path,
+		block_size, output);
+}
+
+int kf_block_store_open_layered(void *context, KfBlockStore *source,
+	const char *delta_path, const char *meta_path, size_t block_size,
+	KfBlockStore **output)
+{
+	return open_store(context, NULL, source, delta_path, meta_path,
+		block_size, output);
+}
+
+int kf_block_store_read(KfBlockStore *store, void *buffer, size_t length,
+	off_t offset, size_t *completed)
+{
+	size_t total;
+	if (store == NULL || buffer == NULL || completed == NULL || offset < 0)
+		return -EINVAL;
+	*completed = 0;
+	if (offset >= store->visible_size || length == 0)
+		return 0;
+	total = length;
+	if ((off_t) total > store->visible_size - offset)
+		total = (size_t) (store->visible_size - offset);
+	memset(buffer, 0, total);
+	if (offset < store->base_cutoff) {
+		size_t base_length = total;
+		if ((off_t) base_length > store->base_cutoff - offset)
+			base_length = (size_t) (store->base_cutoff - offset);
+		int status;
+		if (store->source_store != NULL) {
+			size_t completed = 0;
+			status = kf_block_store_read(store->source_store, buffer,
+				base_length, offset, &completed);
+			if (status == 0 && completed < base_length)
+				memset((uint8_t *) buffer + completed, 0,
+					base_length - completed);
+		}
+		else
+			status = full_pread(store->base_fd, buffer, base_length,
+				offset, true);
+		if (status < 0)
+			return status;
+	}
+	if (total > 0) {
+		size_t first = (size_t) (offset / (off_t) store->block_size);
+		size_t last = (size_t) ((offset + (off_t) total - 1) /
+			(off_t) store->block_size);
+		for (size_t block = first; block <= last; block++) {
+			off_t block_start;
+			off_t copy_start;
+			off_t copy_end;
+			int status;
+			if (!block_changed(store, block))
+				continue;
+			block_start = (off_t) block * (off_t) store->block_size;
+			copy_start = offset > block_start ? offset : block_start;
+			copy_end = offset + (off_t) total;
+			if (copy_end > block_start + (off_t) store->block_size)
+				copy_end = block_start + (off_t) store->block_size;
+			status = full_pread(store->delta_fd,
+				(uint8_t *) buffer + (size_t) (copy_start - offset),
+				(size_t) (copy_end - copy_start), copy_start, true);
+			if (status < 0)
+				return status;
+		}
+	}
+	*completed = total;
+	return 0;
+}
+
+int kf_block_store_ensure_block(KfBlockStore *store, size_t block)
+{
+	off_t offset;
+	int status;
+	if (store == NULL)
+		return -EINVAL;
+	if (block == SIZE_MAX)
+		return -EFBIG;
+	status = grow_metadata_capacity(store, block + 1);
+	if (status < 0)
+		return status;
+	if (block_changed(store, block))
+		return 0;
+	offset = (off_t) block * (off_t) store->block_size;
+	status = read_visible_block(store, block, store->block_buffer);
+	if (status < 0)
+		return status;
+	status = full_pwrite(store->delta_fd, store->block_buffer,
+		store->block_size, offset);
+	if (status < 0)
+		return status;
+	if (fdatasync(store->delta_fd) != 0)
+		return -errno;
+	set_block_changed(store, block, true);
+	return commit_metadata(store);
+}
+
+int kf_block_store_write(KfBlockStore *store, const void *buffer,
+	size_t length, off_t offset, size_t *completed)
+{
+	size_t first;
+	size_t last;
+	int status;
+	if (store == NULL || buffer == NULL || completed == NULL || offset < 0)
+		return -EINVAL;
+	*completed = 0;
+	if (length == 0)
+		return 0;
+	if (length > (size_t) INT64_MAX ||
+		offset > INT64_MAX - (off_t) length)
+		return -EFBIG;
+	status = ensure_size_capacity(store, offset + (off_t) length);
+	if (status < 0)
+		return status;
+	first = (size_t) (offset / (off_t) store->block_size);
+	last = (size_t) ((offset + (off_t) length - 1) /
+		(off_t) store->block_size);
+	for (size_t block = first; block <= last; block++) {
+		off_t block_start = (off_t) block * (off_t) store->block_size;
+		off_t copy_start = offset > block_start ? offset : block_start;
+		off_t copy_end = offset + (off_t) length;
+		if (copy_end > block_start + (off_t) store->block_size)
+			copy_end = block_start + (off_t) store->block_size;
+		status = kf_block_store_ensure_block(store, block);
+		if (status < 0)
+			return status;
+		status = full_pwrite(store->delta_fd,
+			(const uint8_t *) buffer + (size_t) (copy_start - offset),
+			(size_t) (copy_end - copy_start), copy_start);
+		if (status < 0)
+			return status;
+	}
+	if (fdatasync(store->delta_fd) != 0)
+		return -errno;
+	if (offset + (off_t) length > store->visible_size) {
+		store->visible_size = offset + (off_t) length;
+		store->metadata_dirty = true;
+		status = commit_metadata(store);
+		if (status < 0)
+			return status;
+	}
+	*completed = length;
+	return 0;
+}
+
+int kf_block_store_truncate(KfBlockStore *store, off_t size)
+{
+	size_t first_removed;
+	int status = 0;
+	if (store == NULL || size < 0)
+		return -EINVAL;
+	status = ensure_size_capacity(store, size);
+	if (status < 0)
+		return status;
+	if (size < store->visible_size) {
+		first_removed = (size_t) ((size + (off_t) store->block_size - 1) /
+			(off_t) store->block_size);
+		for (size_t block = first_removed; block < store->block_count; block++)
+			set_block_changed(store, block, false);
+		if (size % (off_t) store->block_size != 0 &&
+			(size_t) (size / (off_t) store->block_size) < store->block_count) {
+			size_t boundary = (size_t) (size / (off_t) store->block_size);
+			status = kf_block_store_ensure_block(store, boundary);
+			if (status < 0)
+				return status;
+			memset(store->block_buffer, 0, store->block_size);
+			status = full_pwrite(store->delta_fd, store->block_buffer,
+				store->block_size - (size_t) (size %
+				(off_t) store->block_size), size);
+			if (status < 0)
+				return status;
+		}
+		if (size < store->base_cutoff)
+			store->base_cutoff = size;
+	}
+	store->visible_size = size;
+	store->metadata_dirty = true;
+	if (fdatasync(store->delta_fd) != 0)
+		return -errno;
+	return commit_metadata(store);
+}
+
+int kf_block_store_sync(KfBlockStore *store)
+{
+	int status;
+	if (store == NULL)
+		return -EINVAL;
+	if (fdatasync(store->delta_fd) != 0)
+		return -errno;
+	status = commit_metadata(store);
+	return status;
+}
+
+bool kf_block_store_block_changed(const KfBlockStore *store, size_t block)
+{
+	return store != NULL && block_changed(store, block);
+}
+
+int kf_block_store_block_range(const KfBlockStore *store, size_t block,
+	off_t *offset, size_t *length)
+{
+	if (store == NULL || offset == NULL || length == NULL ||
+		block >= store->block_count)
+		return -EINVAL;
+	*offset = (off_t) block * (off_t) store->block_size;
+	*length = store->block_size;
+	return 0;
+}
+
+int kf_block_store_rebind_paths(KfBlockStore *store, const char *delta_path,
+	const char *meta_path)
+{
+	if (store == NULL || delta_path == NULL || meta_path == NULL)
+		return -EINVAL;
+	if (strlen(delta_path) >= sizeof(store->delta_path) ||
+		strlen(meta_path) >= sizeof(store->meta_path))
+		return -ENAMETOOLONG;
+	strcpy(store->delta_path, delta_path);
+	strcpy(store->meta_path, meta_path);
+	return 0;
+}
+
+int kf_block_store_delta_fd(const KfBlockStore *store)
+{
+	return store == NULL ? -1 : store->delta_fd;
+}
+
+int kf_block_store_delta_stat(const KfBlockStore *store, struct stat *statl)
+{
+	if (store == NULL || statl == NULL)
+		return -EINVAL;
+	return fstat(store->delta_fd, statl) == 0 ? 0 : -errno;
+}
+
+int kf_block_store_meta_stat(const KfBlockStore *store, struct stat *statl)
+{
+	if (store == NULL || statl == NULL)
+		return -EINVAL;
+	return fstat(store->meta_fd, statl) == 0 ? 0 : -errno;
+}
+
+const char *kf_block_store_delta_path(const KfBlockStore *store)
+{
+	return store == NULL ? NULL : store->delta_path;
+}
+
+void kf_block_store_stats(const KfBlockStore *store,
+	KfBlockStoreStats *stats)
+{
+	memset(stats, 0, sizeof(*stats));
+	if (store == NULL)
+		return;
+	stats->block_size = store->block_size;
+	stats->base_size = store->base_size;
+	stats->visible_size = store->visible_size;
+	stats->base_cutoff = store->base_cutoff;
+	stats->changed_blocks = store->changed_blocks;
+	stats->generation = store->generation;
+}
