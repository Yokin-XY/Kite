+			goto restore;
+		}
+		if (waitpid(tracee->pid, &wait_status, __WALL) < 0) {
+			status = -errno;
+			goto restore;
+		}
+		if (WIFSTOPPED(wait_status) && WSTOPSIG(wait_status) == SIGILL)
+			break;
+		if (!WIFSTOPPED(wait_status) || WSTOPSIG(wait_status) != SIGTRAP) {
+			status = -EFAULT;
+			goto restore;
+		}
