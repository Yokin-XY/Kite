+/* PRoot normally presents HOST_PATH as a canonical host path, but directory
+ * traversal helpers such as coreutils mkdir -p can still leave lexical dot
+ * components (for example, an Upper directory followed by "/.").  View
+ * indexes use normalized relative keys, so looking up the unnormalized path
+ * would miss a directory created moments earlier and incorrectly fall back to
+ * the immutable Base.  Normalize lexically without following symlinks; PRoot
+ * has already performed guest-to-host symlink resolution at this stage. */
+static int normalize_absolute_path(const char *input, char output[PATH_MAX])
+{
+	const char *cursor;
+	size_t output_length = 1;
+
+	if (input == NULL || input[0] != '/')
+		return -EINVAL;
+	output[0] = '/';
+	output[1] = '\0';
+	cursor = input;
+	while (*cursor != '\0') {
+		const char *segment;
+		size_t segment_length;
+		while (*cursor == '/')
+			cursor++;
+		if (*cursor == '\0')
+			break;
+		segment = cursor;
+		while (*cursor != '\0' && *cursor != '/')
+			cursor++;
+		segment_length = (size_t) (cursor - segment);
+		if (segment_length == 1 && segment[0] == '.')
+			continue;
+		if (segment_length == 2 && segment[0] == '.' && segment[1] == '.') {
+			if (output_length == 1)
+				continue;
+			while (output_length > 1 && output[output_length - 1] != '/')
+				output_length--;
+			if (output_length > 1)
+				output_length--;
+			output[output_length] = '\0';
+			continue;
+		}
+		if (output_length > 1) {
+			if (output_length + 1 >= PATH_MAX)
+				return -ENAMETOOLONG;
+			output[output_length++] = '/';
+		}
+		if (segment_length >= PATH_MAX - output_length)
+			return -ENAMETOOLONG;
+		memcpy(output + output_length, segment, segment_length);
+		output_length += segment_length;
+		output[output_length] = '\0';
+	}
+	return 0;
+}
