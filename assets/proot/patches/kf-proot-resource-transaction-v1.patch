+static bool path_inside_root(const char *root, const char *path, const char **relative)
+{
+	size_t length = strlen(root);
+	if (strcmp(root, path) == 0) {
+		*relative = ".";
+		return true;
+	}
+	if (strncmp(root, path, length) != 0 || path[length] != '/')
+		return false;
+	*relative = path + length + 1;
+	return **relative != '\0';
+}
