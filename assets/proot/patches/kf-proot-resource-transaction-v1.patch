+static int read_control(const char *path, KfTxnControl *control)
+{
+	FILE *file;
+	char buffer[KF_TXN_CONTROL_MAX];
+	size_t size;
+	char *line;
+	char *save = NULL;
+	bool schema = false;
+	bool generation = false;
+	bool root = false;
+	bool entries = false;
+	bool max_bytes = false;
+
+	file = fopen(path, "r");
+	if (file == NULL)
+		return errno == ENOENT ? 0 : -errno;
+
+	size = fread(buffer, 1, sizeof(buffer) - 1, file);
+	if (ferror(file)) {
+		int error = errno;
+		fclose(file);
+		return -error;
+	}
+	if (!feof(file)) {
+		fclose(file);
+		return -E2BIG;
+	}
+	fclose(file);
+	buffer[size] = '\0';
+	memset(control, 0, sizeof(*control));
+
+	for (line = strtok_r(buffer, "\n", &save); line != NULL;
+		line = strtok_r(NULL, "\n", &save)) {
+		char *separator = strchr(line, '=');
+		char *value;
+		char *end = NULL;
+		if (separator == NULL || separator == line)
+			return -EPROTO;
+		*separator = '\0';
+		value = separator + 1;
+		if (strcmp(line, "schema") == 0) {
+			schema = strcmp(value, KF_TXN_CONTROL_SCHEMA) == 0;
+		}
+		else if (strcmp(line, "generation") == 0) {
+			errno = 0;
+			control->generation = strtoull(value, &end, 10);
+			generation = errno == 0 && end != value && *end == '\0' && control->generation > 0;
+		}
+		else if (strcmp(line, "root_path") == 0) {
+			if (strlen(value) >= sizeof(control->root_path))
+				return -ENAMETOOLONG;
+			strcpy(control->root_path, value);
+			root = true;
+		}
+		else if (strcmp(line, "entries_path") == 0) {
+			if (strlen(value) >= sizeof(control->entries_path))
+				return -ENAMETOOLONG;
+			strcpy(control->entries_path, value);
+			entries = true;
+		}
+		else if (strcmp(line, "max_backup_bytes") == 0) {
+			errno = 0;
+			control->max_backup_bytes = strtoull(value, &end, 10);
+			max_bytes = errno == 0 && end != value && *end == '\0' &&
+				control->max_backup_bytes > 0;
+		}
+	}
+
+	if (!schema || !generation || !root || !entries || !max_bytes)
+		return -EPROTO;
+	trim_trailing_slash(control->root_path);
+	trim_trailing_slash(control->entries_path);
+	if (!safe_absolute_path(control->root_path) ||
+		!safe_absolute_path(control->entries_path) ||
+		strcmp(control->root_path, control->entries_path) == 0)
+		return -EPROTO;
+	return 1;
+}
