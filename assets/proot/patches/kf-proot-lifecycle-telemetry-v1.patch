+/* -*- c-set-style: "K&R"; c-basic-offset: 8 -*- */
+
+#ifndef TRACEE_TELEMETRY_H
+#define TRACEE_TELEMETRY_H
+
+#include <sched.h>
+#include <signal.h>
+#include "tracee/tracee.h"
+
+extern void kf_telemetry_capture_exec_argv(Tracee *tracee);
+extern void kf_telemetry_emit_lifecycle_event(const Tracee *tracee,
+					const char *event_type,
+					const char *state,
+					const char *source_hook,
+					const char *executable,
+					const char *argv_hash,
+					const char *argv_preview,
+					const char *cwd,
+					int exit_code,
+					int signal_number);
+
+static inline const char *kf_telemetry_fork_event_type(word_t clone_flags)
+{
+	if ((clone_flags & CLONE_VFORK) != 0)
+		return "VforkDetected";
+	if (clone_flags == 0 || (clone_flags & 0xff) == SIGCHLD)
+		return "ForkDetected";
+	return "CloneDetected";
+}
+
+#endif /* TRACEE_TELEMETRY_H */
