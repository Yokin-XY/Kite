+static int fd_info(Tracee *tracee, Reg fd_sysarg, uint64_t *position, uint64_t *flags)
+{
+	char path[PATH_MAX];
+	char line[256];
+	FILE *stream;
+	int fd = (int) peek_reg(tracee, CURRENT, fd_sysarg);
+	bool have_position = false;
+	bool have_flags = false;
+	*position = 0;
+	*flags = 0;
+	if (snprintf(path, sizeof(path), "/proc/%d/fdinfo/%d", tracee->pid, fd) >=
+		(int) sizeof(path))
+		return -ENAMETOOLONG;
+	stream = fopen(path, "r");
+	if (stream == NULL)
+		return -errno;
+	while (fgets(line, sizeof(line), stream) != NULL) {
+		if (!have_position && sscanf(line, "pos:\t%" SCNu64, position) == 1)
+			have_position = true;
+		if (!have_flags && sscanf(line, "flags:\t%" SCNo64, flags) == 1)
+			have_flags = true;
+	}
+	fclose(stream);
+	return have_position && have_flags ? 0 : -EPROTO;
+}
