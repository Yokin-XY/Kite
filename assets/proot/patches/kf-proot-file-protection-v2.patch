+static int capture_range_impl(KfTxnConfig *config, const KfTxnControl *control,
+	const char *path, uint64_t offset, uint64_t length)
+{
+	const char *relative;
+	uint64_t hash;
+	char entry_dir[PATH_MAX];
+	struct stat st;
+	int result;
+	if (!path_inside_root(control->root_path, path, &relative))
+		return 0;
+	if (lstat(path, &st) != 0 || !S_ISREG(st.st_mode))
+		return capture_path_impl(config, control, path);
+	hash = fnv1a64(relative);
+	if (snprintf(entry_dir, sizeof(entry_dir), "%s/%016" PRIx64,
+		control->entries_path, hash) >= (int) sizeof(entry_dir))
+		return -ENAMETOOLONG;
+	if (mkdir(entry_dir, 0700) != 0) {
+		bool is_range;
+		int64_t original_size;
+		if (errno != EEXIST)
+			return -errno;
+		result = existing_entry_is_range(entry_dir, relative, &is_range, &original_size);
+		if (result < 0 || !is_range)
+			return result;
+		return capture_range_blocks(config, control, path, entry_dir, offset, length,
+			(uint64_t) original_size);
+	}
+	result = write_meta(entry_dir, relative, "file", st.st_mode, "",
+		"range_undo", (int64_t) st.st_size, false);
+	if (result < 0)
+		goto fail;
+	result = capture_range_blocks(config, control, path, entry_dir, offset, length,
+		(uint64_t) st.st_size);
+	if (result < 0)
+		goto fail;
+	result = write_meta(entry_dir, relative, "file", st.st_mode, "",
+		"range_undo", (int64_t) st.st_size, true);
 	if (result < 0)
 		goto fail;
 	return 0;
@@ -732,6 +949,43 @@ fail:
 	return result;
 }
 
+static int capture_range(KfTxnConfig *config, const KfTxnControl *control,
+	const char *path, uint64_t offset, uint64_t length)
+{
+	const char *relative;
+	char normalized[PATH_MAX];
+	char lock_path[PATH_MAX];
+	int lock_fd;
+	int result;
+	if (path == NULL || path[0] != '/')
+		return 0;
+	result = normalize_absolute_path(path, normalized);
+	if (result < 0)
+		return result;
+	if (!path_inside_root(control->root_path, normalized, &relative))
+		return 0;
+	result = ensure_directory(control->entries_path);
+	if (result < 0)
+		return result;
+	if (snprintf(lock_path, sizeof(lock_path), "%s/.capture.lock",
+		control->entries_path) >= (int) sizeof(lock_path))
+		return -ENAMETOOLONG;
+	lock_fd = open(lock_path, O_RDWR | O_CREAT | O_CLOEXEC, 0600);
+	if (lock_fd < 0)
+		return -errno;
+	if (flock(lock_fd, LOCK_EX) != 0) {
+		result = -errno;
+		close(lock_fd);
+		return result;
+	}
+	result = measure_existing_payloads(control->entries_path, &config->used_bytes);
+	if (result == 0)
+		result = capture_range_impl(config, control, normalized, offset, length);
+	flock(lock_fd, LOCK_UN);
+	close(lock_fd);
+	return result;
+}
