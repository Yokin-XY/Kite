+static int iov_total_length(Tracee *tracee, Reg pointer_sysarg, Reg count_sysarg,
+	uint64_t *length)
+{
+	word_t pointer = peek_reg(tracee, CURRENT, pointer_sysarg);
+	word_t count = peek_reg(tracee, CURRENT, count_sysarg);
+	size_t word_size = sizeof_word(tracee);
+	word_t index;
+	*length = 0;
+	if (count > 1024)
+		return -E2BIG;
+	for (index = 0; index < count; index++) {
+		word_t item = pointer + index * word_size * 2;
+		word_t item_length;
+		errno = 0;
+		(void) peek_word(tracee, item);
+		if (errno != 0)
+			return -errno;
+		errno = 0;
+		item_length = peek_word(tracee, item + word_size);
+		if (errno != 0)
+			return -errno;
+		if ((uint64_t) item_length > UINT64_MAX - *length)
+			return -EOVERFLOW;
+		*length += (uint64_t) item_length;
+	}
+	return 0;
+}
+
+static int tracee_offset(Tracee *tracee, Reg pointer_sysarg, uint64_t fallback,
+	uint64_t *offset)
+{
+	word_t pointer = peek_reg(tracee, CURRENT, pointer_sysarg);
+	int64_t value;
+	if (pointer == 0) {
+		*offset = fallback;
+		return 0;
+	}
+	if (read_data(tracee, &value, pointer, sizeof(value)) < 0)
+		return -EFAULT;
+	if (value < 0)
+		return -EINVAL;
+	*offset = (uint64_t) value;
+	return 0;
+}
+
+static int capture_fd_range(Tracee *tracee, KfTxnConfig *config,
+	const KfTxnControl *control, Reg fd_sysarg, uint64_t requested_offset,
+	uint64_t length)
+{
+	char path[PATH_MAX];
+	struct stat st;
+	uint64_t position;
+	uint64_t flags;
+	uint64_t offset = requested_offset;
+	int status = fd_path(tracee, fd_sysarg, path);
+	if (status != 0)
+		return status < 0 ? status : 0;
+	status = fd_info(tracee, fd_sysarg, &position, &flags);
+	if (status < 0)
+		return status;
+	if ((flags & O_APPEND) != 0) {
+		if (lstat(path, &st) != 0)
+			return -errno;
+		offset = (uint64_t) st.st_size;
+	}
+	else if (offset == UINT64_MAX) {
+		offset = position;
+	}
+	return capture_range(config, control, path, offset, length);
+}
+
+static int capture_truncate_path(Tracee *tracee, KfTxnConfig *config,
+	const KfTxnControl *control, Reg path_sysarg, Reg length_sysarg)
+{
+	char path[PATH_MAX];
+	struct stat st;
+	uint64_t requested = (uint64_t) peek_reg(tracee, CURRENT, length_sysarg);
+	int status = current_path(tracee, path_sysarg, path);
+	if (status != 0)
+		return status < 0 ? status : 0;
+	if (lstat(path, &st) != 0 || !S_ISREG(st.st_mode))
+		return capture_path(config, control, path);
+	return capture_range(config, control, path,
+		requested < (uint64_t) st.st_size ? requested : (uint64_t) st.st_size,
+		requested < (uint64_t) st.st_size ? (uint64_t) st.st_size - requested : 0);
