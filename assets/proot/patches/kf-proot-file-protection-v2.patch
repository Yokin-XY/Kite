+static int capture_range_blocks(KfTxnConfig *config, const KfTxnControl *control,
+	const char *path, const char *entry_dir, uint64_t offset, uint64_t length,
+	uint64_t original_size)
+{
+	char ranges_dir[PATH_MAX];
+	uint64_t first;
+	uint64_t end;
+	uint64_t block;
+	int result;
+	if (snprintf(ranges_dir, sizeof(ranges_dir), "%s/%s", entry_dir,
+		KF_TXN_RANGES_DIR) >= (int) sizeof(ranges_dir))
+		return -ENAMETOOLONG;
+	result = ensure_directory(ranges_dir);
+	if (result < 0)
+		return result;
+	if (length == 0 || offset >= original_size)
+		return 0;
+	end = length > UINT64_MAX - offset ? UINT64_MAX : offset + length;
+	if (end > original_size)
+		end = original_size;
+	first = offset - (offset % KF_TXN_RANGE_BLOCK);
+	for (block = first; block < end; block += KF_TXN_RANGE_BLOCK) {
+		char destination[PATH_MAX];
+		uint64_t block_length = original_size - block;
+		if (block_length > KF_TXN_RANGE_BLOCK)
+			block_length = KF_TXN_RANGE_BLOCK;
+		if (snprintf(destination, sizeof(destination), "%s/%016" PRIx64
+			"-%016" PRIx64, ranges_dir, block, block_length) >=
+			(int) sizeof(destination))
+			return -ENAMETOOLONG;
+		result = copy_range_block(path, destination, block, block_length,
+			&config->used_bytes, control->max_backup_bytes);
+		if (result < 0)
+			return result;
+		if (UINT64_MAX - block < KF_TXN_RANGE_BLOCK)
+			break;
+	}
+	return 0;
+}
