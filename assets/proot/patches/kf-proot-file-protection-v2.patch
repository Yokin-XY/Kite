+static int copy_range_block(const char *source, const char *destination,
+	uint64_t offset, uint64_t length, uint64_t *used_bytes, uint64_t limit)
+{
+	char temp[PATH_MAX];
+	char buffer[KF_TXN_COPY_BUFFER];
+	int input = -1;
+	int output = -1;
+	uint64_t copied = 0;
+	int result = 0;
+	if (access(destination, F_OK) == 0)
+		return 0;
+	if (length > limit || *used_bytes > limit - length)
+		return -ENOSPC;
+	if (snprintf(temp, sizeof(temp), "%s.tmp-%ld", destination, (long) getpid()) >=
+		(int) sizeof(temp))
+		return -ENAMETOOLONG;
+	input = open(source, O_RDONLY | O_CLOEXEC);
+	if (input < 0)
+		return -errno;
+	output = open(temp, O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC, 0600);
+	if (output < 0) {
+		result = -errno;
+		goto out;
+	}
+	while (copied < length) {
+		size_t wanted = (size_t) ((length - copied) < sizeof(buffer) ?
+			(length - copied) : sizeof(buffer));
+		ssize_t count = pread(input, buffer, wanted, (off_t) (offset + copied));
+		ssize_t written = 0;
+		if (count < 0) {
+			if (errno == EINTR)
+				continue;
+			result = -errno;
+			goto out;
+		}
+		if (count == 0) {
+			result = -EIO;
+			goto out;
+		}
+		while (written < count) {
+			ssize_t step = write(output, buffer + written, (size_t) (count - written));
+			if (step < 0) {
+				if (errno == EINTR)
+					continue;
+				result = -errno;
+				goto out;
+			}
+			written += step;
+		}
+		copied += (uint64_t) count;
+	}
+	if (fsync(output) != 0) {
+		result = -errno;
+		goto out;
+	}
+	if (close(output) != 0) {
+		output = -1;
+		result = -errno;
+		goto out;
+	}
+	output = -1;
+	if (rename(temp, destination) != 0) {
+		result = -errno;
+		goto out;
+	}
+	*used_bytes += copied;
+
+out:
+	if (output >= 0)
+		close(output);
+	if (input >= 0)
+		close(input);
+	if (result < 0)
+		unlink(temp);
+	return result;
+}
