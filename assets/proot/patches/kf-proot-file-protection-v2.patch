 static int capture_path(KfTxnConfig *config, const KfTxnControl *control, const char *path)
 {
 	const char *relative;
@@ -788,6 +1042,173 @@ static int fd_path(Tracee *tracee, Reg fd_sysarg, char path[PATH_MAX])
