{
  "schemaVersion": 1,
  "id": "kite.google.antigravity",
  "base": {
    "name": "Antigravity CLI",
    "description": "Google Antigravity 的原生会话 Agent",
    "version": "official",
    "icon": {
      "type": "asset",
      "value": "resources/kite.google.antigravity/icon.png",
      "fallbackText": "Ag",
      "fit": "fullBleed"
    }
  },
  "management": {
    "mode": "managed_extension",
    "managedCommands": ["agy"]
  },
  "display": {
    "sections": [
      "ai-vendor"
    ],
    "tabs": ["angel-cli"],
    "order": 100,
    "category": "AI",
    "accent": "blue",
    "sizeLabel": "网络包",
    "longDescription": "Antigravity CLI 是 Google 的编码 Agent。Kite 使用官方 stream-json 持续会话接入消息、工具步骤、模型、推理强度、权限模式和历史恢复；首次认证仍由 agy 官方交互流程完成。",
    "recommendations": [
      {
        "resourceId": "kite.curl",
        "label": "下载工具"
      },
      {
        "resourceId": "kite.git",
        "label": "源码工具"
      },
      {
        "resourceId": "kite.qwen.code",
        "label": "同类 Agent"
      },
      {
        "resourceId": "kite.codex.cli",
        "label": "同类 Agent"
      }
    ],
    "tags": [
      "google",
      "antigravity",
      "gemini",
      "coding-agent",
      "terminal",
      "ai"
    ]
  },
  "relations": {
    "provides": [
      "cli.antigravity",
      "agent.google.antigravity"
    ],
    "base": [
      "kite.git",
      "kite.curl"
    ],
    "defaults": [],
    "extensions": []
  },
  "source": {
    "type": "official_script",
    "url": "https://antigravity.google/cli/install.sh",
    "repository": "https://antigravity.google"
  },
  "paths": {
    "cacheRoot": "/workspace/.kf/cache/resources/kite.google.antigravity",
    "installRoot": "/workspace/.kf/software/kite.google.antigravity",
    "binRoot": "/workspace/.kf/bin"
  },
  "agents": [
    {
      "id": "antigravity",
      "name": "Antigravity CLI",
      "description": "Antigravity 官方 stream-json 持续会话",
      "configuration": {
        "required": false,
        "adapter": "google-antigravity"
      },
      "launch": {
        "mode": "managed",
        "providerId": "antigravity",
        "protocol": "antigravity-stream-json",
        "transport": "stdio",
        "argv": ["agy"],
        "initializeTimeoutMs": 60000,
        "title": "Antigravity CLI"
      }
    }
  ],
  "actions": {
    "install": [
      {
        "type": "managed",
        "steps": [
          {
            "id": "download-antigravity-installer",
            "type": "download",
            "url": "https://antigravity.google/cli/install.sh",
            "destination": "$install_root/.kite-downloads/install.sh",
            "maxBytes": 16777216
          },
          {
            "id": "run-antigravity-installer",
            "type": "script",
            "interpreter": "bash",
            "path": "$install_root/.kite-downloads/install.sh"
          }
        ],
        "managedCommands": [
          "agy"
        ],
        "cleanInstallRoot": true,
        "verify": [
          {
            "id": "antigravity-command",
            "cmd": "command -v agy >/dev/null 2>&1"
          }
        ],
        "timeoutMs": 600000
      }
    ],
    "open": {
      "runtime": "kite_recipe",
      "recipe": {
        "base": {
          "id": "",
          "name": "Antigravity CLI",
          "description": "启动 Google Antigravity 会话",
          "icon": {
            "type": "builtin",
            "name": "bot"
          }
        },
        "launch": {
          "openInstance": true
        },
        "recipe": [{"type": "agent", "agentId": "antigravity", "workdir": "/workspace"}]
      }
    },
    "uninstall": [
      {
        "type": "shell",
        "cmd": ":",
        "managedCommands": [
          "agy"
        ],
        "timeoutMs": 180000
      }
    ]
  },
  "homeCards": [
    {
      "label": "Antigravity CLI",
      "policy": "manual",
      "recipe": {
        "base": {
          "id": "",
          "name": "Antigravity CLI",
          "description": "启动 Google Antigravity 会话",
          "icon": {
            "type": "builtin",
            "name": "bot"
          }
        },
        "launch": {
          "openInstance": true
        },
        "recipe": [{"type": "agent", "agentId": "antigravity", "workdir": "/workspace"}]
      }
    }
  ]
}
