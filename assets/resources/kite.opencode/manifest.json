{
  "schemaVersion": 1,
  "id": "kite.opencode",
  "base": {
    "name": "OpenCode",
    "description": "开源终端 AI 编码 Agent",
    "version": "npm",
    "icon": {
      "type": "asset",
      "value": "resources/kite.opencode/icon.png",
      "fallbackText": "OC",
      "fit": "fullBleed"
    }
  },
  "management": {
    "mode": "managed_extension",
    "managedCommands": ["opencode"],
    "versionProbe": {
      "command": "opencode --version",
      "pattern": "v?([0-9]+(?:\\.[0-9]+)+)"
    },
    "preservePaths": ["user-home"]
  },
  "display": {
    "sections": [
      "ai-community"
    ],
    "tabs": ["angel-cli"],
    "order": 10,
    "category": "AI",
    "accent": "blue",
    "sizeLabel": "网络包",
    "longDescription": "OpenCode 是开源的终端 AI 编码 Agent，可以连接 Claude、GPT、Gemini 等模型。Kite 通过官方 npm 包安装 opencode 命令，并使用 OpenCode 的 ACP stdio 能力建立原生 Agent 会话。",
    "recommendations": [
      {
        "resourceId": "kite.nodejs",
        "label": "运行时"
      },
      {
        "resourceId": "kite.codex.cli",
        "label": "同类 Agent"
      },
      {
        "resourceId": "kite.claude.code",
        "label": "同类 Agent"
      },
      {
        "resourceId": "kite.openclaw",
        "label": "同类 Agent"
      }
    ],
    "tags": [
      "opencode",
      "coding-agent",
      "terminal",
      "ai",
      "open-source"
    ]
  },
  "relations": {
    "provides": [
      "cli.opencode",
      "agent.opencode"
    ],
    "base": [
      "kite.nodejs",
      "kite.git"
    ],
    "defaults": [],
    "extensions": []
  },
  "agents": [
    {
      "id": "opencode",
      "name": "OpenCode",
      "description": "OpenCode 原生 ACP 会话",
      "configuration": {
        "required": false,
        "adapter": "opencode"
      },
      "sessions": {
        "adapter": "opencode"
      },
      "launch": {
        "mode": "managed",
        "providerId": "opencode",
        "protocol": "acp",
        "transport": "stdio",
        "argv": ["opencode", "acp"],
        "title": "OpenCode"
      }
    }
  ],
  "source": {
    "type": "npm",
    "package": "opencode-ai",
    "latestVersionWindow": [
      { "version": "1.18.25", "integrity": "sha512-pS4RKJ9eKwU7Dp5G5pdj1rhMnpG5APixXzfTKNoFqv9aFVI36Rnza2jESvKifxyPZlsA65MQB03WCArY0EK6mg==" },
      { "version": "1.18.24", "integrity": "sha512-PIV4ud2cqFQw6Lm+onvxQrQo+wCFYnA+6TDryeDJ6PF38t2ujzeeKPzlxZ1vCmZ6p7AixtfgJu4iUovDVt4GZQ==" },
      { "version": "1.18.23", "integrity": "sha512-3NkT0XINL7d0HYkTyGV1SPChHXhvRgKqNaTgKRTGb0TXUWszXA7MW/y3zMZw29y1AQuUDAzRvVYmQ9KGRQhroA==" }
    ],
    "repository": "https://github.com/anomalyco/opencode",
    "tag": "latest"
  },
  "paths": {
    "cacheRoot": "/workspace/.kf/cache/resources/kite.opencode",
    "installRoot": "/workspace/.kf/software/kite.opencode",
    "binRoot": "/workspace/.kf/bin"
  },
  "actions": {
    "open": {
      "runtime": "kite_recipe",
      "recipe": {
        "base": {
          "id": "",
          "name": "OpenCode",
          "description": "启动 OpenCode Agent 会话",
          "icon": {
            "type": "builtin",
            "name": "bot"
          }
        },
        "launch": {
          "openInstance": true
        },
        "recipe": [
          {
            "type": "agent",
            "agentId": "opencode",
            "workdir": "/workspace"
          }
        ]
      }
    }
  },
  "homeCards": [
    {
      "label": "OpenCode",
      "policy": "manual",
      "recipe": {
        "base": {
          "id": "",
          "name": "OpenCode",
          "description": "启动 OpenCode Agent 会话",
          "icon": {
            "type": "builtin",
            "name": "bot"
          }
        },
        "launch": {
          "openInstance": true
        },
        "recipe": [
          {
            "type": "agent",
            "agentId": "opencode",
            "workdir": "/workspace"
          }
        ]
      }
    }
  ]
}
