{
  "schemaVersion": 1,
  "id": "kite.opencode",
  "base": {
    "name": "OpenCode",
    "description": "开源终端 AI 编码 Agent",
    "version": "official",
    "icon": {
      "type": "asset",
      "value": "resources/kite.opencode/icon.png",
      "fallbackText": "OC",
      "fit": "fullBleed"
    }
  },
  "display": {
    "sections": [
      "featured"
    ],
    "category": "AI",
    "accent": "blue",
    "sizeLabel": "网络包",
    "longDescription": "OpenCode 是开源的终端 AI 编码 Agent，可以连接 Claude、GPT、Gemini 等模型。Kite 通过官方 install script 安装 opencode 命令，并提供首页卡入口；Provider 配置和会话内容仍由终端运行态承接。",
    "recommendations": [
      {
        "resourceId": "kite.curl",
        "label": "下载工具"
      },
      {
        "resourceId": "kite.codex.cli",
        "label": "同类 Agent"
      },
      {
        "resourceId": "kite.claude.code",
        "label": "同类 Agent"
      },
      {
        "resourceId": "kite.openclaw",
        "label": "同类 Agent"
      }
    ],
    "tags": [
      "opencode",
      "coding-agent",
      "terminal",
      "ai",
      "open-source"
    ]
  },
  "relations": {
    "provides": [
      "cli.opencode",
      "agent.opencode"
    ],
    "base": [
      "kite.git",
      "kite.curl"
    ],
    "defaults": [],
    "extensions": []
  },
  "source": {
    "type": "official_script",
    "url": "https://opencode.ai/install",
    "repository": "https://github.com/anomalyco/opencode",
    "command": "curl -fsSL https://opencode.ai/install | bash"
  },
  "paths": {
    "cacheRoot": "/workspace/.kf/cache/resources/kite.opencode",
    "installRoot": "/workspace/.kf/software/kite.opencode",
    "binRoot": "/workspace/.kf/bin"
  },
  "actions": {
    "install": [
      {
        "type": "shell",
        "cmd": "export OPENCODE_INSTALL_DIR=\"$install_root/bin\"\ncurl -fsSL https://opencode.ai/install | bash",
        "managedCommands": [
          "opencode"
        ],
        "cleanInstallRoot": true,
        "timeoutMs": 600000
      }
    ],
    "open": {
      "runtime": "kite_recipe",
      "recipe": {
        "base": {
          "id": "",
          "name": "OpenCode",
          "description": "在终端里启动 OpenCode",
          "icon": {
            "type": "builtin",
            "name": "bot"
          }
        },
        "launch": {
          "openInstance": true
        },
        "recipe": [
          {
            "type": "terminal",
            "text": "cd /workspace\necho \"OpenCode 首次启动会引导选择或配置 Provider。\"\nopencode\n"
          }
        ]
      }
    },
    "uninstall": [
      {
        "type": "shell",
        "cmd": ":",
        "managedCommands": [
          "opencode"
        ],
        "timeoutMs": 180000
      }
    ]
  },
  "homeCards": [
    {
      "label": "OpenCode",
      "policy": "manual",
      "recipe": {
        "base": {
          "id": "",
          "name": "OpenCode",
          "description": "在终端里启动 OpenCode",
          "icon": {
            "type": "builtin",
            "name": "bot"
          }
        },
        "launch": {
          "openInstance": true
        },
        "recipe": [
          {
            "type": "terminal",
            "text": "cd /workspace\necho \"OpenCode 首次启动会引导选择或配置 Provider。\"\nopencode\n"
          }
        ]
      }
    }
  ]
}
