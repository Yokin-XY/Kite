{
  "schemaVersion": 1,
  "id": "kite.uv",
  "base": {
    "name": "uv",
    "description": "Hermes 本体安装 Python 依赖的高速包管理器",
    "version": "0.11.1",
    "icon": {
      "type": "asset",
      "value": "resources/kite.uv/icon.png",
      "fallbackText": "uv",
      "fit": "fullBleed"
    }
  },
  "display": {
    "sections": [
      "more"
    ],
    "category": "Python",
    "accent": "green",
    "sizeLabel": "内置包",
    "longDescription": "uv 是 Hermes 安装 Python 依赖和管理虚拟环境的基础工具卡。Kite 使用内置 ai-dev-pack 中的 uv 0.11.1，只安装 uv/uvx 到 /workspace/.kf/bin，不顺带安装完整工具合集。",
    "recommendations": [
      {
        "resourceId": "kite.python",
        "label": "运行时"
      },
      {
        "resourceId": "kite.hermes.core",
        "label": "上层应用"
      }
    ],
    "tags": [
      "uv",
      "python",
      "package-manager",
      "dependency",
      "hermes"
    ]
  },
  "relations": {
    "provides": [
      "tool.uv",
      "tool.uvx"
    ],
    "base": [],
    "defaults": [],
    "extensions": [
      "kite.hermes.core"
    ]
  },
  "source": {
    "type": "bundled",
    "asset": "toolchain/ai-dev-pack"
  },
  "paths": {
    "cacheRoot": "/workspace/.kf/cache/resources/kite.uv",
    "installRoot": "/workspace/.kf/software/kite.uv",
    "binRoot": "/workspace/.kf/bin"
  },
  "actions": {
    "install": [
      {
        "type": "shell",
        "cmd": "install.sh --install-uv"
      }
    ],
    "open": {
      "runtime": "kite_recipe",
      "recipe": {
        "base": {
          "id": "",
          "name": "uv",
          "description": "检查 uv 与 uvx 命令",
          "icon": {
            "type": "builtin",
            "name": "code"
          }
        },
        "launch": {
          "openInstance": true
        },
        "recipe": [
          {
            "type": "shell",
            "cmd": "uv --version && uvx --version",
            "surfaceMode": "panel"
          }
        ]
      }
    },
    "uninstall": [
      {
        "type": "shell",
        "cmd": "remove software root and uv/uvx wrappers"
      }
    ]
  },
  "homeCards": []
}
