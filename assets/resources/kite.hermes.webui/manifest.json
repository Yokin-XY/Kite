{
  "schemaVersion": 1,
  "id": "kite.hermes.webui",
  "base": {
    "name": "Hermes WebUI",
    "description": "Hermes 的网页工作台",
    "version": "npm",
    "icon": {
      "type": "text",
      "value": "H"
    }
  },
  "display": {
    "sections": [
      "featured"
    ],
    "tags": [
      "hermes",
      "webui",
      "ai"
    ]
  },
  "relations": {
    "provides": [
      "surface.hermes.webui"
    ],
    "base": [
      "runtime.node>=23",
      "cli.hermes",
      "service.hermes"
    ],
    "defaults": [],
    "extensions": [
      "storage.hermes.sql"
    ]
  },
  "source": {
    "type": "command",
    "command": "npm install -g hermes-web-ui"
  },
  "paths": {
    "cacheRoot": "/workspace/.kf/cache/resources/kite.hermes.webui",
    "installRoot": "/workspace/.kf/software/kite.hermes.webui",
    "binRoot": "/workspace/.kf/bin"
  },
  "actions": {
    "install": [
      {
        "type": "shell",
        "cmd": "npm install -g hermes-web-ui"
      }
    ],
    "open": {
      "runtime": "kite_recipe",
      "recipe": {
        "base": {
          "id": "",
          "name": "Hermes WebUI",
          "description": "启动 Hermes 图形化工作台",
          "icon": {
            "type": "builtin",
            "name": "bot"
          }
        },
        "launch": {
          "openInstance": true
        },
        "recipe": [
          {
            "type": "shell",
            "cmd": "hermes-web-ui start --port 8648",
            "surfaceMode": "panel"
          },
          {
            "type": "open_web",
            "url": "http://127.0.0.1:8648"
          }
        ]
      }
    },
    "uninstall": [
      {
        "type": "shell",
        "cmd": "npm uninstall -g hermes-web-ui"
      }
    ]
  },
  "homeCards": [
    {
      "label": "Hermes WebUI",
      "policy": "manual",
      "recipe": {
        "base": {
          "id": "",
          "name": "Hermes WebUI",
          "description": "启动 Hermes 图形化工作台",
          "icon": {
            "type": "builtin",
            "name": "bot"
          }
        },
        "launch": {
          "openInstance": true
        },
        "recipe": [
          {
            "type": "shell",
            "cmd": "hermes-web-ui start --port 8648",
            "surfaceMode": "panel"
          },
          {
            "type": "open_web",
            "url": "http://127.0.0.1:8648"
          }
        ]
      }
    }
  ]
}
