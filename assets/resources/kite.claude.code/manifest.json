{
  "schemaVersion": 1,
  "id": "kite.claude.code",
  "base": {
    "name": "Claude Code",
    "description": "Anthropic 的终端编码助手",
    "version": "npm",
    "icon": {
      "type": "asset",
      "value": "resources/kite.claude.code/icon.png",
      "fallbackText": "CC",
      "fit": "fullBleed"
    }
  },
  "management": {
    "mode": "managed_extension",
    "managedCommands": ["claude", "claude-agent-acp"],
    "versionProbe": {
      "command": "claude --version",
      "pattern": "([0-9]+(?:\\.[0-9]+)+)"
    }
  },
  "display": {
    "sections": [
      "ai-vendor"
    ],
    "tabs": ["angel-cli"],
    "order": 70,
    "category": "AI",
    "accent": "orange",
    "sizeLabel": "网络包",
    "longDescription": "Claude Code 是 Anthropic 面向终端的编码助手。Kite 使用 Anthropic 官方 NPM 包获取对应平台的原生 claude 命令，并负责依赖安装、命令暴露和结果验证；官方账号可从 Agent 模型库发起登录或退出，凭据仍由 Claude Code 自己保存。",
    "recommendations": [
      {
        "resourceId": "kite.nodejs",
        "label": "安装运行时"
      },
      {
        "resourceId": "kite.git",
        "label": "源码工具"
      },
      {
        "resourceId": "kite.codex.cli",
        "label": "同类 Agent"
      },
      {
        "resourceId": "kite.opencode",
        "label": "同类 Agent"
      },
      {
        "resourceId": "kite.reasonix",
        "label": "终端 Agent"
      }
    ],
    "tags": [
      "claude",
      "anthropic",
      "coding-agent",
      "terminal",
      "ai"
    ]
  },
  "relations": {
    "provides": [
      "cli.claude",
      "agent.anthropic.claude-code"
    ],
    "base": [
      "kite.nodejs",
      "kite.git"
    ],
    "defaults": [],
    "extensions": []
  },
  "source": {
    "type": "npm",
    "package": "@anthropic-ai/claude-code",
    "latestVersionWindow": [
      { "artifact": "@anthropic-ai/claude-code", "version": "2.1.272", "integrity": "sha512-sOwHBM69H8Zka3/D3rc2VNNemPYNlgfYTdhsoqPoXZdK5KcKQlzoue4asJ2RVc+tGb/Pz1qxjVV9nVJQ87W7Ng==" },
      { "artifact": "@anthropic-ai/claude-code", "version": "2.1.271", "integrity": "sha512-mnhR0yp8ycoJxTGrLTl+YWMAgSNJISDd2B0DhtavmtKuHDcCOi+/qDfm4zTLjUA61GAT8+IMBfS2zI4OFo8OXQ==" },
      { "artifact": "@anthropic-ai/claude-code", "version": "2.1.270", "integrity": "sha512-0zMkfIWQu7/SG56VP8r780HZWvrNShzK28AbAnhKRK0ns+ToGXPT0W8UqyZmZCUKAkJDd5//TrwSOhk1+hysiw==" },
      { "artifact": "@agentclientprotocol/claude-agent-acp", "version": "0.77.0", "integrity": "sha512-m8mhsAOc5+m/QZNsKCrfyIRv4KQrCLqSYHZP/aUvL3X0Xn0f9n4wKKNpOpOv0Kblh/2Mkpd4SW0KypN1dZkJfg==" },
      { "artifact": "@agentclientprotocol/claude-agent-acp", "version": "0.76.0", "integrity": "sha512-8Xh1ryud5b1fOGLfF+S7dW2hhIZ/h4WopKtD//JRcQWxu7dutZvzN/MhRSDjqRcxqf3UIZRx1K0OhnlY/hMaOg==" },
      { "artifact": "@agentclientprotocol/claude-agent-acp", "version": "0.75.1", "integrity": "sha512-Un6I4BRkhpCFS3I7kr5C/lkAm8Nc3VuGZU2YQ3xIpJAIxV94iWO0Q2CH2QABxMERpONRu4Le6XC9V+5PImQZ2A==" }
    ],
    "companionPackages": ["@agentclientprotocol/claude-agent-acp"],
    "installArguments": ["--allow-scripts=@anthropic-ai/claude-code"]
  },
  "paths": {
    "cacheRoot": "/workspace/.kf/cache/resources/kite.claude.code",
    "installRoot": "/workspace/.kf/software/kite.claude.code",
    "binRoot": "/workspace/.kf/bin"
  },
  "agents": [
    {
      "id": "claude-code",
      "name": "Claude Code",
      "description": "Claude Code 的 ACP 会话",
      "configuration": {
        "required": false,
        "adapter": "claude-code"
      },
      "accounts": [
        {
          "id": "anthropic",
          "name": "Anthropic 官方",
          "modelGroupIds": ["claude-code", "anthropic", "claude"],
          "status": {
            "argv": ["claude", "auth", "status"],
            "loggedInPatterns": ["\"loggedIn\":true"],
            "loggedOutPatterns": ["\"loggedIn\":false"],
            "timeoutMs": 15000
          },
          "login": {
            "argv": ["claude", "auth", "login"],
            "timeoutMs": 300000
          },
          "logout": {
            "argv": ["claude", "auth", "logout"],
            "timeoutMs": 30000
          }
        }
      ],
      "launch": {
        "mode": "managed",
        "providerId": "claude-code",
        "protocol": "acp",
        "transport": "stdio",
        "argv": ["/usr/bin/env", "claude-agent-acp"],
        "title": "Claude Code"
      }
    }
  ],
  "actions": {
    "open": {
      "runtime": "kite_recipe",
      "recipe": {
        "base": {
          "id": "",
          "name": "Claude Code",
          "description": "启动 Claude Code Agent 会话",
          "icon": {
            "type": "builtin",
            "name": "bot"
          }
        },
        "launch": {
          "openInstance": true
        },
        "recipe": [
          {
            "type": "agent",
            "agentId": "claude-code",
            "workdir": "/workspace"
          }
        ]
      }
    }
  },
  "homeCards": [
    {
      "label": "Claude Code",
      "policy": "manual",
      "recipe": {
        "base": {
          "id": "",
          "name": "Claude Code",
          "description": "启动 Claude Code Agent 会话",
          "icon": {
            "type": "builtin",
            "name": "bot"
          }
        },
        "launch": {
          "openInstance": true
        },
        "recipe": [
          {
            "type": "agent",
            "agentId": "claude-code",
            "workdir": "/workspace"
          }
        ]
      }
    }
  ]
}
