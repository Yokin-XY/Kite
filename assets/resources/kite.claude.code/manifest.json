{
  "schemaVersion": 1,
  "id": "kite.claude.code",
  "base": {
    "name": "Claude Code",
    "description": "Anthropic 的终端编码助手",
    "version": "npm",
    "icon": {
      "type": "asset",
      "value": "resources/kite.claude.code/icon.png",
      "fallbackText": "CC",
      "fit": "fullBleed"
    }
  },
  "management": {
    "mode": "managed_extension",
    "managedCommands": ["claude", "claude-agent-acp"],
    "versionProbe": {
      "command": "claude --version",
      "pattern": "([0-9]+(?:\\.[0-9]+)+)"
    }
  },
  "display": {
    "sections": [
      "ai-vendor"
    ],
    "tabs": ["angel-cli"],
    "order": 70,
    "category": "AI",
    "accent": "orange",
    "sizeLabel": "网络包",
    "longDescription": "Claude Code 是 Anthropic 面向终端的编码助手。Kite 使用 Anthropic 官方 NPM 包获取对应平台的原生 claude 命令，并负责依赖安装、命令暴露和结果验证；登录和项目授权仍在终端表面完成。",
    "recommendations": [
      {
        "resourceId": "kite.nodejs",
        "label": "安装运行时"
      },
      {
        "resourceId": "kite.git",
        "label": "源码工具"
      },
      {
        "resourceId": "kite.codex.cli",
        "label": "同类 Agent"
      },
      {
        "resourceId": "kite.opencode",
        "label": "同类 Agent"
      },
      {
        "resourceId": "kite.reasonix",
        "label": "终端 Agent"
      }
    ],
    "tags": [
      "claude",
      "anthropic",
      "coding-agent",
      "terminal",
      "ai"
    ]
  },
  "relations": {
    "provides": [
      "cli.claude",
      "agent.anthropic.claude-code"
    ],
    "base": [
      "kite.nodejs",
      "kite.git"
    ],
    "defaults": [],
    "extensions": []
  },
  "source": {
    "type": "npm",
    "package": "@anthropic-ai/claude-code",
    "companionPackages": ["@agentclientprotocol/claude-agent-acp"],
    "installArguments": ["--allow-scripts=@anthropic-ai/claude-code"]
  },
  "paths": {
    "cacheRoot": "/workspace/.kf/cache/resources/kite.claude.code",
    "installRoot": "/workspace/.kf/software/kite.claude.code",
    "binRoot": "/workspace/.kf/bin"
  },
  "agents": [
    {
      "id": "claude-code",
      "name": "Claude Code",
      "description": "Claude Code 的 ACP 会话",
      "configuration": {
        "required": false,
        "adapter": "claude-code"
      },
      "launch": {
        "mode": "managed",
        "providerId": "claude-code",
        "protocol": "acp",
        "transport": "stdio",
        "argv": ["claude-agent-acp"],
        "title": "Claude Code"
      }
    }
  ],
  "actions": {
    "open": {
      "runtime": "kite_recipe",
      "recipe": {
        "base": {
          "id": "",
          "name": "Claude Code",
          "description": "启动 Claude Code Agent 会话",
          "icon": {
            "type": "builtin",
            "name": "bot"
          }
        },
        "launch": {
          "openInstance": true
        },
        "recipe": [
          {
            "type": "agent",
            "agentId": "claude-code",
            "workdir": "/workspace"
          }
        ]
      }
    }
  },
  "homeCards": [
    {
      "label": "Claude Code",
      "policy": "manual",
      "recipe": {
        "base": {
          "id": "",
          "name": "Claude Code",
          "description": "启动 Claude Code Agent 会话",
          "icon": {
            "type": "builtin",
            "name": "bot"
          }
        },
        "launch": {
          "openInstance": true
        },
        "recipe": [
          {
            "type": "agent",
            "agentId": "claude-code",
            "workdir": "/workspace"
          }
        ]
      }
    }
  ]
}
