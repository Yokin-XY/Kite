{
  "schemaVersion": 1,
  "id": "kite.claude.code",
  "base": {
    "name": "Claude Code",
    "description": "Anthropic 的终端编码助手",
    "version": "npm",
    "icon": {
      "type": "asset",
      "value": "resources/kite.claude.code/icon.png",
      "fallbackText": "CC",
      "fit": "fullBleed"
    }
  },
  "display": {
    "sections": [
      "featured"
    ],
    "category": "AI",
    "accent": "orange",
    "sizeLabel": "网络包",
    "longDescription": "Claude Code 是 Anthropic 面向终端的编码助手。Kite 使用 Anthropic 官方 NPM 包获取对应平台的原生 claude 命令，并负责依赖安装、命令暴露和结果验证；登录和项目授权仍在终端表面完成。",
    "recommendations": [
      {
        "resourceId": "kite.nodejs",
        "label": "安装运行时"
      },
      {
        "resourceId": "kite.git",
        "label": "源码工具"
      },
      {
        "resourceId": "kite.codex.cli",
        "label": "同类 Agent"
      },
      {
        "resourceId": "kite.opencode",
        "label": "同类 Agent"
      },
      {
        "resourceId": "kite.reasonix",
        "label": "终端 Agent"
      }
    ],
    "tags": [
      "claude",
      "anthropic",
      "coding-agent",
      "terminal",
      "ai"
    ]
  },
  "relations": {
    "provides": [
      "cli.claude",
      "agent.anthropic.claude-code"
    ],
    "base": [
      "kite.nodejs",
      "kite.git"
    ],
    "defaults": [],
    "extensions": []
  },
  "source": {
    "type": "npm",
    "package": "@anthropic-ai/claude-code"
  },
  "paths": {
    "cacheRoot": "/workspace/.kf/cache/resources/kite.claude.code",
    "installRoot": "/workspace/.kf/software/kite.claude.code",
    "binRoot": "/workspace/.kf/bin"
  },
  "actions": {
    "install": [
      {
        "type": "managed",
        "steps": [
          {
            "id": "install-claude-code-package",
            "type": "npm",
            "packages": [
              "@anthropic-ai/claude-code@latest"
            ],
            "args": [
              "--allow-scripts=@anthropic-ai/claude-code"
            ],
            "retryAttempts": 5,
            "retryDelaySeconds": 3
          }
        ],
        "managedCommands": [
          "claude"
        ],
        "cleanInstallRoot": true,
        "verify": [
          {
            "id": "claude-command",
            "cmd": "claude --version >/dev/null 2>&1"
          }
        ],
        "timeoutMs": 900000
      }
    ],
    "open": {
      "runtime": "kite_recipe",
      "recipe": {
        "base": {
          "id": "",
          "name": "Claude Code",
          "description": "在终端里启动 Claude Code",
          "icon": {
            "type": "builtin",
            "name": "bot"
          }
        },
        "launch": {
          "openInstance": true
        },
        "recipe": [
          {
            "type": "terminal",
            "text": "cd /workspace\necho \"Claude Code 首次启动会要求登录 Claude / Anthropic。\"\nclaude\n"
          }
        ]
      }
    },
    "uninstall": [
      {
        "type": "shell",
        "cmd": ":",
        "managedCommands": [
          "claude"
        ],
        "npmUninstallPackage": "@anthropic-ai/claude-code",
        "timeoutMs": 180000
      }
    ]
  },
  "homeCards": [
    {
      "label": "Claude Code",
      "policy": "manual",
      "recipe": {
        "base": {
          "id": "",
          "name": "Claude Code",
          "description": "在终端里启动 Claude Code",
          "icon": {
            "type": "builtin",
            "name": "bot"
          }
        },
        "launch": {
          "openInstance": true
        },
        "recipe": [
          {
            "type": "terminal",
            "text": "cd /workspace\necho \"Claude Code 首次启动会要求登录 Claude / Anthropic。\"\nclaude\n"
          }
        ]
      }
    }
  ]
}
