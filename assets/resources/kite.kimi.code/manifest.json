{
  "schemaVersion": 1,
  "id": "kite.kimi.code",
  "base": {
    "name": "Kimi Code",
    "description": "Moonshot AI 的终端编码助手",
    "version": "official",
    "icon": {
      "type": "asset",
      "value": "resources/kite.kimi.code/icon.png",
      "fallbackText": "Ki",
      "fit": "fullBleed"
    }
  },
  "management": {
    "mode": "managed_extension",
    "managedCommands": ["kimi"],
    "versionProbe": {
      "command": "kimi --version",
      "pattern": "v?([0-9]+(?:\\.[0-9]+)+)"
    },
    "preservePaths": ["user-home"]
  },
  "display": {
    "sections": [
      "ai-vendor"
    ],
    "tabs": ["angel-cli"],
    "order": 80,
    "category": "AI",
    "accent": "blue",
    "sizeLabel": "网络包",
    "longDescription": "Kimi Code 是 Moonshot AI 的开源 AI 编码 Agent，可以读写代码、运行命令、搜索文件和获取网页。Kite 使用官方 install script 获取 kimi 命令，并通过原生 ACP stdio 能力建立 Agent 会话；登录凭据和 Provider 配置仍由 Kimi Code 自己保存，不写入资源卡 JSON。",
    "recommendations": [
      {
        "resourceId": "kite.curl",
        "label": "下载工具"
      },
      {
        "resourceId": "kite.git",
        "label": "源码工具"
      },
      {
        "resourceId": "kite.qwen.code",
        "label": "同类 Agent"
      },
      {
        "resourceId": "kite.codex.cli",
        "label": "同类 Agent"
      }
    ],
    "tags": [
      "kimi",
      "moonshot",
      "coding-agent",
      "terminal",
      "ai",
      "mcp"
    ]
  },
  "relations": {
    "provides": [
      "cli.kimi",
      "agent.moonshot.kimi-code"
    ],
    "base": [
      "kite.git",
      "kite.curl"
    ],
    "defaults": [],
    "extensions": []
  },
  "agents": [
    {
      "id": "kimi",
      "name": "Kimi Code",
      "description": "Kimi Code 原生 ACP 会话",
      "configuration": {
        "required": false,
        "adapter": "kimi-code"
      },
      "launch": {
        "mode": "managed",
        "providerId": "kimi",
        "protocol": "acp",
        "transport": "stdio",
        "argv": ["kimi", "acp"],
        "title": "Kimi Code"
      }
    }
  ],
  "source": {
    "type": "official_script",
    "url": "https://code.kimi.com/kimi-code/install.sh",
    "repository": "https://github.com/MoonshotAI/kimi-code",
    "latestUrl": "https://code.kimi.com/kimi-code/latest",
    "latestFormat": "text",
    "versionArguments": ["--version", "{version}"],
    "environment": {
      "KIMI_INSTALL_DIR": "$install_root",
      "KIMI_NO_MODIFY_PATH": "1"
    }
  },
  "paths": {
    "cacheRoot": "/workspace/.kf/cache/resources/kite.kimi.code",
    "installRoot": "/workspace/.kf/software/kite.kimi.code",
    "binRoot": "/workspace/.kf/bin"
  },
  "actions": {
    "open": {
      "runtime": "kite_recipe",
      "recipe": {
        "base": {
          "id": "",
          "name": "Kimi Code",
          "description": "启动 Kimi Code Agent 会话",
          "icon": {
            "type": "builtin",
            "name": "bot"
          }
        },
        "launch": {
          "openInstance": true
        },
        "recipe": [
          {
            "type": "agent",
            "agentId": "kimi",
            "workdir": "/workspace"
          }
        ]
      }
    }
  },
  "homeCards": [
    {
      "label": "Kimi Code",
      "policy": "manual",
      "recipe": {
        "base": {
          "id": "",
          "name": "Kimi Code",
          "description": "启动 Kimi Code Agent 会话",
          "icon": {
            "type": "builtin",
            "name": "bot"
          }
        },
        "launch": {
          "openInstance": true
        },
        "recipe": [
          {
            "type": "agent",
            "agentId": "kimi",
            "workdir": "/workspace"
          }
        ]
      }
    }
  ]
}
