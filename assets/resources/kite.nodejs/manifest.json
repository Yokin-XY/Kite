{
  "schemaVersion": 1,
  "id": "kite.nodejs",
  "base": {
    "name": "Node.js",
    "description": "现代 JavaScript 运行环境",
    "version": "24.15.0",
    "icon": {
      "type": "asset",
      "value": "resources/kite.nodejs/icon.png",
      "fallbackText": "JS"
    }
  },
  "display": {
    "sections": [
      "featured"
    ],
    "category": "JavaScript",
    "accent": "green",
    "sizeLabel": "30.1 MB",
    "longDescription": "Node.js 是资源页第一条真实样本。它从 Kite 内置资源缓存解压，按注册名安装到软件区，并把 node、npm、npx 暴露到 /workspace/.kf/bin，供后续 Hermes WebUI、网页工具和卡片脚本使用。",
    "recommendations": [
      {
        "resourceId": "kite.hermes.webui",
        "label": "上层应用"
      },
      {
        "resourceId": "kite.reasonix",
        "label": "编码 Agent"
      },
      {
        "resourceId": "kite.mimo.code",
        "label": "编码 Agent"
      },
      {
        "resourceId": "kite.openclaw",
        "label": "编码 Agent"
      }
    ],
    "tags": [
      "node",
      "npm",
      "npx",
      "javascript"
    ]
  },
  "relations": {
    "provides": [
      "runtime.node>=24",
      "tool.npm",
      "tool.npx"
    ],
    "base": [],
    "defaults": [],
    "extensions": [
      "kite.hermes.core",
      "kite.reasonix",
      "kite.mimo.code",
      "kite.openclaw"
    ]
  },
  "source": {
    "type": "bundled",
    "asset": "toolchain/ai-dev-pack"
  },
  "paths": {
    "cacheRoot": "/workspace/.kf/cache/resources/kite.nodejs",
    "installRoot": "/workspace/.kf/software/kite.nodejs",
    "binRoot": "/workspace/.kf/bin"
  },
  "actions": {
    "install": [
      {
        "type": "shell",
        "cmd": "install.sh --install-node"
      }
    ],
    "open": {
      "runtime": "kite_recipe",
      "recipe": {
        "base": {
          "id": "",
          "name": "Node.js",
          "description": "检查 Node.js、npm 与 npx 版本",
          "icon": {
            "type": "builtin",
            "name": "code"
          }
        },
        "launch": {
          "openInstance": true
        },
        "recipe": [
          {
            "type": "shell",
            "cmd": "node --version && npm --version && npx --version",
            "surfaceMode": "panel"
          }
        ]
      }
    },
    "uninstall": [
      {
        "type": "shell",
        "cmd": "remove software root and node/npm/npx wrappers"
      }
    ],
    "reinstall": [
      {
        "type": "action",
        "name": "uninstall"
      },
      {
        "type": "action",
        "name": "install"
      }
    ]
  },
  "homeCards": []
}
