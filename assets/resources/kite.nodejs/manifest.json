{
  "schemaVersion": 1,
  "id": "kite.nodejs",
  "base": {
    "name": "Node.js",
    "description": "现代 JavaScript 运行环境",
    "version": "24.15.0",
    "icon": {
      "type": "text",
      "value": "JS"
    }
  },
  "display": {
    "sections": [
      "featured"
    ],
    "tags": [
      "node",
      "npm",
      "npx",
      "javascript"
    ]
  },
  "relations": {
    "provides": [
      "runtime.node>=24",
      "tool.npm",
      "tool.npx"
    ],
    "base": [],
    "defaults": [],
    "extensions": [
      "kite.hermes.webui",
      "kite.reasonix"
    ]
  },
  "source": {
    "type": "bundled",
    "asset": "toolchain/ai-dev-pack"
  },
  "paths": {
    "cacheRoot": "/workspace/.kf/cache/resources/kite.nodejs",
    "installRoot": "/workspace/.kf/software/kite.nodejs",
    "binRoot": "/workspace/.kf/bin"
  },
  "actions": {
    "install": [
      {
        "type": "shell",
        "cmd": "install.sh --install-node"
      }
    ],
    "open": {
      "runtime": "kite_recipe",
      "recipe": {
        "base": {
          "id": "",
          "name": "Node.js",
          "description": "检查 Node.js、npm 与 npx 版本",
          "icon": {
            "type": "builtin",
            "name": "code"
          }
        },
        "launch": {
          "openInstance": true
        },
        "recipe": [
          {
            "type": "shell",
            "cmd": "node --version && npm --version && npx --version",
            "surfaceMode": "panel"
          }
        ]
      }
    },
    "uninstall": [
      {
        "type": "shell",
        "cmd": "remove software root and node/npm/npx wrappers"
      }
    ],
    "reinstall": [
      {
        "type": "action",
        "name": "uninstall"
      },
      {
        "type": "action",
        "name": "install"
      }
    ]
  },
  "homeCards": []
}
