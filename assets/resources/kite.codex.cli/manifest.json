{
  "schemaVersion": 1,
  "id": "kite.codex.cli",
  "base": {
    "name": "Codex CLI",
    "description": "OpenAI 的终端编码助手",
    "version": "npm",
    "icon": {
      "type": "asset",
      "value": "resources/kite.codex.cli/icon.png",
      "fallbackText": "Cx"
    }
  },
  "management": {
    "mode": "managed_extension",
    "managedCommands": ["codex"],
    "versionProbe": {
      "command": "codex --version",
      "pattern": "([0-9]+(?:\\.[0-9]+)+)"
    },
    "preservePaths": ["user-home"]
  },
  "display": {
    "sections": [
      "ai-vendor"
    ],
    "tabs": ["angel-cli"],
    "order": 50,
    "category": "AI",
    "accent": "teal",
    "sizeLabel": "网络包",
    "longDescription": "Codex CLI 是 OpenAI 面向终端的编码助手。Kite 使用 OpenAI 官方 NPM 包获取对应平台的 codex 命令，并把它暴露到 /workspace/.kf/bin；官方账号可从 Agent 模型库发起登录或退出，凭据仍由 Codex 自己保存，不写入资源卡 JSON。",
    "recommendations": [
      {
        "resourceId": "kite.nodejs",
        "label": "安装运行时"
      },
      {
        "resourceId": "kite.codex.relay",
        "label": "兼容供应商"
      },
      {
        "resourceId": "kite.claude.code",
        "label": "同类 Agent"
      },
      {
        "resourceId": "kite.opencode",
        "label": "同类 Agent"
      },
      {
        "resourceId": "kite.mimo.code",
        "label": "终端 Agent"
      }
    ],
    "tags": [
      "codex",
      "openai",
      "coding-agent",
      "terminal",
      "ai"
    ]
  },
  "relations": {
    "provides": [
      "cli.codex",
      "agent.openai.codex"
    ],
    "base": [
      "kite.nodejs",
      "kite.git",
      "kite.codex.relay"
    ],
    "defaults": [],
    "extensions": []
  },
  "source": {
    "type": "npm",
    "package": "@openai/codex",
    "latestVersionWindow": [
      { "version": "0.151.0", "integrity": "sha512-mhtWmOZRdmWD1jPbLDnQb59BsaVP/V+lXe/OFNR9ZcLZU0UCiBwn98Fcav1ss7sDIlHkuqj6nWd44IPeXoOhJA==" },
      { "version": "0.150.1", "integrity": "sha512-knrbhpJH3mEULAVStcZW4F5WEt9MQhBj6KFOonBSIUGTLcHlu9CE7FRmr95E33y94+sWNZSeVBBV/kYvlfgxkQ==" },
      { "version": "0.150.0", "integrity": "sha512-AWrJENpRsvowLZeCEicYEmt4xD7EvSIX34+1DmFn7ZUwuX0Ku0/DMgouPHu5YKxJJF7/ixC1cIAu3oLSd8/H2g==" }
    ],
    "repository": "https://github.com/openai/codex"
  },
  "paths": {
    "cacheRoot": "/workspace/.kf/cache/resources/kite.codex.cli",
    "installRoot": "/workspace/.kf/software/kite.codex.cli",
    "binRoot": "/workspace/.kf/bin"
  },
  "agents": [
    {
      "id": "codex",
      "name": "Codex",
      "description": "Codex 官方 App Server 会话",
      "configuration": {
        "required": false,
        "adapter": "codex"
      },
      "accounts": [
        {
          "id": "chatgpt",
          "name": "ChatGPT 官方",
          "modelGroupIds": ["codex", "openai"],
          "status": {
            "argv": ["codex", "login", "status"],
            "loggedInPatterns": ["logged in"],
            "loggedOutPatterns": ["not logged in"],
            "timeoutMs": 15000
          },
          "login": {
            "argv": ["codex", "login"],
            "timeoutMs": 300000
          },
          "logout": {
            "argv": ["codex", "logout"],
            "timeoutMs": 30000
          }
        }
      ],
      "launch": {
        "mode": "managed",
        "providerId": "codex",
        "protocol": "codex-app-server",
        "transport": "stdio",
        "argv": ["kite-codex-app-server"],
        "title": "Codex"
      }
    }
  ],
  "actions": {
    "open": {
      "runtime": "kite_recipe",
      "recipe": {
        "base": {
          "id": "",
          "name": "Codex CLI",
          "description": "启动 Codex Agent 会话",
          "icon": {
            "type": "builtin",
            "name": "bot"
          }
        },
        "launch": {
          "openInstance": true
        },
        "recipe": [
          {
            "type": "agent",
            "agentId": "codex",
            "workdir": "/workspace"
          }
        ]
      }
    }
  },
  "homeCards": [
    {
      "label": "Codex CLI",
      "policy": "manual",
      "recipe": {
        "base": {
          "id": "",
          "name": "Codex CLI",
          "description": "启动 Codex Agent 会话",
          "icon": {
            "type": "builtin",
            "name": "bot"
          }
        },
        "launch": {
          "openInstance": true
        },
        "recipe": [
          {
            "type": "agent",
            "agentId": "codex",
            "workdir": "/workspace"
          }
        ]
      }
    }
  ]
}
