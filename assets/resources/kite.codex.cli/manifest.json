{
  "schemaVersion": 1,
  "id": "kite.codex.cli",
  "base": {
    "name": "Codex CLI",
    "description": "OpenAI 的终端编码助手",
    "version": "official",
    "icon": {
      "type": "asset",
      "value": "resources/kite.codex.cli/icon.png",
      "fallbackText": "Cx"
    }
  },
  "display": {
    "sections": [
      "featured"
    ],
    "category": "AI",
    "accent": "teal",
    "sizeLabel": "网络包",
    "longDescription": "Codex CLI 是 OpenAI 面向终端的编码助手。Kite 使用官方 standalone installer 获取命令入口，并把 codex 暴露到 /workspace/.kf/bin；登录、模型和项目权限仍由 Codex 自己在终端里引导，不写入资源卡 JSON。",
    "recommendations": [
      {
        "resourceId": "kite.curl",
        "label": "下载工具"
      },
      {
        "resourceId": "kite.claude.code",
        "label": "同类 Agent"
      },
      {
        "resourceId": "kite.opencode",
        "label": "同类 Agent"
      },
      {
        "resourceId": "kite.mimo.code",
        "label": "终端 Agent"
      }
    ],
    "tags": [
      "codex",
      "openai",
      "coding-agent",
      "terminal",
      "ai"
    ]
  },
  "relations": {
    "provides": [
      "cli.codex",
      "agent.openai.codex"
    ],
    "base": [
      "kite.git",
      "kite.curl"
    ],
    "defaults": [],
    "extensions": []
  },
  "source": {
    "type": "official_script",
    "url": "https://chatgpt.com/codex/install.sh",
    "repository": "https://github.com/openai/codex",
    "command": "curl -fsSL https://chatgpt.com/codex/install.sh | CODEX_NON_INTERACTIVE=1 sh"
  },
  "paths": {
    "cacheRoot": "/workspace/.kf/cache/resources/kite.codex.cli",
    "installRoot": "/workspace/.kf/software/kite.codex.cli",
    "binRoot": "/workspace/.kf/bin"
  },
  "actions": {
    "install": [
      {
        "type": "shell",
        "cmd": "curl -fsSL https://chatgpt.com/codex/install.sh | CODEX_NON_INTERACTIVE=1 sh",
        "managedCommands": [
          "codex"
        ],
        "cleanInstallRoot": true,
        "timeoutMs": 600000
      }
    ],
    "open": {
      "runtime": "kite_recipe",
      "recipe": {
        "base": {
          "id": "",
          "name": "Codex CLI",
          "description": "在终端里启动 OpenAI Codex",
          "icon": {
            "type": "builtin",
            "name": "bot"
          }
        },
        "launch": {
          "openInstance": true
        },
        "recipe": [
          {
            "type": "terminal",
            "text": "cd /workspace\necho \"Codex CLI 首次启动会要求登录 ChatGPT 或配置 API Key。\"\ncodex\n"
          }
        ]
      }
    },
    "uninstall": [
      {
        "type": "shell",
        "cmd": ":",
        "managedCommands": [
          "codex"
        ],
        "timeoutMs": 180000
      }
    ]
  },
  "homeCards": [
    {
      "label": "Codex CLI",
      "policy": "manual",
      "recipe": {
        "base": {
          "id": "",
          "name": "Codex CLI",
          "description": "在终端里启动 OpenAI Codex",
          "icon": {
            "type": "builtin",
            "name": "bot"
          }
        },
        "launch": {
          "openInstance": true
        },
        "recipe": [
          {
            "type": "terminal",
            "text": "cd /workspace\necho \"Codex CLI 首次启动会要求登录 ChatGPT 或配置 API Key。\"\ncodex\n"
          }
        ]
      }
    }
  ]
}
