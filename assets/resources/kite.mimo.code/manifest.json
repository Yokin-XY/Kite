{
  "schemaVersion": 1,
  "id": "kite.mimo.code",
  "base": {
    "name": "MiMo Code",
    "description": "小米 MiMo 终端 AI 编码助手",
    "version": "npm",
    "icon": {
      "type": "asset",
      "value": "resources/kite.mimo.code/icon.png",
      "fallbackText": "Mi",
      "fit": "fullBleed"
    }
  },
  "management": {
    "mode": "managed_extension",
    "managedCommands": ["mimo"]
  },
  "display": {
    "sections": [
      "ai-vendor"
    ],
    "tabs": ["angel-cli"],
    "order": 120,
    "category": "AI",
    "accent": "orange",
    "sizeLabel": "网络包",
    "longDescription": "MiMo Code 是小米 MiMo 团队的终端原生 AI 编码助手，可以读写代码、运行命令、管理 Git，并通过持久记忆理解项目。Kite 把它作为 Node.js 上层资源：获取阶段只安装 @mimo-ai/cli 并暴露 mimo 命令；打开后在终端表面完成首次配置或登录，不把 Provider、OAuth 或运行输出写进资源卡。",
    "recommendations": [
      {
        "resourceId": "kite.nodejs",
        "label": "运行时"
      },
      {
        "resourceId": "kite.git",
        "label": "源码工具"
      },
      {
        "resourceId": "kite.reasonix",
        "label": "同类 Agent"
      },
      {
        "resourceId": "kite.codex.cli",
        "label": "同类 Agent"
      }
    ],
    "tags": [
      "mimo",
      "mimocode",
      "coding-agent",
      "terminal",
      "ai",
      "mcp",
      "memory"
    ],
    "media": {
      "type": "image",
      "asset": "resources/kite.mimo.code/banner.png",
      "contentDescription": "MiMo Code 海报，点击查看资源详情"
    }
  },
  "relations": {
    "provides": [
      "cli.mimo",
      "agent.mimo.code"
    ],
    "base": [
      "kite.nodejs",
      "kite.git"
    ],
    "defaults": [],
    "extensions": []
  },
  "source": {
    "type": "npm",
    "package": "@mimo-ai/cli",
    "latestVersionWindow": [
      { "version": "0.1.13", "integrity": "sha512-tEChkbCPP6Cuk88yFEV5suQ/3U0864S2G+PKsVKfpGY1FJ2EsnOa/q1ie8J9XsTg7Z42JCCWRmN6apRujNgT2Q==" },
      { "version": "0.1.12", "integrity": "sha512-f1y5YsWXgDuKycTAMWI2RzgSwnipVawW8qxaVR3ksy0/3A5/rSDykrUF1zoIwnmZF481MqiJOFexV4ZasWGe9Q==" },
      { "version": "0.1.11", "integrity": "sha512-3Sw3oUTni26EQil2PPESgam2XMxlPaFhF4KaasKXKIPFe46IxjA+rfvyrwC963Lv5NXjSJKjacLQjjDFfcMgBQ==" }
    ],
    "repository": "https://github.com/XiaomiMiMo/MiMo-Code"
  },
  "paths": {
    "cacheRoot": "/workspace/.kf/cache/resources/kite.mimo.code",
    "installRoot": "/workspace/.kf/software/kite.mimo.code",
    "binRoot": "/workspace/.kf/bin"
  },
  "agents": [
    {
      "id": "mimo",
      "name": "MiMo Code",
      "description": "MiMo Code 原生 ACP 会话",
      "configuration": {
        "required": false,
        "adapter": "mimo-code"
      },
      "launch": {
        "mode": "managed",
        "providerId": "mimo",
        "protocol": "acp",
        "transport": "stdio",
        "argv": ["mimo", "acp"],
        "title": "MiMo Code"
      }
    }
  ],
  "actions": {
    "install": [
      {
        "type": "managed",
        "steps": [
          {
            "id": "install-mimo-package",
            "type": "npm",
            "packages": [
              "@mimo-ai/cli"
            ]
          }
        ],
        "managedCommands": [
          "mimo"
        ],
        "cleanInstallRoot": true,
        "verify": [
          {
            "id": "mimo-command",
            "cmd": "command -v mimo >/dev/null 2>&1"
          }
        ],
        "timeoutMs": 900000
      }
    ],
    "open": {
      "runtime": "kite_recipe",
      "recipe": {
        "base": {
          "id": "",
          "name": "MiMo Code",
          "description": "启动 MiMo Code Agent 会话",
          "icon": {
            "type": "builtin",
            "name": "bot"
          }
        },
        "launch": {
          "openInstance": true
        },
        "recipe": [
          {
            "type": "agent",
            "agentId": "mimo",
            "workdir": "/workspace"
          }
        ]
      }
    },
    "uninstall": [
      {
        "type": "shell",
        "cmd": ":",
        "managedCommands": [
          "mimo"
        ],
        "npmUninstallPackage": "@mimo-ai/cli",
        "timeoutMs": 180000
      }
    ]
  },
  "homeCards": [
    {
      "label": "MiMo Code",
      "policy": "manual",
      "recipe": {
        "base": {
          "id": "",
          "name": "MiMo Code",
          "description": "启动 MiMo Code Agent 会话",
          "icon": {
            "type": "builtin",
            "name": "bot"
          }
        },
        "launch": {
          "openInstance": true
        },
        "recipe": [
          {
            "type": "agent",
            "agentId": "mimo",
            "workdir": "/workspace"
          }
        ]
      }
    }
  ]
}
