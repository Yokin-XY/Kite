{
  "schemaVersion": 1,
  "id": "kite.mimo.code",
  "base": {
    "name": "MiMo Code",
    "description": "小米 MiMo 终端 AI 编码助手",
    "version": "npm",
    "icon": {
      "type": "asset",
      "value": "resources/kite.mimo.code/icon.png",
      "fallbackText": "Mi",
      "fit": "fullBleed"
    }
  },
  "display": {
    "sections": [
      "featured"
    ],
    "category": "AI",
    "accent": "orange",
    "sizeLabel": "网络包",
    "longDescription": "MiMo Code 是小米 MiMo 团队的终端原生 AI 编码助手，可以读写代码、运行命令、管理 Git，并通过持久记忆理解项目。Kite 把它作为 Node.js 上层资源：获取阶段只安装 @mimo-ai/cli 并暴露 mimo 命令；打开后在终端表面完成首次配置或登录，不把 Provider、OAuth 或运行输出写进资源卡。",
    "recommendations": [
      {
        "resourceId": "kite.nodejs",
        "label": "运行时"
      },
      {
        "resourceId": "kite.git",
        "label": "源码工具"
      },
      {
        "resourceId": "kite.reasonix",
        "label": "同类 Agent"
      },
      {
        "resourceId": "kite.codex.cli",
        "label": "同类 Agent"
      }
    ],
    "tags": [
      "mimo",
      "mimocode",
      "coding-agent",
      "terminal",
      "ai",
      "mcp",
      "memory"
    ],
    "media": {
      "type": "image",
      "asset": "resources/kite.mimo.code/banner.png",
      "contentDescription": "MiMo Code 海报，点击查看资源详情"
    }
  },
  "relations": {
    "provides": [
      "cli.mimo",
      "agent.mimo.code"
    ],
    "base": [
      "kite.nodejs",
      "kite.git"
    ],
    "defaults": [],
    "extensions": []
  },
  "source": {
    "type": "npm",
    "package": "@mimo-ai/cli",
    "repository": "https://github.com/XiaomiMiMo/MiMo-Code"
  },
  "paths": {
    "cacheRoot": "/workspace/.kf/cache/resources/kite.mimo.code",
    "installRoot": "/workspace/.kf/software/kite.mimo.code",
    "binRoot": "/workspace/.kf/bin"
  },
  "actions": {
    "install": [
      {
        "type": "managed",
        "steps": [
          {
            "id": "install-mimo-package",
            "type": "npm",
            "packages": [
              "@mimo-ai/cli"
            ]
          }
        ],
        "managedCommands": [
          "mimo"
        ],
        "cleanInstallRoot": true,
        "verify": [
          {
            "id": "mimo-command",
            "cmd": "command -v mimo >/dev/null 2>&1"
          }
        ],
        "timeoutMs": 600000
      }
    ],
    "open": {
      "runtime": "kite_recipe",
      "recipe": {
        "base": {
          "id": "",
          "name": "MiMo Code",
          "description": "在终端里启动 MiMo Code 编码助手",
          "icon": {
            "type": "builtin",
            "name": "bot"
          }
        },
        "launch": {
          "openInstance": true
        },
        "recipe": [
          {
            "type": "terminal",
            "text": "cd /workspace\necho \"MiMo Code 首次启动会引导配置：MiMo Auto、小米平台 OAuth、Claude Code 导入或自定义 OpenAI-compatible Provider。\"\nmimo\n"
          }
        ]
      }
    },
    "uninstall": [
      {
        "type": "shell",
        "cmd": ":",
        "managedCommands": [
          "mimo"
        ],
        "npmUninstallPackage": "@mimo-ai/cli",
        "timeoutMs": 180000
      }
    ]
  },
  "homeCards": [
    {
      "label": "MiMo Code",
      "policy": "manual",
      "recipe": {
        "base": {
          "id": "",
          "name": "MiMo Code",
          "description": "在终端里启动 MiMo Code 编码助手",
          "icon": {
            "type": "builtin",
            "name": "bot"
          }
        },
        "launch": {
          "openInstance": true
        },
        "recipe": [
          {
            "type": "terminal",
            "text": "cd /workspace\necho \"MiMo Code 首次启动会引导配置：MiMo Auto、小米平台 OAuth、Claude Code 导入或自定义 OpenAI-compatible Provider。\"\nmimo\n"
          }
        ]
      }
    }
  ]
}
