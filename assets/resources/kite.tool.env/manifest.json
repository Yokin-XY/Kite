{
  "schemaVersion": 1,
  "id": "kite.tool.env",
  "base": {
    "name": "工具环境合集",
    "description": "pnpm、uv、adb 与常用命令合集",
    "version": "v14",
    "icon": {
      "type": "text",
      "value": ">_"
    }
  },
  "display": {
    "sections": [],
    "category": "系统工具",
    "accent": "teal",
    "sizeLabel": "内置包",
    "longDescription": "工具环境合集是隐藏的底层资源包，提供 pnpm、uv、adb 与常用命令合集。它不直接进入资源首页，只作为能力提供者被上层资源复用。",
    "recommendations": [],
    "tags": [
      "tool",
      "node",
      "pnpm",
      "uv",
      "adb"
    ]
  },
  "relations": {
    "provides": [
      "runtime.node>=24",
      "tool.npm",
      "tool.npx",
      "tool.pnpm",
      "tool.uv",
      "tool.uvx",
      "tool.adb",
      "tool.fastboot",
      "tool.ripgrep",
      "tool.jq"
    ],
    "base": [],
    "defaults": [],
    "extensions": []
  },
  "source": {
    "type": "bundled",
    "asset": "toolchain/ai-dev-pack"
  },
  "paths": {
    "cacheRoot": "/workspace/.kf/cache/resources/kite.tool.env",
    "installRoot": "/workspace/.kf/software/kite.tool.env",
    "binRoot": "/workspace/.kf/bin"
  },
  "actions": {
    "install": [
      {
        "type": "shell",
        "cmd": "install.sh --install"
      }
    ],
    "open": {
      "runtime": "kite_recipe",
      "recipe": {
        "base": {
          "id": "",
          "name": "工具环境合集",
          "description": "检查常用开发工具命令",
          "icon": {
            "type": "builtin",
            "name": "tools"
          }
        },
        "launch": {
          "openInstance": true
        },
        "recipe": [
          {
            "type": "shell",
            "cmd": "node --version && npm --version && uv --version && rg --version | head -1 || true",
            "surfaceMode": "panel"
          }
        ]
      }
    },
    "uninstall": [
      {
        "type": "shell",
        "cmd": "remove software root and tool wrappers"
      }
    ]
  },
  "homeCards": []
}
