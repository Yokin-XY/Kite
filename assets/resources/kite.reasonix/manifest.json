{
  "schemaVersion": 1,
  "id": "kite.reasonix",
  "base": {
    "name": "Reasonix",
    "description": "DeepSeek 原生终端编码助手",
    "version": "npm",
    "icon": {
      "type": "asset",
      "value": "resources/kite.reasonix/icon.png",
      "fallbackText": "Rx",
      "fit": "fullBleed"
    }
  },
  "management": {
    "mode": "managed_extension",
    "managedCommands": ["reasonix"],
    "versionProbe": {
      "command": "reasonix version",
      "pattern": "([0-9]+(?:\\.[0-9]+)+)"
    }
  },
  "display": {
    "sections": [
      "ai-community"
    ],
    "tabs": ["angel-cli"],
    "order": 30,
    "category": "AI",
    "accent": "teal",
    "sizeLabel": "网络包",
    "longDescription": "Reasonix 是围绕 DeepSeek prefix-cache 稳定性设计的终端编码 Agent。Kite 把它作为 Node.js 上层资源：安装阶段只通过 npm 装 CLI 并暴露 reasonix 命令；创建首页卡片后，用户从终端表面启动交互式 Reasonix，不把 API Key 或运行输出写回资源卡。",
    "recommendations": [
      {
        "resourceId": "kite.nodejs",
        "label": "运行时"
      },
      {
        "resourceId": "kite.git",
        "label": "源码工具"
      },
      {
        "resourceId": "kite.mimo.code",
        "label": "同类 Agent"
      },
      {
        "resourceId": "kite.claude.code",
        "label": "同类 Agent"
      }
    ],
    "tags": [
      "reasonix",
      "deepseek",
      "coding-agent",
      "terminal",
      "ai"
    ]
  },
  "relations": {
    "provides": [
      "cli.reasonix",
      "agent.deepseek.reasonix"
    ],
    "base": [
      "kite.nodejs",
      "kite.git"
    ],
    "defaults": [],
    "extensions": []
  },
  "source": {
    "type": "npm",
    "package": "reasonix",
    "repository": "https://github.com/esengine/deepseek-reasonix"
  },
  "paths": {
    "cacheRoot": "/workspace/.kf/cache/resources/kite.reasonix",
    "installRoot": "/workspace/.kf/software/kite.reasonix",
    "binRoot": "/workspace/.kf/bin"
  },
  "agents": [
    {
      "id": "reasonix",
      "name": "Reasonix",
      "description": "Reasonix 原生 ACP 会话",
      "configuration": {
        "required": false,
        "adapter": "reasonix"
      },
      "launch": {
        "mode": "managed",
        "providerId": "reasonix",
        "protocol": "acp",
        "transport": "stdio",
        "argv": ["reasonix", "acp"],
        "title": "Reasonix"
      }
    }
  ],
  "actions": {
    "open": {
      "runtime": "kite_recipe",
      "recipe": {
        "base": {
          "id": "",
          "name": "Reasonix",
          "description": "启动 Reasonix Agent 会话",
          "icon": {
            "type": "builtin",
            "name": "bot"
          }
        },
        "launch": {
          "openInstance": true
        },
        "recipe": [
          {
            "type": "agent",
            "agentId": "reasonix",
            "workdir": "/workspace"
          }
        ]
      }
    }
  },
  "homeCards": [
    {
      "label": "Reasonix",
      "policy": "manual",
      "recipe": {
        "base": {
          "id": "",
          "name": "Reasonix",
          "description": "启动 Reasonix Agent 会话",
          "icon": {
            "type": "builtin",
            "name": "bot"
          }
        },
        "launch": {
          "openInstance": true
        },
        "recipe": [
          {
            "type": "agent",
            "agentId": "reasonix",
            "workdir": "/workspace"
          }
        ]
      }
    }
  ]
}
