{
  "schemaVersion": 1,
  "id": "kite.curl",
  "base": {
    "name": "curl",
    "description": "网络下载命令",
    "version": "rootfs",
    "icon": {
      "type": "asset",
      "value": "resources/kite.curl/icon.png",
      "fallbackText": "curl",
      "fit": "fullBleed"
    }
  },
  "display": {
    "sections": [
      "more"
    ],
    "category": "系统工具",
    "accent": "orange",
    "sizeLabel": "内置底座",
    "longDescription": "curl 是网络型资源下载安装脚本的基础层工具。首次启动和资源获取都会从内置工具包缓存把 rootfs 内置 curl 接入 /workspace/.kf/software/kite.curl 与 /workspace/.kf/bin。",
    "recommendations": [
      {
        "resourceId": "kite.git",
        "label": "同级工具"
      },
      {
        "resourceId": "kite.hermes.core",
        "label": "被依赖"
      }
    ],
    "tags": [
      "curl",
      "download",
      "dependency",
      "hermes"
    ]
  },
  "relations": {
    "provides": [
      "tool.curl"
    ],
    "base": [],
    "defaults": [],
    "extensions": [
      "kite.hermes.core"
    ]
  },
  "source": {
    "type": "bundled",
    "asset": "toolchain/ai-dev-pack"
  },
  "paths": {
    "cacheRoot": "/workspace/.kf/cache/resources/kite.curl",
    "installRoot": "/workspace/.kf/software/kite.curl",
    "binRoot": "/workspace/.kf/bin"
  },
  "actions": {
    "install": [
      {
        "type": "shell",
        "cmd": "install.sh --install-curl"
      }
    ],
    "open": {
      "runtime": "kite_recipe",
      "recipe": {
        "base": {
          "id": "",
          "name": "curl",
          "description": "检查 curl 版本",
          "icon": {
            "type": "builtin",
            "name": "code"
          }
        },
        "launch": {
          "openInstance": true
        },
        "recipe": [
          {
            "type": "shell",
            "cmd": "curl --version | head -1",
            "surfaceMode": "panel"
          }
        ]
      }
    },
    "uninstall": [
      {
        "type": "shell",
        "cmd": "rm -rf /workspace/.kf/software/kite.curl /workspace/.kf/cache/resources/kite.curl; rm -f /workspace/.kf/bin/curl"
      }
    ]
  },
  "homeCards": []
}
