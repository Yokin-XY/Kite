{
  "schemaVersion": 1,
  "id": "kite.git",
  "base": {
    "name": "Git",
    "description": "源码下载与版本管理工具",
    "version": "rootfs",
    "icon": {
      "type": "asset",
      "value": "resources/kite.git/icon.png",
      "fallbackText": "Git"
    }
  },
  "display": {
    "sections": [
      "more"
    ],
    "category": "系统工具",
    "accent": "orange",
    "sizeLabel": "内置底座",
    "longDescription": "Git 是 Hermes 本体和后续源码型资源的底层工具卡。首次启动和资源获取都会从内置工具包缓存把 rootfs 内置 Git 接入 /workspace/.kf/software/kite.git 与 /workspace/.kf/bin。",
    "recommendations": [
      {
        "resourceId": "kite.curl",
        "label": "同级工具"
      },
      {
        "resourceId": "kite.hermes.core",
        "label": "被依赖"
      }
    ],
    "tags": [
      "git",
      "source",
      "dependency",
      "hermes"
    ]
  },
  "relations": {
    "provides": [
      "tool.git"
    ],
    "base": [],
    "defaults": [],
    "extensions": [
      "kite.hermes.core"
    ]
  },
  "source": {
    "type": "bundled",
    "asset": "toolchain/ai-dev-pack"
  },
  "paths": {
    "cacheRoot": "/workspace/.kf/cache/resources/kite.git",
    "installRoot": "/workspace/.kf/software/kite.git",
    "binRoot": "/workspace/.kf/bin"
  },
  "actions": {
    "install": [
      {
        "type": "managed",
        "steps": [
          {
            "id": "install-bundled-git",
            "type": "bundled",
            "cmd": "install.sh --install-git"
          }
        ],
        "managedCommands": [
          "git"
        ],
        "cleanInstallRoot": true,
        "verify": [
          {
            "id": "git-runtime",
            "cmd": "git --version"
          }
        ]
      }
    ],
    "open": {
      "runtime": "kite_recipe",
      "recipe": {
        "base": {
          "id": "",
          "name": "Git",
          "description": "查看 Git 版本与常用命令帮助",
          "icon": {
            "type": "builtin",
            "name": "code"
          }
        },
        "launch": {
          "openInstance": true
        },
        "recipe": [
          {
            "type": "shell",
            "cmd": "git --version && git --help | head -40",
            "surfaceMode": "panel"
          }
        ]
      }
    },
    "uninstall": [
      {
        "type": "shell",
        "cmd": "rm -rf /workspace/.kf/software/kite.git /workspace/.kf/cache/resources/kite.git; rm -f /workspace/.kf/bin/git"
      }
    ]
  },
  "homeCards": []
}
