{
  "schemaVersion": 1,
  "id": "kite.hermes.core",
  "base": {
    "name": "Hermes",
    "description": "Hermes Agent 本体与 CLI",
    "version": "main",
    "icon": {
      "type": "asset",
      "value": "resources/kite.hermes.core/icon.png",
      "fallbackText": "H"
    }
  },
  "display": {
    "sections": [
      "featured"
    ],
    "category": "AI",
    "accent": "teal",
    "sizeLabel": "网络包",
    "longDescription": "Hermes 是 Hermes Agent 的本体组件。Kite 调用官方 install.sh，但用 --dir 和 --hermes-home 把代码、venv、数据目录固定到这张资源自己的软件区，并暴露 /workspace/.kf/bin/hermes。它只负责本体安装和卸载；面向普通人的配置网页、WebUI 和首页启动卡会作为上层方案或配套卡组织。",
    "recommendations": [
      {
        "resourceId": "kite.python",
        "label": "运行时"
      },
      {
        "resourceId": "kite.uv",
        "label": "依赖管理"
      },
      {
        "resourceId": "kite.git",
        "label": "源码工具"
      },
      {
        "resourceId": "kite.curl",
        "label": "下载工具"
      }
    ],
    "tags": [
      "hermes",
      "agent",
      "ai",
      "core"
    ]
  },
  "relations": {
    "provides": [
      "cli.hermes",
      "service.hermes",
      "config.hermes"
    ],
    "base": [
      "kite.git",
      "kite.curl",
      "kite.python",
      "kite.nodejs",
      "kite.uv"
    ],
    "defaults": [],
    "extensions": [
      "kite.hermes.webui"
    ]
  },
  "source": {
    "type": "official_script",
    "url": "https://hermes-agent.nousresearch.com/install.sh",
    "upstream": "https://github.com/NousResearch/hermes-agent",
    "args": [
      "--skip-setup",
      "--skip-browser",
      "--non-interactive"
    ]
  },
  "paths": {
    "cacheRoot": "/workspace/.kf/cache/resources/kite.hermes.core",
    "installRoot": "/workspace/.kf/software/kite.hermes.core",
    "binRoot": "/workspace/.kf/bin",
    "configRoot": "/workspace/.kf/software/kite.hermes.core/home"
  },
  "actions": {
    "install": [
      {
        "type": "shell",
        "cmd": "curl -fsSL https://hermes-agent.nousresearch.com/install.sh -o install.sh && bash install.sh --dir /workspace/.kf/software/kite.hermes.core/hermes-agent --hermes-home /workspace/.kf/software/kite.hermes.core/home --skip-setup --skip-browser --non-interactive"
      }
    ],
    "open": {
      "runtime": "kite_recipe",
      "recipe": {
        "base": {
          "id": "",
          "name": "Hermes",
          "description": "在终端启动 Hermes",
          "icon": {
            "type": "builtin",
            "name": "bot"
          }
        },
        "launch": {
          "openInstance": true
        },
        "recipe": [
          {
            "type": "terminal",
            "cmd": "hermes"
          }
        ]
      }
    },
    "uninstall": [
      {
        "type": "shell",
        "cmd": "remove /workspace/.kf/software/kite.hermes.core and /workspace/.kf/bin/hermes"
      }
    ]
  },
  "homeCards": [
    {
      "label": "Hermes",
      "policy": "manual",
      "recipe": {
        "base": {
          "id": "",
          "name": "Hermes",
          "description": "在终端启动 Hermes",
          "icon": {
            "type": "builtin",
            "name": "bot"
          }
        },
        "launch": {
          "openInstance": true
        },
        "recipe": [
          {
            "type": "terminal",
            "cmd": "hermes"
          }
        ]
      }
    }
  ]
}
