{
  "schemaVersion": 1,
  "id": "kite.openclaw",
  "base": {
    "name": "OpenClaw",
    "description": "多通道 AI Agent 网关",
    "version": "npm",
    "icon": {
      "type": "asset",
      "value": "resources/kite.openclaw/icon.png",
      "fallbackText": "Cl"
    }
  },
  "display": {
    "sections": [
      "featured"
    ],
    "category": "AI",
    "accent": "mint",
    "sizeLabel": "网络包",
    "longDescription": "OpenClaw 是偏网关和多通道协作的 AI Agent 工具。Kite 把它先作为 Node.js 上层资源接入：获取阶段安装 openclaw npm 包并暴露 openclaw 命令，首次配置由终端里的 onboard 流程完成。",
    "recommendations": [
      {
        "resourceId": "kite.nodejs",
        "label": "运行时"
      },
      {
        "resourceId": "kite.opencode",
        "label": "同类 Agent"
      },
      {
        "resourceId": "kite.codex.cli",
        "label": "终端 Agent"
      },
      {
        "resourceId": "kite.hermes.webui",
        "label": "同类 Agent"
      }
    ],
    "tags": [
      "openclaw",
      "agent",
      "gateway",
      "terminal",
      "ai"
    ]
  },
  "relations": {
    "provides": [
      "cli.openclaw",
      "agent.openclaw"
    ],
    "base": [
      "kite.nodejs",
      "kite.git"
    ],
    "defaults": [],
    "extensions": []
  },
  "source": {
    "type": "npm",
    "package": "openclaw",
    "repository": "https://github.com/openclaw/openclaw"
  },
  "paths": {
    "cacheRoot": "/workspace/.kf/cache/resources/kite.openclaw",
    "installRoot": "/workspace/.kf/software/kite.openclaw",
    "binRoot": "/workspace/.kf/bin"
  },
  "actions": {
    "install": [
      {
        "type": "managed",
        "steps": [
          {
            "id": "install-openclaw-package",
            "type": "npm",
            "packages": [
              "openclaw@latest"
            ]
          }
        ],
        "managedCommands": [
          "openclaw"
        ],
        "cleanInstallRoot": true,
        "verify": [
          {
            "id": "openclaw-command",
            "cmd": "command -v openclaw >/dev/null 2>&1"
          }
        ],
        "timeoutMs": 600000
      }
    ],
    "open": {
      "runtime": "kite_recipe",
      "recipe": {
        "base": {
          "id": "",
          "name": "OpenClaw",
          "description": "在终端里启动 OpenClaw onboard",
          "icon": {
            "type": "builtin",
            "name": "bot"
          }
        },
        "launch": {
          "openInstance": true
        },
        "recipe": [
          {
            "type": "terminal",
            "text": "cd /workspace\necho \"OpenClaw 首次启动建议完成 onboard。\"\nopenclaw onboard --install-daemon\n"
          }
        ]
      }
    },
    "uninstall": [
      {
        "type": "shell",
        "cmd": ":",
        "managedCommands": [
          "openclaw"
        ],
        "npmUninstallPackage": "openclaw",
        "timeoutMs": 180000
      }
    ]
  },
  "homeCards": [
    {
      "label": "OpenClaw",
      "policy": "manual",
      "recipe": {
        "base": {
          "id": "",
          "name": "OpenClaw",
          "description": "在终端里启动 OpenClaw onboard",
          "icon": {
            "type": "builtin",
            "name": "bot"
          }
        },
        "launch": {
          "openInstance": true
        },
        "recipe": [
          {
            "type": "terminal",
            "text": "cd /workspace\necho \"OpenClaw 首次启动建议完成 onboard。\"\nopenclaw onboard --install-daemon\n"
          }
        ]
      }
    }
  ]
}
