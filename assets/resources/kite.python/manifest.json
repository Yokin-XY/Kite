{
  "schemaVersion": 1,
  "id": "kite.python",
  "base": {
    "name": "Python",
    "description": "Hermes 本体需要的 Python 运行时",
    "version": ">=3.11,<3.14",
    "icon": {
      "type": "asset",
      "value": "resources/kite.python/icon.png",
      "fallbackText": "Py"
    }
  },
  "display": {
    "sections": [
      "more"
    ],
    "category": "Python",
    "accent": "blue",
    "sizeLabel": "网络包",
    "longDescription": "Python 是 Hermes 的基础层资源。Hermes 当前声明 Python >=3.11,<3.14；这张卡负责补齐 python3、venv、pip 和证书能力，并把可用状态登记到 Kite。卸载时不移除系统 Python，只清除 Kite 的资源登记。",
    "recommendations": [
      {
        "resourceId": "kite.uv",
        "label": "包管理"
      },
      {
        "resourceId": "kite.hermes.core",
        "label": "上层应用"
      }
    ],
    "tags": [
      "python",
      "venv",
      "pip",
      "dependency",
      "hermes"
    ]
  },
  "relations": {
    "provides": [
      "runtime.python>=3.11<3.14",
      "tool.pip",
      "tool.venv"
    ],
    "base": [],
    "defaults": [],
    "extensions": [
      "kite.hermes.core"
    ]
  },
  "source": {
    "type": "apt",
    "packages": [
      "python3",
      "python3-venv",
      "python3-pip",
      "ca-certificates"
    ]
  },
  "paths": {
    "cacheRoot": "/workspace/.kf/cache/resources/kite.python",
    "installRoot": "/workspace/.kf/software/kite.python",
    "binRoot": "/workspace/.kf/bin"
  },
  "actions": {
    "install": [
      {
        "type": "shell",
        "cmd": "apt-get install -y python3 python3-venv python3-pip ca-certificates"
      }
    ],
    "open": {
      "runtime": "kite_recipe",
      "recipe": {
        "base": {
          "id": "",
          "name": "Python",
          "description": "检查 Python 与 pip 运行环境",
          "icon": {
            "type": "builtin",
            "name": "code"
          }
        },
        "launch": {
          "openInstance": true
        },
        "recipe": [
          {
            "type": "shell",
            "cmd": "python3 --version && python3 -m venv --help >/dev/null && python3 -m pip --version",
            "surfaceMode": "panel"
          }
        ]
      }
    },
    "uninstall": [
      {
        "type": "shell",
        "cmd": "clear Kite resource record only; do not remove system Python"
      }
    ]
  },
  "homeCards": []
}
