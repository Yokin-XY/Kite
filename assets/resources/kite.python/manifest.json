{
  "schemaVersion": 1,
  "id": "kite.python",
  "base": {
    "name": "Python",
    "description": "Hermes 本体需要的 Python 运行时",
    "version": "3.14.6",
    "icon": {
      "type": "asset",
      "value": "resources/kite.python/icon.png",
      "fallbackText": "Py"
    }
  },
  "display": {
    "sections": [
      "more"
    ],
    "category": "Python",
    "accent": "blue",
    "sizeLabel": "内置底座",
    "longDescription": "Python 是 Kite 离线基础层资源。首次启动和资源获取都会从内置工具包缓存安装 Python 3.14 到 /workspace/.kf/software/kite.python，并通过 /workspace/.kf/bin 暴露命令。",
    "recommendations": [
      {
        "resourceId": "kite.uv",
        "label": "包管理"
      },
      {
        "resourceId": "kite.hermes.core",
        "label": "上层应用"
      }
    ],
    "tags": [
      "python",
      "venv",
      "pip",
      "dependency",
      "hermes"
    ]
  },
  "relations": {
    "provides": [
      "runtime.python>=3.14<3.15",
      "tool.pip",
      "tool.venv"
    ],
    "base": [],
    "defaults": [],
    "extensions": [
      "kite.hermes.core"
    ]
  },
  "source": {
    "type": "bundled",
    "asset": "toolchain/ai-dev-pack"
  },
  "paths": {
    "cacheRoot": "/workspace/.kf/cache/resources/kite.python",
    "installRoot": "/workspace/.kf/software/kite.python",
    "binRoot": "/workspace/.kf/bin"
  },
  "actions": {
    "install": [
      {
        "type": "managed",
        "steps": [
          {
            "id": "install-bundled-python",
            "type": "bundled",
            "cmd": "install.sh --install-python"
          }
        ],
        "managedCommands": [
          "python",
          "python3",
          "pip",
          "pip3"
        ],
        "cleanInstallRoot": true,
        "verify": [
          {
            "id": "python-runtime",
            "cmd": "python3 --version && python3 -m venv --help >/dev/null && python3 -m pip --version"
          }
        ]
      }
    ],
    "open": {
      "runtime": "kite_recipe",
      "recipe": {
        "base": {
          "id": "",
          "name": "Python",
          "description": "检查 Python 与 pip 运行环境",
          "icon": {
            "type": "builtin",
            "name": "code"
          }
        },
        "launch": {
          "openInstance": true
        },
        "recipe": [
          {
            "type": "shell",
            "cmd": "python3 --version && python3 -m venv --help >/dev/null && python3 -m pip --version",
            "surfaceMode": "panel"
          }
        ]
      }
    },
    "uninstall": [
      {
        "type": "shell",
        "cmd": "rm -rf /workspace/.kf/software/kite.python /workspace/.kf/cache/resources/kite.python; rm -f /workspace/.kf/bin/python /workspace/.kf/bin/python3 /workspace/.kf/bin/python3.14 /workspace/.kf/bin/pip /workspace/.kf/bin/pip3"
      }
    ]
  },
  "homeCards": []
}
