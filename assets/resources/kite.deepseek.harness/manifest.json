{
  "schemaVersion": 1,
  "id": "kite.deepseek.harness",
  "base": {
    "name": "DeepSeek Harness",
    "description": "DeepSeek 官方开源 Agent Harness",
    "version": "0.1.1-rc.2",
    "icon": {
      "type": "asset",
      "value": "resources/kite.deepseek.harness/icon.png",
      "fallbackText": "DS",
      "fit": "fullBleed"
    }
  },
  "management": {
    "mode": "managed_extension",
    "managedCommands": [
      "dsh",
      "dsh-acp",
      "kite-dsh-acp"
    ],
    "versionProbe": {
      "command": "dsh --version",
      "pattern": "([0-9]+(?:\\.[0-9]+)+(?:-rc\\.[0-9]+)?)"
    },
    "preservePaths": [
      "user-home"
    ]
  },
  "display": {
    "sections": [
      "ai-vendor"
    ],
    "tabs": [
      "angel-cli"
    ],
    "order": 115,
    "category": "AI",
    "accent": "blue",
    "sizeLabel": "网络包",
    "longDescription": "DeepSeek Harness 是 DeepSeek 官方开源的 Agent Harness。Kite 固定安装官方 Harness 0.1.1-rc.2，并通过独立维护的完整 ACP 桥接层提供会话创建、列表、恢复、历史加载、流式消息、工具审批、实时模型、推理强度和三种执行权限；MCP、Skill、模型供应商、登录凭据与会话日志仍由 Harness 自己管理。安装时会把 Harness 的会话首次发布从硬链接切换为原子重命名，避开 Android PRoot 的 link2symlink 语义冲突。官方当前提供的 ACP Demo 仅支持新会话，因此不作为 Kite 的运行入口。",
    "recommendations": [
      {
        "resourceId": "kite.nodejs",
        "label": "运行时"
      },
      {
        "resourceId": "kite.git",
        "label": "源码工具"
      },
      {
        "resourceId": "kite.hermes.core",
        "label": "同类 Agent"
      },
      {
        "resourceId": "kite.opencode",
        "label": "同类 Agent"
      }
    ],
    "tags": [
      "deepseek",
      "dsh",
      "harness",
      "coding-agent",
      "acp",
      "mcp",
      "skills"
    ]
  },
  "relations": {
    "provides": [
      "cli.deepseek.harness",
      "agent.deepseek.harness"
    ],
    "base": [
      "kite.nodejs",
      "kite.git"
    ],
    "defaults": [],
    "extensions": []
  },
  "source": {
    "type": "official_command",
    "package": "@deepseek-ai/dsh",
    "command": "npm install -g @deepseek-ai/dsh@latest && npm install -g @openma/deepseek-harness-acp@latest",
    "uninstallCommand": "npm uninstall -g @deepseek-ai/dsh && npm uninstall -g @openma/deepseek-harness-acp",
    "latestVersion": "0.1.5-rc.1"
  },
  "paths": {
    "cacheRoot": "/workspace/.kf/cache/resources/kite.deepseek.harness",
    "installRoot": "/workspace/.kf/software/kite.deepseek.harness",
    "binRoot": "/workspace/.kf/bin"
  },
  "agents": [
    {
      "id": "deepseek-harness",
      "name": "DeepSeek Harness",
      "description": "DeepSeek Harness 完整 ACP 会话",
      "configuration": {
        "adapter": "deepseek-harness",
        "required": false
      },
      "accounts": [
        {
          "id": "deepseek",
          "name": "DeepSeek 官方 API",
          "modelGroupIds": [
            "deepseek"
          ],
          "login": {
            "argv": [
              "kite-dsh-acp",
              "login"
            ],
            "timeoutMs": 300000
          }
        }
      ],
      "launch": {
        "mode": "managed",
        "providerId": "deepseek-harness",
        "protocol": "acp",
        "transport": "stdio",
        "argv": [
          "kite-dsh-acp"
        ],
        "initializeTimeoutMs": 120000,
        "title": "DeepSeek Harness"
      }
    }
  ],
  "actions": {
    "open": {
      "runtime": "kite_recipe",
      "recipe": {
        "base": {
          "id": "",
          "name": "DeepSeek Harness",
          "description": "启动 DeepSeek Harness Agent 会话",
          "icon": {
            "type": "builtin",
            "name": "bot"
          }
        },
        "launch": {
          "openInstance": true
        },
        "recipe": [
          {
            "type": "agent",
            "agentId": "deepseek-harness",
            "workdir": "/workspace"
          }
        ]
      }
    },
    "uninstall": [
      {
        "type": "shell",
        "cmd": ":",
        "managedCommands": [
          "dsh",
          "dsh-acp",
          "kite-dsh-acp"
        ],
        "npmUninstallPackages": [
          "@deepseek-ai/dsh",
          "@openma/deepseek-harness-acp"
        ],
        "timeoutMs": 180000
      }
    ]
  },
  "homeCards": [
    {
      "label": "DeepSeek Harness",
      "policy": "manual",
      "recipe": {
        "base": {
          "id": "",
          "name": "DeepSeek Harness",
          "description": "启动 DeepSeek Harness Agent 会话",
          "icon": {
            "type": "builtin",
            "name": "bot"
          }
        },
        "launch": {
          "openInstance": true
        },
        "recipe": [
          {
            "type": "agent",
            "agentId": "deepseek-harness",
            "workdir": "/workspace"
          }
        ]
      }
    }
  ]
}
