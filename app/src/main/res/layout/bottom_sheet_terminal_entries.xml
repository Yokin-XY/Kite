<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/terminal_page_surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="26dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/terminal_entry_title"
            android:textColor="@color/terminal_page_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="2dp"
            android:text="@string/terminal_entry_note"
            android:textColor="@color/terminal_page_subtext"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEntryNewSession"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="18dp"
            android:text="@string/terminal_new_session"
            android:textAlignment="viewStart"
            android:textColor="@color/terminal_page_text"
            app:backgroundTint="@color/terminal_page_surface"
            app:cornerRadius="16dp"
            app:strokeColor="@color/terminal_page_line" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEntryClaude"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:text="@string/terminal_entry_claude"
            android:textAlignment="viewStart"
            android:textColor="@color/terminal_page_text"
            app:backgroundTint="@color/terminal_page_surface"
            app:cornerRadius="16dp"
            app:strokeColor="@color/terminal_page_line" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEntryCodex"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:text="@string/terminal_entry_codex"
            android:textAlignment="viewStart"
            android:textColor="@color/terminal_page_text"
            app:backgroundTint="@color/terminal_page_surface"
            app:cornerRadius="16dp"
            app:strokeColor="@color/terminal_page_line" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEntryOpenClaw"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:text="@string/terminal_entry_openclaw"
            android:textAlignment="viewStart"
            android:textColor="@color/terminal_page_text"
            app:backgroundTint="@color/terminal_page_surface"
            app:cornerRadius="16dp"
            app:strokeColor="@color/terminal_page_line" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEntrySendEnter"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:text="@string/terminal_enter"
            android:textAlignment="viewStart"
            android:textColor="@color/terminal_page_text"
            app:backgroundTint="@color/terminal_page_surface"
            app:cornerRadius="16dp"
            app:strokeColor="@color/terminal_page_line" />
    </LinearLayout>

</ScrollView>
