<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/terminal_page_surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="26dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/terminal_actions_title"
            android:textColor="@color/terminal_page_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="2dp"
            android:text="@string/terminal_actions_note"
            android:textColor="@color/terminal_page_subtext"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/terminal_actions_build"
            android:textColor="@color/terminal_page_subtext"
            android:textSize="12sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnActionBuildDoctor"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:text="@string/terminal_build_doctor"
            android:textAlignment="viewStart"
            android:textColor="@color/terminal_page_text"
            app:backgroundTint="@color/terminal_page_surface"
            app:cornerRadius="16dp"
            app:strokeColor="@color/terminal_page_line" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnActionBuildCompile"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:text="@string/terminal_build_compile"
            android:textAlignment="viewStart"
            android:textColor="@color/terminal_page_text"
            app:backgroundTint="@color/terminal_page_surface"
            app:cornerRadius="16dp"
            app:strokeColor="@color/terminal_page_line" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnActionBuildAssemble"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:text="@string/terminal_build_assemble"
            android:textAlignment="viewStart"
            android:textColor="@color/terminal_page_text"
            app:backgroundTint="@color/terminal_page_surface"
            app:cornerRadius="16dp"
            app:strokeColor="@color/terminal_page_line" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/terminal_actions_session"
            android:textColor="@color/terminal_page_subtext"
            android:textSize="12sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnActionCopyTranscript"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:text="@string/terminal_copy_transcript"
            android:textAlignment="viewStart"
            android:textColor="@color/terminal_page_text"
            app:backgroundTint="@color/terminal_page_surface"
            app:cornerRadius="16dp"
            app:strokeColor="@color/terminal_page_line" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnActionClearScreen"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:text="@string/terminal_clear"
            android:textAlignment="viewStart"
            android:textColor="@color/terminal_page_text"
            app:backgroundTint="@color/terminal_page_surface"
            app:cornerRadius="16dp"
            app:strokeColor="@color/terminal_page_line" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnActionKillSession"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:text="@string/terminal_kill_session"
            android:textAlignment="viewStart"
            android:textColor="@color/terminal_page_text"
            app:backgroundTint="@color/terminal_page_surface"
            app:cornerRadius="16dp"
            app:strokeColor="@color/terminal_page_line" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnActionCtrlC"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:text="@string/terminal_ctrl_c"
            android:textAlignment="viewStart"
            android:textColor="@color/terminal_page_text"
            app:backgroundTint="@color/terminal_page_surface"
            app:cornerRadius="16dp"
            app:strokeColor="@color/terminal_page_line" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnActionDeleteCurrentSession"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:text="@string/terminal_delete_session"
            android:textAlignment="viewStart"
            android:textColor="@color/terminal_page_text"
            app:backgroundTint="@color/terminal_page_surface"
            app:cornerRadius="16dp"
            app:strokeColor="@color/terminal_page_line" />
    </LinearLayout>

</ScrollView>
