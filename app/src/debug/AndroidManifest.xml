<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name="com.kite.app.foundation.runtime.WarmProotRunnerBenchmarkReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.kite.app.debug.WARM_PROOT_RUNNER_BENCHMARK" />
            </intent-filter>
        </receiver>
        <receiver
            android:name="com.kite.app.foundation.runtime.ProotAdmissionBenchmarkReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.kite.app.debug.PROOT_ADMISSION_BENCHMARK" />
            </intent-filter>
        </receiver>
        <service
            android:name="com.kite.app.foundation.runtime.ProotAdmissionBenchmarkService"
            android:exported="false" />
        <receiver
            android:name="com.kite.app.foundation.runtime.PythonRuntimeBenchmarkReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.kite.app.debug.PYTHON_RUNTIME_BENCHMARK" />
                <action android:name="com.kite.app.debug.PYTHON_RUNTIME_COMPATIBILITY" />
                <action android:name="com.kite.app.debug.PYTHON_RUNTIME_LAYERED" />
                <action android:name="com.kite.app.debug.PYTHON_RUNTIME_EXTENSION" />
            </intent-filter>
        </receiver>
        <service
            android:name="com.kite.app.foundation.runtime.PythonRuntimeBenchmarkService"
            android:exported="false" />
        <receiver
            android:name="com.kite.app.foundation.runtime.NativeDownloadCapabilityProbeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.kite.app.debug.NATIVE_DOWNLOAD_CAPABILITY_PROBE" />
                <action android:name="com.kite.app.debug.NATIVE_DOWNLOAD_CAPABILITY_BENCHMARK" />
                <action android:name="com.kite.app.debug.NATIVE_FILE_CAPABILITY_BENCHMARK" />
            </intent-filter>
        </receiver>
        <service
            android:name="com.kite.app.foundation.runtime.NativeDownloadCapabilityBenchmarkService"
            android:exported="false" />
        <service
            android:name="com.kite.app.foundation.runtime.NativeFileCapabilityBenchmarkService"
            android:exported="false" />
    </application>
</manifest>
